die() {
    echo >&2
    echo "ERROR: $*" >&2
    exit 1
}


pause() {
    echo
    read -r -p "Press Enter to continue..." _
}


cancelled() {
    echo "Cancelled. Nothing was changed."
    pause
}


log_event() {
    # Persistent trail in the journal: journalctl -t pve-config-restore
    # Logging never changes the outcome of a restore step.
    local priority="$1"

    shift
    if command -v logger >/dev/null 2>&1; then
        logger -t pve-config-restore -p "user.${priority}" -- "$*" >/dev/null 2>&1 || true
    fi
    return 0
}


on_unexpected_error() {
    local rc="$1"
    local line="$2"
    local command_text="$3"

    # Report only in the main shell. With set -E the trap also runs in
    # command substitutions, which would report the same failure twice.
    (( BASH_SUBSHELL == 0 )) || return 0

    echo "ERROR: Command failed with exit code ${rc} at line ${line}: ${command_text}" >&2 || true
    log_event err "command failed with exit code ${rc} at line ${line}: ${command_text}"
}


ensure_directory() {
    # A missing directory is created with mode 0755; with umask 077 of this
    # tool, mkdir would create it with 0700. An existing directory is left
    # unchanged (install -d would reset its mode).
    [[ -d "$1" ]] || install -d -m 0755 "$1"
}


sqlite_integrity_check() {
    # -batch -init /dev/null: never read ~/.sqliterc. Settings such as
    # ".headers on" or ".mode json" change the output, and "ok" would no
    # longer be recognised.
    sqlite3 -batch -init /dev/null "$1" 'PRAGMA integrity_check;'
}


unit_active_state() {
    local state=""

    state="$(systemctl show --property=ActiveState --value "$1" 2>/dev/null)" || state=""
    printf '%s\n' "${state:-unknown}"
}


unit_is_busy() {
    # `systemctl is-active` succeeds only for active, reloading and
    # refreshing. A Type=oneshot service is "activating" while it runs, so
    # is-active cannot detect a running backup. Unknown states count as busy.
    local state=""
    local sub=""

    state="$(unit_active_state "$1")"

    case "${state}" in
        inactive|failed)
            return 1
            ;;
        active)
            sub="$(systemctl show --property=SubState --value "$1" 2>/dev/null)" || sub=""
            # Type=oneshot with RemainAfterExit=yes: "active (exited)" is finished.
            [[ "${sub}" == "exited" ]] && return 1
            return 0
            ;;
        *)
            return 0
            ;;
    esac
}


pmxcfs_process_running() {
    local states=""

    # Zombie entries no longer hold files open and are ignored.
    states="$(ps -C pmxcfs -o stat= 2>/dev/null)" || true
    awk 'NF && $1 !~ /^Z/ { found = 1 } END { exit(found ? 0 : 1) }' <<< "${states}"
}


pve_cluster_fully_stopped() {
    local state=""

    state="$(unit_active_state pve-cluster)"
    [[ "${state}" == "inactive" || "${state}" == "failed" ]] || return 1
    ! mountpoint -q /etc/pve || return 1
    ! pmxcfs_process_running || return 1
    return 0
}


guest_config_lock() {
    # Reads a guest configuration on stdin and prints the value of a "lock:"
    # entry in its main section (before the first [snapshot] section). The
    # whole input is read, so a writer in a pipeline gets no SIGPIPE.
    awk '
        BEGIN { main = 1 }
        /^\[/ { main = 0 }
        main && !found && /^lock:/ {
            value = $0
            sub(/^lock:[[:space:]]*/, "", value)
            found = 1
        }
        END { if (found) print value }
    '
}


validation_output_accepted() {
    local label="$1"
    local messages_file="$2"
    local note="${3:-}"

    [[ -s "${messages_file}" ]] || return 0

    echo >&2
    echo "WARNING: ${label} printed the following messages:" >&2
    sed 's/^/  /' "${messages_file}" >&2
    echo "Proxmox parsers usually only warn about invalid lines, so these messages" >&2
    echo "can mean that part of the restored configuration is ignored." >&2
    if [[ -n "${note}" ]]; then
        echo "${note}" >&2
    fi

    confirm_word "Keep the restored configuration anyway? Otherwise it is rolled back." "KEEP"
}


network_ifquery_bridge_fd_zero_stanzas_safe() {
    # Inspect the complete parsed candidate model, not only `ifquery -a`.
    # bridge-stp defaults to off in ifupdown2. Therefore one bridge-fd 0 is
    # safe for the synthetic validation rewrite when STP is either omitted or
    # explicitly off/no. Duplicate, conflicting or unknown settings fail closed.
    local parsed_file="$1"

    awk '
        function reset_stanza() {
            fd_zero = 0
            fd_other = 0
            fd_count = 0
            stp_disabled = 0
            stp_enabled = 0
            stp_other = 0
            stp_count = 0
        }

        function commit_stanza() {
            if (!in_iface) {
                return
            }

            if (fd_zero) {
                has_fd_zero[ifname] = 1
                if (fd_other || fd_count != 1 || stp_count > 1 \
                    || (stp_count == 1 && (!stp_disabled || stp_enabled || stp_other))) {
                    bad = 1
                }
            }

            if (stp_enabled || stp_other) {
                has_stp_unsafe[ifname] = 1
            }
        }

        $1 == "iface" {
            commit_stanza()
            in_iface = 1
            ifname = $2
            reset_stanza()
            next
        }

        in_iface && ($1 == "bridge-fd" || $1 == "bridge_fd") {
            fd_count++
            if ($2 == "0") {
                fd_zero = 1
            } else {
                fd_other = 1
            }
            next
        }

        in_iface && ($1 == "bridge-stp" || $1 == "bridge_stp") {
            stp_count++
            if ($2 == "off" || $2 == "no") {
                stp_disabled = 1
            } else if ($2 == "on" || $2 == "yes") {
                stp_enabled = 1
            } else {
                stp_other = 1
            }
            next
        }

        END {
            commit_stanza()
            for (name in has_fd_zero) {
                if (has_stp_unsafe[name]) {
                    bad = 1
                }
            }
            exit(bad ? 1 : 0)
        }
    ' "${parsed_file}"
}


network_iface_expected_to_be_created() {
    # Accept an "interface not recognized" warning only for a candidate name
    # that ifupdown2 can create from configuration. Dotted names are implicit
    # VLANs; their physical/lower parent is checked separately by
    # network_required_links_present().
    local parsed_file="$1"
    local target="$2"

    if [[ "${target}" == *.* ]]; then
        return 0
    fi

    awk -v target="${target}" '
        function commit() {
            if (!active) {
                return
            }
            if (creator) {
                safe = 1
            }
        }

        $1 == "iface" {
            commit()
            active = ($2 == target)
            if (active) {
                found = 1
            }
            creator = 0
            next
        }

        active && ($1 == "bridge-ports" || $1 == "bridge_ports" \
            || $1 == "bond-slaves" || $1 == "bond_slaves" \
            || $1 == "vlan-raw-device" || $1 == "vlan_raw_device" \
            || $1 == "vlan-id" || $1 == "vlan_id" \
            || $1 == "vxlan-id" || $1 == "vxlan_id") {
            creator = 1
        }

        END {
            commit()
            exit(found && safe ? 0 : 1)
        }
    ' "${parsed_file}"
}


network_syntax_messages_safe() {
    # Network validation deliberately has no generic KEEP escape hatch. Errors,
    # tracebacks and unknown warnings fail closed. The only accepted rc=0
    # warning is the known ifupdown2 "interface not recognized" message for an
    # interface that has its own software-interface stanza.
    local messages_file="$1"
    local parsed_file="$2"
    local line=""
    local ifname=""

    [[ -s "${messages_file}" ]] || return 0

    while IFS= read -r line || [[ -n "${line}" ]]; do
        [[ -z "${line}" ]] && continue

        if [[ "${line}" =~ (^|[[:space:]])error: ]] \
            || [[ "${line}" == *"Traceback (most recent call last):"* ]]; then
            return 1
        fi

        if [[ "${line}" =~ ^[[:space:]]*warning:[[:space:]]+([^:[:space:]]+):[[:space:]]+interface[[:space:]]+not[[:space:]]+recognized[[:space:]]+-[[:space:]]+please[[:space:]]+check[[:space:]]+interface[[:space:]]+configuration[[:space:]]*$ ]]; then
            ifname="${BASH_REMATCH[1]}"
            network_iface_expected_to_be_created "${parsed_file}" "${ifname}" || return 1
            continue
        fi

        return 1
    done < "${messages_file}"

    return 0
}


network_tree_has_special_files() {
    local root="$1"
    local found=""

    [[ -d "${root}" && ! -L "${root}" ]] || return 0
    found="$(find "${root}" \( -type p -o -type b -o -type c -o -type s \) -print -quit 2>/dev/null || true)"
    [[ -n "${found}" ]]
}


network_preserve_concurrent_state() {
    # Preserve every live object that C-26 may overwrite before a conservative
    # rollback discards foreign changes. This is evidence only; never re-applied.
    local destination="${WORKDIR}/concurrent-live-state"

    rm -rf -- "${destination}" || return 1
    mkdir -p -- "${destination}/etc" "${destination}/usr/local/lib/systemd" || return 1

    if [[ -d /etc/network && ! -L /etc/network ]]; then
        cp -a -- /etc/network "${destination}/etc/network" || return 1
    elif [[ -e /etc/network || -L /etc/network ]]; then
        cp -a -- /etc/network "${destination}/etc/network" || return 1
    fi

    if [[ -e /usr/local/lib/systemd/network || -L /usr/local/lib/systemd/network ]]; then
        cp -a -- /usr/local/lib/systemd/network "${destination}/usr/local/lib/systemd/network" || return 1
    fi

    return 0
}


network_live_restore_objects_safe() {
    # Refuse live layouts that cannot be snapshotted/restored exactly by C-26.
    # /etc/network itself may be a mountpoint, but the objects we replace may not.
    local path=""
    local dir=""
    local bad=""
    local links=""

    for path in \
        /etc/network/interfaces \
        /etc/network/interfaces.new \
        /etc/network/interfaces.d \
        /usr/local/lib/systemd/network; do
        [[ -e "${path}" || -L "${path}" ]] || continue
        if mountpoint -q -- "${path}"; then
            echo "Network restore refuses a mountpoint at a replaced object: ${path}" >&2
            return 1
        fi
        if [[ ! -f "${path}" && ! -d "${path}" && ! -L "${path}" ]]; then
            echo "Network restore refuses a special top-level object: ${path}" >&2
            return 1
        fi
        if [[ -f "${path}" && ! -L "${path}" ]]; then
            links="$(stat -Lc '%h' -- "${path}")" || return 1
            if (( links > 1 )); then
                echo "Network restore refuses a hard-linked top-level file: ${path}" >&2
                return 1
            fi
        fi
    done

    if network_tree_has_special_files /etc/network; then
        bad="$(find /etc/network \( -type p -o -type b -o -type c -o -type s \) -print -quit 2>/dev/null || true)"
        echo "Network restore refuses special files below /etc/network: ${bad}" >&2
        return 1
    fi
    bad="$(find /etc/network -type f -links +1 -print -quit 2>/dev/null || true)"
    if [[ -n "${bad}" ]]; then
        echo "Network restore refuses hard-linked files below /etc/network: ${bad}" >&2
        return 1
    fi

    dir=/usr/local/lib/systemd/network
    if [[ -d "${dir}" && ! -L "${dir}" ]]; then
        bad="$(find "${dir}" \( -type p -o -type b -o -type c -o -type s \) -print -quit 2>/dev/null || true)"
        if [[ -n "${bad}" ]]; then
            echo "Network restore refuses special files below ${dir}: ${bad}" >&2
            return 1
        fi
        bad="$(find "${dir}" -type f -links +1 -print -quit 2>/dev/null || true)"
        if [[ -n "${bad}" ]]; then
            echo "Network restore refuses hard-linked files below ${dir}: ${bad}" >&2
            return 1
        fi
    fi

    return 0
}


network_validation_source_tree_safe() {
    # C-26 can snapshot only the parser inputs below /etc/network. Refuse
    # interfaces.d symlinks and source directives that escape that captured tree.
    local root="$1"
    local display_root="${2:-${root}}"
    local file=""
    local display_file=""
    local bad=0
    local special=""
    local hardlink=""

    if [[ ! -d "${root}" || -L "${root}" ]]; then
        echo "C-26 validation requires the network source root to be a real directory: ${display_root}" >&2
        return 1
    fi
    if [[ ! -f "${root}/interfaces" || -L "${root}/interfaces" ]]; then
        echo "C-26 validation requires a real interfaces file (not missing or symlinked): ${display_root}/interfaces" >&2
        return 1
    fi

    if [[ -e "${root}/interfaces.d" || -L "${root}/interfaces.d" ]]; then
        if [[ ! -d "${root}/interfaces.d" || -L "${root}/interfaces.d" ]]; then
            echo "C-26 validation requires interfaces.d to be a real directory when present: ${display_root}/interfaces.d" >&2
            return 1
        fi
        if [[ -n "$(find "${root}/interfaces.d" -type l -print -quit 2>/dev/null || true)" ]]; then
            echo "C-26 does not support symlinks inside interfaces.d in this release." >&2
            return 1
        fi
        special="$(find "${root}/interfaces.d" \( -type p -o -type b -o -type c -o -type s \) -print -quit 2>/dev/null || true)"
        [[ -z "${special}" ]] || {
            echo "C-26 refuses special files inside interfaces.d: ${display_root}/${special#${root}/}" >&2
            return 1
        }
        hardlink="$(find "${root}/interfaces.d" -type f -links +1 -print -quit 2>/dev/null || true)"
        [[ -z "${hardlink}" ]] || {
            echo "C-26 refuses hard-linked files inside interfaces.d: ${display_root}/${hardlink#${root}/}" >&2
            return 1
        }
    fi

    while IFS= read -r -d '' file; do
        if ! awk '
            ($1 == "source" || $1 == "source-directory") {
                for (i = 2; i <= NF; i++) {
                    p = $i
                    if (substr(p, 1, 1) == "#") break
                    if (p ~ /(^|\/)\.\.(\/|$)/) exit 1
                    if (p == "/etc/network/interfaces.d" || index(p, "/etc/network/interfaces.d/") == 1) continue
                    if (p == "interfaces.d" || index(p, "interfaces.d/") == 1) continue
                    exit 1
                }
            }
        ' "${file}"; then
            display_file="${display_root}/${file#${root}/}"
            echo "C-26 refuses source/source-directory directives outside /etc/network/interfaces.d: ${display_file}" >&2
            bad=1
            break
        fi
    done < <(
        printf '%s\0' "${root}/interfaces"
        if [[ -d "${root}/interfaces.d" && ! -L "${root}/interfaces.d" ]]; then
            find "${root}/interfaces.d" -type f -print0
        fi
    )

    (( bad == 0 ))
}


network_normalize_ether_mac() {
    local raw="${1,,}"
    local hex=""

    raw="${raw//-/}"
    raw="${raw//:/}"
    raw="${raw//./}"
    [[ "${raw}" =~ ^[0-9a-f]{12}$ ]] || return 1
    hex="${raw}"
    printf '%s:%s:%s:%s:%s:%s\n' \
        "${hex:0:2}" "${hex:2:2}" "${hex:4:2}" \
        "${hex:6:2}" "${hex:8:2}" "${hex:10:2}"
}


network_interface_is_physical() {
    local ifname="$1"
    [[ -e "/sys/class/net/${ifname}" && -e "/sys/class/net/${ifname}/device" ]]
}


network_interface_persistent_mac() {
    # For a real hardware-backed interface prefer iproute2's permaddr when the
    # current address differs from the permanent one. If no separate permaddr is
    # reported, use the current address as the persistent address candidate.
    # Software-only interfaces are never accepted as hardware evidence.
    local ifname="$1"
    local details=""
    local mac=""

    network_interface_is_physical "${ifname}" || return 1
    details="$(ip -d link show dev "${ifname}" 2>/dev/null)" || return 1
    if [[ "${details}" =~ (^|[[:space:]])permaddr[[:space:]]+([0-9A-Fa-f:.-]+) ]]; then
        mac="${BASH_REMATCH[2]}"
    else
        # Kernel sysfs documents addr_assign_type=0 as a permanent address.
        # If the current address is random/stolen/userspace-set and iproute2 did
        # not expose a separate permaddr, do not guess: fail closed.
        [[ -r "/sys/class/net/${ifname}/addr_assign_type" ]] || return 1
        [[ "$(cat "/sys/class/net/${ifname}/addr_assign_type" 2>/dev/null || true)" == "0" ]] || return 1
        [[ -r "/sys/class/net/${ifname}/address" ]] || return 1
        mac="$(cat "/sys/class/net/${ifname}/address" 2>/dev/null)" || return 1
    fi
    network_normalize_ether_mac "${mac}"
}


network_pinning_provides_name() {
    # A .link file does not create hardware. Accept it as future-name evidence
    # only when it names the target and one of its Match/MACAddress values
    # matches the persistent MAC of a currently detected hardware-backed NIC.
    # This deliberately does not attempt to emulate every systemd.link priority,
    # drop-in or Match= rule; unsupported/ambiguous cases fail closed.
    local pinning_root="$1"
    local target="$2"
    local file=""
    local props=""
    local name=""
    local macs=""
    local mac=""
    local normalized=""
    local ifpath=""
    local ifname=""
    local permanent=""
    local -a mac_list=()

    [[ -n "${pinning_root}" && -d "${pinning_root}" && ! -L "${pinning_root}" ]] || return 1

    while IFS= read -r -d '' file; do
        props="$(awk -F= '
            function trim(s) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", s); return s }
            /^[[:space:]]*\[/ {
                section=$0
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", section)
                next
            }
            section == "[Link]" && /^[[:space:]]*Name[[:space:]]*=/ {
                v=$0; sub(/^[^=]*=/, "", v); name=trim(v)
            }
            section == "[Match]" && /^[[:space:]]*MACAddress[[:space:]]*=/ {
                v=$0; sub(/^[^=]*=/, "", v); v=trim(v)
                if (v == "") macs=""
                else if (macs == "") macs=v
                else macs=macs " " v
            }
            END { print name "|" macs }
        ' "${file}" 2>/dev/null || true)"
        IFS='|' read -r name macs <<< "${props}"
        [[ "${name}" == "${target}" && -n "${macs}" ]] || continue

        read -r -a mac_list <<< "${macs}"
        for mac in "${mac_list[@]}"; do
            normalized="$(network_normalize_ether_mac "${mac}" 2>/dev/null || true)"
            [[ -n "${normalized}" ]] || continue
            for ifpath in /sys/class/net/*; do
                [[ -e "${ifpath}" ]] || continue
                ifname="${ifpath##*/}"
                permanent="$(network_interface_persistent_mac "${ifname}" 2>/dev/null || true)"
                [[ -n "${permanent}" ]] || continue
                if [[ "${permanent}" == "${normalized}" ]]; then
                    return 0
                fi
            done
        done
    done < <(find "${pinning_root}" -maxdepth 1 -type f -name '*.link' -print0 2>/dev/null)

    return 1
}


network_required_links_present() {
    # Enumerate lower links from the complete parsed candidate model. Names that
    # the candidate itself creates are not required to exist yet. Dotted names
    # are implicit VLANs; require their lower parent instead of the VLAN device.
    local parsed_file="$1"
    local pinning_root="$2"
    local require_target_pinning="${3:-0}"
    local list_file="${WORKDIR}/network-required-links.list"
    local link=""
    local missing=0

    if ! awk '
        function addref(x, parent) {
            if (x == "" || x == "none" || x == "regex" || x == "glob") return
            if (index(x, ".") > 0) {
                created[x] = 1
                parent = x
                sub(/\..*$/, "", parent)
                if (parent != "") refs[parent] = 1
                return
            }
            refs[x] = 1
        }
        function commit() {
            if (!active) return
            stanza[ifname] = 1
            if (creator || index(ifname, ".") > 0) created[ifname] = 1
            if (index(ifname, ".") > 0) {
                parent = ifname
                sub(/\..*$/, "", parent)
                addref(parent)
            }
        }
        $1 == "iface" {
            commit()
            active = 1
            ifname = $2
            creator = 0
            next
        }
        active && ($1 == "bridge-ports" || $1 == "bridge_ports") {
            creator = 1
            if ($2 == "regex" || $2 == "glob") next
            for (i = 2; i <= NF; i++) {
                if (substr($i, 1, 1) == "#") break
                addref($i)
            }
            next
        }
        active && ($1 == "bond-slaves" || $1 == "bond_slaves") {
            creator = 1
            if ($2 == "regex" || $2 == "glob") next
            for (i = 2; i <= NF; i++) {
                if (substr($i, 1, 1) == "#") break
                addref($i)
            }
            next
        }
        active && ($1 == "vlan-raw-device" || $1 == "vlan_raw_device") {
            creator = 1
            addref($2)
            next
        }
        active && ($1 == "vlan-id" || $1 == "vlan_id" \
            || $1 == "vxlan-id" || $1 == "vxlan_id") { creator = 1; next }
        END {
            commit()
            for (name in refs) if (!created[name]) print name
        }
    ' "${parsed_file}" | sort -u > "${list_file}"; then
        return 1
    fi

    while IFS= read -r link; do
        [[ -n "${link}" ]] || continue
        # Complex bridge-port expressions are left to ifupdown2 itself.
        [[ "${link}" =~ ^[A-Za-z0-9_.:-]+$ ]] || continue

        if [[ -e "/sys/class/net/${link}" ]]; then
            if (( require_target_pinning == 0 )); then
                continue
            fi
            # Pinning changes are irrelevant to already existing software-only
            # interfaces. Hardware-backed links must still be reproducible by
            # the target .link set because their current custom name may vanish
            # on reboot when pinning changes or is removed.
            if ! network_interface_is_physical "${link}"; then
                continue
            fi
        fi

        if network_pinning_provides_name "${pinning_root}" "${link}"; then
            continue
        fi

        if (( require_target_pinning == 1 )); then
            if [[ -z "${pinning_root}" ]]; then
                echo "Referenced physical network link cannot be verified after removing target interface pinning: ${link}" >&2
            else
                echo "Referenced physical network link is not safely reproducible by the changed target .link pinning: ${link}" >&2
            fi
        else
            echo "Referenced network link is missing and is not backed by staged .link pinning for detected hardware: ${link}" >&2
        fi
        missing=1
    done < "${list_file}"

    (( missing == 0 ))
}


network_state_file_path() {
    # Read ifupdown2.conf with the same RawConfigParser model as ifupdown2 3.3.0.
    # If a configured absolute state_dir cannot be created, mirror statemanager's
    # fallback to /var/tmp/network/. Relative paths are refused here because their
    # meaning would depend on the caller's working directory and cannot be
    # fingerprinted safely by this recovery tool.
    local conf="/etc/network/ifupdown2/ifupdown2.conf"
    local state_file=""

    state_file="$(python3 - "${conf}" <<'PYCFG'
import configparser
import io
import os
import sys

conf = sys.argv[1]
default_dir = "/var/tmp/network/"
state_dir = default_dir
used_default = True

if os.path.exists(conf):
    try:
        with open(conf, "r", encoding="utf-8") as handle:
            raw = handle.read()
        parser = configparser.RawConfigParser()
        parser.read_file(io.StringIO("[ifupdown2]\n" + raw))
        configured = dict(parser.items("ifupdown2")).get("state_dir")
    except (OSError, configparser.Error, UnicodeError):
        sys.exit(2)

    if configured:
        state_dir = configured
        used_default = False

if not os.path.isabs(state_dir):
    sys.exit(3)

try:
    os.makedirs(state_dir, exist_ok=True)
except OSError:
    if used_default:
        sys.exit(4)
    state_dir = default_dir
    try:
        os.makedirs(state_dir, exist_ok=True)
    except OSError:
        sys.exit(5)

if not os.path.isdir(state_dir):
    sys.exit(6)

print(os.path.join(state_dir, "ifstatenew"))
PYCFG
)" || return 1

    [[ -n "${state_file}" ]] || return 1
    printf '%s\n' "${state_file}"
}


network_ifupdown2_daemon_mode_enabled() {
    # ifupdown2 3.3.0 daemon_mode() uses a literal substring test over the
    # whole config file, including comments. Mirror that test exactly.
    local source_root="$1"
    local conf="${source_root}/ifupdown2/ifupdown2.conf"

    [[ -r "${conf}" ]] || return 1
    grep -Fq 'use_daemon=yes' "${conf}"
}

network_state_fingerprint() {
    local file="$1"
    local meta=""
    local hash=""

    if [[ ! -e "${file}" && ! -L "${file}" ]]; then
        printf 'ABSENT\n'
        return 0
    fi
    [[ -f "${file}" && ! -L "${file}" ]] || return 1

    meta="$(stat -Lc '%d:%i:%s:%y:%z' -- "${file}")" || return 1
    hash="$(sha256sum -- "${file}" | awk '{print $1}')" || return 1
    printf '%s:%s\n' "${meta}" "${hash}"
}


run_network_ifquery_isolated() {
    local source_root="$1"
    local output_file="$2"
    local error_file="$3"
    local rc=0

    : > "${output_file}"
    : > "${error_file}"

    if unshare --mount --propagation private -- \
        bash -c '
            mount --bind "$1" /etc/network || exit 200
            mount -t tmpfs -o mode=0755 tmpfs /var/log || exit 201
            exec ifquery -a
        ' _ "${source_root}" >"${output_file}" 2>"${error_file}" 5>&- 7>&- 8>&-; then
        return 0
    else
        rc=$?
    fi

    if (( rc == 200 || rc == 201 )) || grep -q '^unshare:' "${error_file}"; then
        NETWORK_VALIDATION_REASON="isolation"
    fi
    return "${rc}"
}


run_network_candidate_model_isolated() {
    # Build the dependency/STP model from every iface stanza that ifupdown2 can
    # actually query in the frozen candidate. `ifquery -a` and `ifquery -l` are
    # both auto-filtered in ifupdown2 3.3.0, so neither can enumerate non-auto
    # VLAN/bridge/bond stanzas. Collect a conservative superset of iface names
    # from the captured parser tree, then ask ifupdown2 for each raw stanza. A
    # name from an unsourced file is ignored only when ifupdown2 itself does not
    # know it; syntax validation still runs separately against the full tree.
    local source_root="$1"
    local output_file="$2"
    local error_file="$3"
    local rc=0

    : > "${output_file}"
    : > "${error_file}"

    if unshare --mount --propagation private -- \
        bash -c '
            set -o pipefail
            mount --bind "$1" /etc/network || exit 200
            mount -t tmpfs -o mode=0755 tmpfs /var/log || exit 201

            names_file="$(mktemp /run/pve-config-restore-ifaces.XXXXXX)" || exit 202
            model_file="$(mktemp /run/pve-config-restore-model.XXXXXX)" || {
                rm -f -- "$names_file"
                exit 202
            }
            trap '\''rm -f -- "$names_file" "$model_file"'\'' EXIT

            {
                printf "%s\0" /etc/network/interfaces
                if [[ -d /etc/network/interfaces.d && ! -L /etc/network/interfaces.d ]]; then
                    find /etc/network/interfaces.d -type f -print0
                fi
            } | while IFS= read -r -d "" file; do
                awk '\''
                    $1 == "iface" && NF >= 2 && substr($2, 1, 1) != "#" { print $2 }
                '\'' "$file"
            done | LC_ALL=C sort -u > "$names_file" || exit 203

            [[ -s "$names_file" ]] || exit 202
            found=0
            while IFS= read -r ifname; do
                [[ -n "$ifname" ]] || continue
                stanza="$(ifquery -x -- "$ifname" 2>/dev/null)" || continue
                [[ -n "$stanza" ]] || continue
                printf "%s\n" "$stanza" >> "$model_file" || exit 203
                found=1
            done < "$names_file"

            (( found == 1 )) || exit 202
            cat "$model_file"
        ' _ "${source_root}" >"${output_file}" 2>"${error_file}" 5>&- 7>&- 8>&-; then
        return 0
    else
        rc=$?
    fi

    if (( rc == 200 || rc == 201 )) || grep -q '^unshare:' "${error_file}"; then
        NETWORK_VALIDATION_REASON="isolation"
    fi
    return "${rc}"
}


network_build_bridge_mtu_rewrite_allowlist() {
    # C-27 must not hide a real MTU error while removing ifupdown2's bridge-MTU
    # syntax false-positive. Inspect the ORIGINAL frozen parser tree, before any
    # throw-away rewrite, and allow only one MTU belonging to a stanza that
    # explicitly declares bridge-ports/bridge_ports. If the same interface has
    # another MTU stanza, a duplicate MTU, a non-numeric value or a value outside
    # the reviewed address.py validrange (552..9216), fail closed.
    #
    # This intentionally does not try to recognise every conceivable Linux
    # bridge spelling. A bridge without bridge-ports remains untouched and will
    # still be judged by ifupdown2. False refusal is safer than masking an error.
    local source_root="$1"
    local allowlist_file="$2"
    local files_file="${WORKDIR}/network-c27-source-files.list"
    local file=""
    local -a files=()

    : > "${allowlist_file}" || return 1
    : > "${files_file}" || return 1

    printf '%s\0' "${source_root}/interfaces" > "${files_file}" || return 1
    if [[ -d "${source_root}/interfaces.d" && ! -L "${source_root}/interfaces.d" ]]; then
        if ! find "${source_root}/interfaces.d" -type f -print0 >> "${files_file}"; then
            echo "C-27 could not enumerate interfaces.d for bridge-MTU safety analysis." >&2
            return 1
        fi
    fi

    if ! mapfile -d '' -t files < "${files_file}"; then
        echo "C-27 could not read the network source-file list." >&2
        return 1
    fi
    ((${#files[@]} > 0)) || return 1

    if ! awk '
        function reset_stanza() {
            in_iface = 0
            ifname = ""
            bridge_ports = 0
            mtu_count = 0
            mtu_valid = 0
            mtu_bad = 0
        }

        function commit_stanza() {
            if (!in_iface) {
                return
            }

            if (bridge_ports > 0) {
                bridge_seen[ifname] = 1
            }

            mtu_total[ifname] += mtu_count

            if (bridge_ports > 0 && mtu_count > 0) {
                bridge_mtu_stanzas[ifname]++
                if (mtu_count == 1 && mtu_valid == 1 && !mtu_bad) {
                    bridge_mtu_safe[ifname]++
                }
            }
        }

        BEGIN { reset_stanza() }

        FNR == 1 && NR != 1 {
            commit_stanza()
            reset_stanza()
        }

        $1 == "iface" {
            commit_stanza()
            reset_stanza()
            in_iface = 1
            ifname = $2
            next
        }

        in_iface && ($1 == "bridge-ports" || $1 == "bridge_ports") {
            bridge_ports++
            next
        }

        in_iface && $1 == "mtu" {
            mtu_count++
            value = $2
            if (NF >= 2 && value ~ /^[0-9]+$/ \
                && (value + 0) >= 552 && (value + 0) <= 9216 \
                && (NF == 2 || substr($3, 1, 1) == "#")) {
                mtu_valid++
            } else {
                mtu_bad = 1
            }
            next
        }

        END {
            commit_stanza()

            for (name in bridge_seen) {
                if (mtu_total[name] == 0) {
                    continue
                }

                if (mtu_total[name] != 1 \
                    || bridge_mtu_stanzas[name] != 1 \
                    || bridge_mtu_safe[name] != 1) {
                    printf "C-27 refuses ambiguous or invalid bridge MTU configuration for interface %s.\n", name > "/dev/stderr"
                    bad = 1
                } else {
                    print name
                }
            }

            exit(bad ? 1 : 0)
        }
    ' "${files[@]}" | LC_ALL=C sort -u > "${allowlist_file}"; then
        : > "${allowlist_file}" || true
        return 1
    fi

    return 0
}


network_c27_bridge_mtu_workaround_supported() {
    # C-27 is intentionally pinned to the exact reviewed ifupdown2 package
    # version and the C-27-relevant implementation/configuration files, not just
    # address.py. The safety argument depends on bridge classification, VLAN/Bond
    # link-kind handling, the -s syntax-check control flow and the fact that
    # Proxmox's mtu.py is a dummy addon. Any drift disables the workaround until
    # it is re-reviewed.
    local source_root="$1"
    local expected_ifupdown2_version="3.3.0-1+pmx12"
    local installed_ifupdown2_version=""
    local path=""
    local expected=""
    local actual=""
    local label=""
    local spec=""
    if [[ ! -x /usr/bin/dpkg-query ]]; then
        echo "C-27 bridge-MTU workaround requires /usr/bin/dpkg-query for the reviewed package-version gate." >&2
        return 1
    fi

    installed_ifupdown2_version="$(/usr/bin/dpkg-query -W -f='${Version}' ifupdown2 2>/dev/null)" || {
        echo "C-27 bridge-MTU workaround could not determine the installed ifupdown2 package version." >&2
        return 1
    }
    if [[ "${installed_ifupdown2_version}" != "${expected_ifupdown2_version}" ]]; then
        echo "C-27 bridge-MTU workaround is disabled because the installed ifupdown2 package version differs from the reviewed version." >&2
        echo "Expected version: ${expected_ifupdown2_version}" >&2
        echo "Installed version: ${installed_ifupdown2_version}" >&2
        return 1
    fi

    local -a reviewed_files=(
        "/usr/share/ifupdown2/addons/address.py|dac2df4151a3b1e62a27d17da36133e3a5f63f807ec9026ea1a998aea61ff30c|address.py"
        "/usr/share/ifupdown2/addons/bridge.py|8f2aaa8d100e85c61ffed02b73cef57922cbab263504620f6a3b87c696f45c4a|bridge.py"
        "/usr/share/ifupdown2/addons/mtu.py|e372763fed386e4b74864af5cd97e2e048c95d9f9c6296d7a8d0181bb2132ad9|mtu.py"
        "/usr/share/ifupdown2/addons/bond.py|6dcb3d4833c0a91a3babb95c04dd51b0063d5cfd113bf7a6a559c97590eccd8b|bond.py"
        "/usr/share/ifupdown2/addons/vlan.py|4a50172922f67a8b051a26e17b9224a9a0b8bbe48ef5513a19ecc1052619e88c|vlan.py"
        "/usr/share/ifupdown2/ifupdown/iface.py|3c92e1ba6e52e6940883574d4ba1447b4a96ec8da61e67e71c7b69cc2252ca4c|iface.py"
        "/usr/share/ifupdown2/ifupdown/ifupdownmain.py|c9b9bccbebbcc4e89286e329caf6f9e0b1c5184d21da893b95ea54156b7dd564|ifupdownmain.py"
        "${source_root}/ifupdown2/addons.conf|e1342588e716f82b2231f436e60f48ef2b9278688584b801b34bd0a449341438|candidate addons.conf"
        "${source_root}/ifupdown2/ifupdown2.conf|4541ce3093c470199c9eb0ebbee49d6bbf509fc8ba531a097ab92cf8656bb6e6|candidate ifupdown2.conf"
    )

    for spec in "${reviewed_files[@]}"; do
        IFS='|' read -r path expected label <<< "${spec}"

        if [[ ! -f "${path}" || -L "${path}" ]]; then
            echo "C-27 bridge-MTU workaround requires the reviewed regular file: ${path}" >&2
            return 1
        fi

        actual="$(sha256sum -- "${path}" | awk '{print $1}')" || return 1
        if [[ "${actual}" != "${expected}" ]]; then
            echo "C-27 bridge-MTU workaround is disabled because ${label} differs from the reviewed implementation." >&2
            echo "Path:              ${path}" >&2
            echo "Expected SHA-256: ${expected}" >&2
            echo "Actual SHA-256:   ${actual}" >&2
            return 1
        fi
    done

    return 0
}


network_c27_bridge_mtu_false_positive_messages_safe() {
    # R7 pass A keeps bridge MTUs intact so dependency checks still see the
    # original candidate values. A non-zero syntax result may be bypassed only
    # when every C-27-specific diagnostic is the exact bridge-MTU false-positive
    # from the reviewed address.py, and only for an interface already present in
    # the conservative bridge-MTU allowlist. All remaining diagnostics are fed
    # through the existing strict rc=0 warning filter.
    local messages_file="$1"
    local bridge_mtu_allowlist="$2"
    local candidate_model="$3"
    local seen_file="$4"
    local residual_file="${WORKDIR}/network-c27-pass-a-residual.out"
    local line=""
    local ifname=""

    : > "${residual_file}" || return 1
    : > "${seen_file}" || return 1
    [[ -s "${messages_file}" ]] || return 1

    while IFS= read -r line || [[ -n "${line}" ]]; do
        [[ -z "${line}" ]] && continue

        if [[ "${line}" =~ ^[[:space:]]*warning:[[:space:]]+([^:[:space:]]+):[[:space:]]+bridge[[:space:]]+inherits[[:space:]]+mtu[[:space:]]+from[[:space:]]+its[[:space:]]+ports\.[[:space:]]+There[[:space:]]+is[[:space:]]+no[[:space:]]+need[[:space:]]+to[[:space:]]+assign[[:space:]]+mtu[[:space:]]+on[[:space:]]+a[[:space:]]+bridge[[:space:]]*$ ]]; then
            ifname="${BASH_REMATCH[1]}"

            if ! grep -Fxq -- "${ifname}" "${bridge_mtu_allowlist}"; then
                return 1
            fi
            if grep -Fxq -- "${ifname}" "${seen_file}"; then
                return 1
            fi
            printf '%s\n' "${ifname}" >> "${seen_file}" || return 1
            continue
        fi

        printf '%s\n' "${line}" >> "${residual_file}" || return 1
    done < "${messages_file}"

    # A non-zero R7 pass-A result is accepted only when at least one exact
    # bridge-MTU false-positive was actually removed from its diagnostics. The
    # caller reuses this exact seen list as the only MTU-rewrite allowlist for
    # pass B, so an unobserved raw candidate is never transformed unnecessarily.
    [[ -s "${seen_file}" ]] || return 1

    network_syntax_messages_safe "${residual_file}" "${candidate_model}"
}


rewrite_network_validation_file() {
    # Work only on a regular file whose canonical path is inside the fresh
    # validation directory. C-26 rewrites one safe bridge-fd 0 to fd 2. C-27
    # additionally removes one pre-approved explicit bridge MTU from this
    # throw-away copy. The real/restored file is never normalized.
    local validation_root="$1"
    local file="$2"
    local bridge_mtu_allowlist="$3"
    local canonical_root=""
    local canonical_file=""
    local tmp=""

    [[ -f "${file}" && ! -L "${file}" ]] || return 0

    canonical_root="$(readlink -f -- "${validation_root}")" || return 1
    canonical_file="$(readlink -f -- "${file}")" || return 1
    [[ "${canonical_file}" == "${canonical_root}/"* ]] || {
        echo "Refusing to rewrite a validation path outside the private copy: ${canonical_file}" >&2
        return 1
    }

    tmp="$(mktemp "${WORKDIR}/network-rewrite.XXXXXX")" || return 1

    if ! awk -v allowfile="${bridge_mtu_allowlist}" '
        function reset_stanza() {
            n = 0
            in_iface = 0
            ifname = ""
            fd_zero = 0
            fd_other = 0
            fd_count = 0
            stp_disabled = 0
            stp_enabled = 0
            stp_other = 0
            stp_count = 0
            bridge_ports = 0
            mtu_count = 0
            mtu_valid = 0
            mtu_line = 0
        }

        function flush_stanza(    i, line, prefix, rest, safe_fd, safe_mtu) {
            safe_fd = in_iface && fd_zero && !fd_other && fd_count == 1 \
                && stp_count <= 1 \
                && (stp_count == 0 || (stp_disabled && !stp_enabled && !stp_other))

            safe_mtu = in_iface && allowed[ifname] \
                && bridge_ports > 0 && mtu_count == 1 && mtu_valid == 1

            for (i = 1; i <= n; i++) {
                if (safe_mtu && i == mtu_line) {
                    delete buf[i]
                    continue
                }

                line = buf[i]
                if (safe_fd \
                    && line ~ /^[[:space:]]*bridge[-_]fd[[:space:]]+0([[:space:]]|$)/) {
                    match(line, /^[[:space:]]*bridge[-_]fd[[:space:]]+/)
                    prefix = substr(line, 1, RLENGTH)
                    rest = substr(line, RLENGTH + 1)
                    sub(/^0/, "2", rest)
                    line = prefix rest
                }
                print line
                delete buf[i]
            }
            reset_stanza()
        }

        BEGIN {
            while ((getline name < allowfile) > 0) {
                if (name != "") allowed[name] = 1
            }
            close(allowfile)
            reset_stanza()
        }

        $1 == "iface" {
            flush_stanza()
            in_iface = 1
            ifname = $2
            buf[++n] = $0
            next
        }

        {
            buf[++n] = $0

            if (in_iface && ($1 == "bridge-fd" || $1 == "bridge_fd")) {
                fd_count++
                if ($2 == "0") fd_zero = 1
                else fd_other = 1
            } else if (in_iface && ($1 == "bridge-stp" || $1 == "bridge_stp")) {
                stp_count++
                if ($2 == "off" || $2 == "no") stp_disabled = 1
                else if ($2 == "on" || $2 == "yes") stp_enabled = 1
                else stp_other = 1
            } else if (in_iface && ($1 == "bridge-ports" || $1 == "bridge_ports")) {
                bridge_ports++
            } else if (in_iface && $1 == "mtu") {
                mtu_count++
                mtu_line = n
                if (NF >= 2 && $2 ~ /^[0-9]+$/ \
                    && ($2 + 0) >= 552 && ($2 + 0) <= 9216 \
                    && (NF == 2 || substr($3, 1, 1) == "#")) {
                    mtu_valid++
                }
            }
        }

        END { flush_stanza() }
    ' "${file}" > "${tmp}"; then
        rm -f -- "${tmp}"
        return 1
    fi

    if ! cat "${tmp}" > "${file}"; then
        rm -f -- "${tmp}"
        return 1
    fi

    rm -f -- "${tmp}"
    return 0
}


prepare_network_validation_copy() {
    # Copy parser input from the immutable candidate tree, never directly from
    # a second live /etc/network snapshot. Only the throw-away copy is rewritten.
    local source_root="$1"
    local validation_dir="$2"
    local bridge_mtu_allowlist="$3"
    local list_file="${WORKDIR}/network-validation-files.list"
    local file=""

    if [[ ! -d "${source_root}" || -L "${source_root}" ]]; then
        echo "Network validation source must be a real directory." >&2
        NETWORK_VALIDATION_REASON="isolation"
        return 1
    fi
    if [[ ! -d "${validation_dir}" || -L "${validation_dir}" ]]; then
        echo "Private validation destination is not a real directory." >&2
        NETWORK_VALIDATION_REASON="isolation"
        return 1
    fi

    if ! cp -a -- "${source_root}/." "${validation_dir}/"; then
        echo "Could not create the private /etc/network validation copy." >&2
        NETWORK_VALIDATION_REASON="isolation"
        return 1
    fi

    if [[ -L "${validation_dir}/interfaces" ]]; then
        echo "Private validation refuses a symlinked /etc/network/interfaces." >&2
        NETWORK_VALIDATION_REASON="diagnostic"
        return 1
    fi
    if [[ ! -f "${validation_dir}/interfaces" ]]; then
        echo "Private validation copy has no regular /etc/network/interfaces." >&2
        NETWORK_VALIDATION_REASON="diagnostic"
        return 1
    fi

    rewrite_network_validation_file "${validation_dir}" "${validation_dir}/interfaces" "${bridge_mtu_allowlist}" || {
        NETWORK_VALIDATION_REASON="isolation"
        return 1
    }

    : > "${list_file}"
    if [[ -L "${validation_dir}/interfaces.d" ]]; then
        echo "Private validation refuses a symlinked /etc/network/interfaces.d." >&2
        NETWORK_VALIDATION_REASON="diagnostic"
        return 1
    fi
    if [[ -d "${validation_dir}/interfaces.d" ]]; then
        if ! find "${validation_dir}/interfaces.d" -type f -print0 > "${list_file}"; then
            echo "Could not enumerate interfaces.d in the private validation copy." >&2
            NETWORK_VALIDATION_REASON="isolation"
            return 1
        fi

        while IFS= read -r -d '' file; do
            rewrite_network_validation_file "${validation_dir}" "${file}" "${bridge_mtu_allowlist}" || {
                NETWORK_VALIDATION_REASON="isolation"
                return 1
            }
        done < "${list_file}"
    fi

    return 0
}


network_ifupdown_lock_path_usable() {
    [[ -d /run/network && -w /run/network ]] || return 1
    if [[ -e /run/network/.lock || -L /run/network/.lock ]]; then
        [[ -w /run/network/.lock ]] || return 1
    fi
    return 0
}


run_network_syntax_check() {
    # Run ifreload's syntax check in a private mount namespace. /run remains
    # shared so ifupdown2 coordinates with real concurrent instances. /var/log
    # is a private tmpfs so the synthetic fd-2 validation copy never enters the
    # host's persistent ifupdown2 debug log history.
    local validation_dir="$1"
    local messages_file="$2"
    local rc=0
    local waited=0
    local delay=1
    local remaining=0

    NETWORK_VALIDATION_CONCURRENT=0

    while true; do
        : > "${messages_file}"
        if unshare --mount --propagation private -- \
            bash -c '
                mount --bind "$1" /etc/network || exit 200
                mount -t tmpfs -o mode=0755 tmpfs /var/log || exit 201
                exec ifreload -a -s
            ' _ "${validation_dir}" >"${messages_file}" 2>&1 5>&- 7>&- 8>&-; then
            return 0
        else
            rc=$?
        fi

        if (( rc == 200 || rc == 201 )) || grep -q '^unshare:' "${messages_file}"; then
            NETWORK_VALIDATION_REASON="isolation"
            return "${rc}"
        fi

        if (( rc != 89 )); then
            return "${rc}"
        fi

        if ! network_ifupdown_lock_path_usable; then
            NETWORK_VALIDATION_REASON="lock-unavailable"
            return 89
        fi
        NETWORK_VALIDATION_CONCURRENT=1

        if (( waited >= NETWORK_LOCK_WAIT_SECONDS )); then
            NETWORK_VALIDATION_REASON="busy"
            return 89
        fi

        remaining=$(( NETWORK_LOCK_WAIT_SECONDS - waited ))
        (( delay > remaining )) && delay="${remaining}"
        echo "ifupdown2 is busy (rc=89); waiting up to ${NETWORK_LOCK_WAIT_SECONDS}s for network syntax validation..." >&2
        sleep "${delay}"
        waited=$(( waited + delay ))
        (( delay < 5 )) && delay=$(( delay * 2 ))
        (( delay > 5 )) && delay=5
    done
}


network_connectivity_record() {
    # C-28 must keep recording after a management SSH session disappears.
    # The journal is best-effort; the WORKDIR event log is the local primary
    # trace for the still-running restore transaction.
    local message="$*"
    local stamp=""

    stamp="$(date --iso-8601=ns 2>/dev/null || true)"
    printf '%s %s\n' "${stamp:-unknown-time}" "${message}" \
        >> "${WORKDIR}/network-connectivity-events.log" 2>/dev/null || true
    log_event notice "C-28: ${message}"
    return 0
}


network_connectivity_terminal_notice() {
    # Terminal output is advisory only once live network apply has started.
    # A dead SSH pty/socket must never abort the automatic rollback path.
    printf '%s\n' "$*" || true
    return 0
}


network_connectivity_monotonic_ms() {
    [[ -r /proc/uptime ]] || return 1
    awk '{ printf "%.0f\n", $1 * 1000 }' /proc/uptime 2>/dev/null
}


network_connectivity_ifname_valid() {
    local value="$1"
    [[ -n "${value}" && ${#value} -le 15 && "${value}" =~ ^[A-Za-z0-9_.:-]+$ ]]
}


network_connectivity_ipv4_valid() {
    local value="$1"
    python3 - "${value}" <<'PYCONNECTIVITYIP'
import ipaddress
import sys
try:
    ipaddress.IPv4Address(sys.argv[1])
except ValueError:
    raise SystemExit(1)
PYCONNECTIVITYIP
}


network_connectivity_ipv4_cidr_valid() {
    local value="$1"
    python3 - "${value}" <<'PYCONNECTIVITYCIDR'
import ipaddress
import sys
try:
    iface = ipaddress.IPv4Interface(sys.argv[1])
except ValueError:
    raise SystemExit(1)
if str(iface.ip) == "0.0.0.0":
    raise SystemExit(1)
PYCONNECTIVITYCIDR
}


network_connectivity_gateway_in_cidr() {
    local cidr="$1"
    local gateway="$2"
    python3 - "${cidr}" "${gateway}" <<'PYCONNECTIVITYGW'
import ipaddress
import sys
try:
    iface = ipaddress.IPv4Interface(sys.argv[1])
    gateway = ipaddress.IPv4Address(sys.argv[2])
except ValueError:
    raise SystemExit(1)
raise SystemExit(0 if gateway in iface.network else 1)
PYCONNECTIVITYGW
}


network_connectivity_profile_value() {
    local profile="$1"
    local key="$2"

    [[ -f "${profile}" && ! -L "${profile}" ]] || return 1
    awk -F '\t' -v wanted="${key}" '
        $1 == wanted {
            count++
            value=$2
        }
        END {
            if (count != 1) exit 1
            print value
        }
    ' "${profile}"
}


network_connectivity_write_profile() {
    local destination="$1"
    local interface="$2"
    local address="$3"
    local source_ip="$4"
    local gateway="$5"
    local physical_port="$6"
    local physical_mac="$7"
    local interface_mtu="$8"
    local port_mtu="$9"
    local temporary="${destination}.new.$$"

    umask 077
    {
        printf 'version\t1\n'
        printf 'family\tipv4\n'
        printf 'interface\t%s\n' "${interface}"
        printf 'address\t%s\n' "${address}"
        printf 'source\t%s\n' "${source_ip}"
        printf 'gateway\t%s\n' "${gateway}"
        printf 'physical_port\t%s\n' "${physical_port}"
        printf 'physical_mac\t%s\n' "${physical_mac}"
        printf 'interface_mtu\t%s\n' "${interface_mtu}"
        printf 'port_mtu\t%s\n' "${port_mtu}"
    } > "${temporary}" || {
        rm -f -- "${temporary}"
        return 1
    }
    chmod 600 -- "${temporary}" || {
        rm -f -- "${temporary}"
        return 1
    }
    mv -fT -- "${temporary}" "${destination}"
}


network_connectivity_capture_previous_profile() {
    # Initial C-28 scope: one IPv4 default route on one Linux bridge with
    # exactly one hardware-backed bridge port. Runtime values, not the current
    # config file, define PREVIOUS because this is the state rollback must prove
    # it restored.
    local destination="$1"
    local route_line=""
    local gateway=""
    local interface=""
    local route_get=""
    local route_dev=""
    local source_ip=""
    local address=""
    local physical_port=""
    local physical_mac=""
    local interface_mtu=""
    local port_mtu=""
    local candidate=""
    local -a defaults=()
    local -a addresses=()
    local -a physical_ports=()

    NETWORK_CONNECTIVITY_PROFILE_REASON=""
    rm -f -- "${destination}" "${destination}.new.$$" 2>/dev/null || true

    mapfile -t defaults < <(ip -4 -o route show default 2>/dev/null)
    if ((${#defaults[@]} != 1)); then
        NETWORK_CONNECTIVITY_PROFILE_REASON="PREVIOUS requires exactly one IPv4 default route."
        return 1
    fi
    route_line="${defaults[0]}"
    gateway="$(awk '{ for (i=1;i<=NF;i++) if ($i=="via" && i<NF) { print $(i+1); exit } }' <<< "${route_line}")"
    interface="$(awk '{ for (i=1;i<=NF;i++) if ($i=="dev" && i<NF) { print $(i+1); exit } }' <<< "${route_line}")"
    if ! network_connectivity_ipv4_valid "${gateway}" || ! network_connectivity_ifname_valid "${interface}"; then
        NETWORK_CONNECTIVITY_PROFILE_REASON="PREVIOUS default route is outside the supported C-28 IPv4 bridge model."
        return 1
    fi

    route_get="$(ip -4 route get "${gateway}" 2>/dev/null)" || {
        NETWORK_CONNECTIVITY_PROFILE_REASON="PREVIOUS gateway route could not be resolved by the kernel."
        return 1
    }
    route_dev="$(awk '{ for (i=1;i<=NF;i++) if ($i=="dev" && i<NF) { print $(i+1); exit } }' <<< "${route_get}")"
    source_ip="$(awk '{ for (i=1;i<=NF;i++) if ($i=="src" && i<NF) { print $(i+1); exit } }' <<< "${route_get}")"
    if [[ "${route_dev}" != "${interface}" ]] || ! network_connectivity_ipv4_valid "${source_ip}"; then
        NETWORK_CONNECTIVITY_PROFILE_REASON="PREVIOUS kernel route does not resolve to one supported management source/device."
        return 1
    fi

    mapfile -t addresses < <(ip -4 -o addr show dev "${interface}" scope global 2>/dev/null | awk '{ print $4 }')
    if ((${#addresses[@]} != 1)); then
        NETWORK_CONNECTIVITY_PROFILE_REASON="PREVIOUS management bridge must have exactly one global IPv4 address in the connectivity watchdog scope."
        return 1
    fi
    address="${addresses[0]}"
    if ! network_connectivity_ipv4_cidr_valid "${address}" || [[ "${address%%/*}" != "${source_ip}" ]]; then
        NETWORK_CONNECTIVITY_PROFILE_REASON="PREVIOUS source address does not match its sole global IPv4 address."
        return 1
    fi
    if ! network_connectivity_gateway_in_cidr "${address}" "${gateway}"; then
        NETWORK_CONNECTIVITY_PROFILE_REASON="PREVIOUS gateway is outside the supported directly connected IPv4 management subnet."
        return 1
    fi

    if [[ ! -d "/sys/class/net/${interface}/bridge" || ! -d "/sys/class/net/${interface}/brif" ]]; then
        NETWORK_CONNECTIVITY_PROFILE_REASON="PREVIOUS management device is not a supported Linux bridge."
        return 1
    fi

    for candidate in "/sys/class/net/${interface}/brif/"*; do
        [[ -e "${candidate}" || -L "${candidate}" ]] || continue
        candidate="${candidate##*/}"
        if network_interface_is_physical "${candidate}"; then
            physical_ports+=("${candidate}")
        fi
    done
    if ((${#physical_ports[@]} != 1)); then
        NETWORK_CONNECTIVITY_PROFILE_REASON="PREVIOUS management bridge must have exactly one hardware-backed port in the connectivity watchdog scope."
        return 1
    fi
    physical_port="${physical_ports[0]}"
    network_connectivity_ifname_valid "${physical_port}" || {
        NETWORK_CONNECTIVITY_PROFILE_REASON="PREVIOUS physical management port name is unsupported."
        return 1
    }

    if [[ "$(basename "$(readlink -f "/sys/class/net/${physical_port}/master" 2>/dev/null)" 2>/dev/null || true)" != "${interface}" ]]; then
        NETWORK_CONNECTIVITY_PROFILE_REASON="PREVIOUS physical management port is not enslaved to the management bridge."
        return 1
    fi

    physical_mac="$(network_interface_persistent_mac "${physical_port}" 2>/dev/null)" || {
        NETWORK_CONNECTIVITY_PROFILE_REASON="PREVIOUS physical management port identity cannot be proven by permanent MAC."
        return 1
    }
    interface_mtu="$(cat "/sys/class/net/${interface}/mtu" 2>/dev/null)" || return 1
    port_mtu="$(cat "/sys/class/net/${physical_port}/mtu" 2>/dev/null)" || return 1
    [[ "${interface_mtu}" =~ ^[0-9]+$ && "${port_mtu}" =~ ^[0-9]+$ ]] || {
        NETWORK_CONNECTIVITY_PROFILE_REASON="PREVIOUS management MTU runtime values are unreadable."
        return 1
    }

    network_connectivity_write_profile "${destination}" "${interface}" "${address}" "${source_ip}" \
        "${gateway}" "${physical_port}" "${physical_mac}" "${interface_mtu}" "${port_mtu}" || {
        NETWORK_CONNECTIVITY_PROFILE_REASON="PREVIOUS management profile could not be written safely."
        return 1
    }
    return 0
}


network_connectivity_build_target_profile() {
    # Derive TARGET only from the frozen ifquery model produced by the already
    # validated candidate. The current connectivity-watchdog scope supports one
    # static IPv4 management bridge, one gateway and one configured hardware-backed
    # bridge port.
    local candidate_model="$1"
    local destination="$2"
    local candidate_file="${WORKDIR}/network-connectivity-target-candidates.tsv"
    local interface=""
    local family=""
    local method=""
    local address=""
    local gateway=""
    local bridge_ports=""
    local interface_mtu=""
    local source_ip=""
    local physical_port=""
    local physical_mac=""
    local port_mtu=""
    local port_mtu_count=0
    local -a candidates=()
    local -a ports=()

    NETWORK_CONNECTIVITY_PROFILE_REASON=""
    rm -f -- "${destination}" "${destination}.new.$$" "${candidate_file}" 2>/dev/null || true
    [[ -f "${candidate_model}" && ! -L "${candidate_model}" ]] || {
        NETWORK_CONNECTIVITY_PROFILE_REASON="TARGET candidate model is unavailable."
        return 1
    }

    if ! awk -v OFS='\t' '
        function reset() {
            in_iface=0; ifname=""; family=""; method="";
            addr=""; addrc=0; gw=""; gwc=0; ports=""; portc=0;
            mtu=""; mtuc=0; unsupported=0
        }
        function commit() {
            if (!in_iface || gwc == 0) return
            if (gwc != 1 || addrc != 1 || portc != 1 || mtuc > 1 || unsupported) bad=1
            print ifname, family, method, addr, gw, ports, mtu, (gwc != 1 || addrc != 1 || portc != 1 || mtuc > 1 || unsupported ? "BAD" : "OK")
        }
        BEGIN { reset() }
        $1 == "iface" {
            commit(); reset(); in_iface=1; ifname=$2; family=$3; method=$4; next
        }
        !in_iface { next }
        $1 == "address" { addrc++; addr=$2; next }
        $1 == "gateway" { gwc++; gw=$2; next }
        ($1 == "bridge-ports" || $1 == "bridge_ports") {
            portc++; ports=""
            for (i=2; i<=NF; i++) {
                if (substr($i,1,1)=="#") break
                ports = (ports == "" ? $i : ports " " $i)
            }
            next
        }
        $1 == "mtu" { mtuc++; mtu=$2; next }
        ($1 == "up" || $1 == "pre-up" || $1 == "post-up" ||
         $1 == "down" || $1 == "pre-down" || $1 == "post-down") { unsupported=1; next }
        END { commit(); exit(bad ? 2 : 0) }
    ' "${candidate_model}" > "${candidate_file}"; then
        NETWORK_CONNECTIVITY_PROFILE_REASON="TARGET management stanza is ambiguous or uses unsupported hook directives."
        return 1
    fi

    mapfile -t candidates < "${candidate_file}"
    if ((${#candidates[@]} != 1)); then
        NETWORK_CONNECTIVITY_PROFILE_REASON="TARGET requires exactly one static IPv4 gateway stanza in the connectivity watchdog scope."
        return 1
    fi
    IFS=$'\t' read -r interface family method address gateway bridge_ports interface_mtu status <<< "${candidates[0]}"
    if [[ "${status}" != "OK" || "${family}" != "inet" || "${method}" != "static" ]]; then
        NETWORK_CONNECTIVITY_PROFILE_REASON="TARGET management stanza is not one supported IPv4 static bridge stanza."
        return 1
    fi
    if ! network_connectivity_ifname_valid "${interface}" || ! network_connectivity_ipv4_cidr_valid "${address}" \
        || ! network_connectivity_ipv4_valid "${gateway}" || ! network_connectivity_gateway_in_cidr "${address}" "${gateway}"; then
        NETWORK_CONNECTIVITY_PROFILE_REASON="TARGET management IPv4/interface values are outside the supported connectivity watchdog model."
        return 1
    fi
    source_ip="${address%%/*}"

    read -r -a ports <<< "${bridge_ports}"
    if ((${#ports[@]} != 1)) || [[ "${ports[0]}" == "none" ]]; then
        NETWORK_CONNECTIVITY_PROFILE_REASON="TARGET management bridge must configure exactly one physical bridge port in the connectivity watchdog scope."
        return 1
    fi
    physical_port="${ports[0]}"
    if ! network_connectivity_ifname_valid "${physical_port}" || ! network_interface_is_physical "${physical_port}"; then
        NETWORK_CONNECTIVITY_PROFILE_REASON="TARGET management bridge port is not one currently identifiable hardware-backed NIC."
        return 1
    fi
    physical_mac="$(network_interface_persistent_mac "${physical_port}" 2>/dev/null)" || {
        NETWORK_CONNECTIVITY_PROFILE_REASON="TARGET physical management port permanent MAC cannot be proven."
        return 1
    }

    if [[ -n "${interface_mtu}" && ! "${interface_mtu}" =~ ^[0-9]+$ ]]; then
        NETWORK_CONNECTIVITY_PROFILE_REASON="TARGET management bridge MTU is not a supported numeric value."
        return 1
    fi

    port_mtu="$(awk -v wanted="${physical_port}" '
        $1 == "iface" { in_wanted=($2 == wanted); next }
        in_wanted && $1 == "mtu" { count++; value=$2 }
        END {
            if (count > 1) exit 2
            if (count == 1) print value
        }
    ' "${candidate_model}")" || {
        NETWORK_CONNECTIVITY_PROFILE_REASON="TARGET physical port MTU is ambiguous."
        return 1
    }
    port_mtu_count="$(awk -v wanted="${physical_port}" '
        $1 == "iface" { in_wanted=($2 == wanted); next }
        in_wanted && $1 == "mtu" { count++ }
        END { print count + 0 }
    ' "${candidate_model}")" || return 1
    if (( port_mtu_count > 1 )) || [[ -n "${port_mtu}" && ! "${port_mtu}" =~ ^[0-9]+$ ]]; then
        NETWORK_CONNECTIVITY_PROFILE_REASON="TARGET physical port MTU is ambiguous or non-numeric."
        return 1
    fi

    network_connectivity_write_profile "${destination}" "${interface}" "${address}" "${source_ip}" \
        "${gateway}" "${physical_port}" "${physical_mac}" "${interface_mtu}" "${port_mtu}" || {
        NETWORK_CONNECTIVITY_PROFILE_REASON="TARGET management profile could not be written safely."
        return 1
    }
    return 0
}


network_connectivity_health_once() {
    local profile="$1"
    local interface=""
    local address=""
    local source_ip=""
    local gateway=""
    local physical_port=""
    local physical_mac=""
    local interface_mtu=""
    local port_mtu=""
    local runtime_mac=""
    local route_line=""
    local route_get=""
    local route_dev=""
    local route_source=""
    local -a defaults=()
    local -a addresses=()

    NETWORK_HEALTH_LAST_REASON="profile"
    interface="$(network_connectivity_profile_value "${profile}" interface)" || return 2
    address="$(network_connectivity_profile_value "${profile}" address)" || return 2
    source_ip="$(network_connectivity_profile_value "${profile}" source)" || return 2
    gateway="$(network_connectivity_profile_value "${profile}" gateway)" || return 2
    physical_port="$(network_connectivity_profile_value "${profile}" physical_port)" || return 2
    physical_mac="$(network_connectivity_profile_value "${profile}" physical_mac)" || return 2
    interface_mtu="$(network_connectivity_profile_value "${profile}" interface_mtu)" || return 2
    port_mtu="$(network_connectivity_profile_value "${profile}" port_mtu)" || return 2

    NETWORK_HEALTH_LAST_REASON="management-interface-missing"
    [[ -e "/sys/class/net/${interface}" ]] || return 1
    NETWORK_HEALTH_LAST_REASON="management-bridge-operstate"
    [[ "$(cat "/sys/class/net/${interface}/operstate" 2>/dev/null || true)" == "up" ]] || return 1

    NETWORK_HEALTH_LAST_REASON="physical-port-missing"
    [[ -e "/sys/class/net/${physical_port}" ]] || return 1
    NETWORK_HEALTH_LAST_REASON="physical-port-identity"
    runtime_mac="$(network_interface_persistent_mac "${physical_port}" 2>/dev/null)" || return 1
    [[ "${runtime_mac}" == "${physical_mac}" ]] || return 1
    NETWORK_HEALTH_LAST_REASON="physical-port-carrier"
    [[ "$(cat "/sys/class/net/${physical_port}/carrier" 2>/dev/null || true)" == "1" ]] || return 1
    NETWORK_HEALTH_LAST_REASON="physical-port-operstate"
    [[ "$(cat "/sys/class/net/${physical_port}/operstate" 2>/dev/null || true)" == "up" ]] || return 1
    NETWORK_HEALTH_LAST_REASON="bridge-port-master"
    [[ "$(basename "$(readlink -f "/sys/class/net/${physical_port}/master" 2>/dev/null)" 2>/dev/null || true)" == "${interface}" ]] || return 1

    mapfile -t addresses < <(ip -4 -o addr show dev "${interface}" scope global 2>/dev/null | awk '{ print $4 }')
    NETWORK_HEALTH_LAST_REASON="management-address"
    ((${#addresses[@]} == 1)) && [[ "${addresses[0]}" == "${address}" ]] || return 1

    mapfile -t defaults < <(ip -4 -o route show default 2>/dev/null)
    NETWORK_HEALTH_LAST_REASON="default-route-count"
    ((${#defaults[@]} == 1)) || return 1
    route_line="${defaults[0]}"
    NETWORK_HEALTH_LAST_REASON="default-route"
    [[ "$(awk '{ for (i=1;i<=NF;i++) if ($i=="via" && i<NF) { print $(i+1); exit } }' <<< "${route_line}")" == "${gateway}" ]] || return 1
    [[ "$(awk '{ for (i=1;i<=NF;i++) if ($i=="dev" && i<NF) { print $(i+1); exit } }' <<< "${route_line}")" == "${interface}" ]] || return 1

    route_get="$(ip -4 route get "${gateway}" 2>/dev/null)" || return 1
    route_dev="$(awk '{ for (i=1;i<=NF;i++) if ($i=="dev" && i<NF) { print $(i+1); exit } }' <<< "${route_get}")"
    route_source="$(awk '{ for (i=1;i<=NF;i++) if ($i=="src" && i<NF) { print $(i+1); exit } }' <<< "${route_get}")"
    NETWORK_HEALTH_LAST_REASON="kernel-route"
    [[ "${route_dev}" == "${interface}" && "${route_source}" == "${source_ip}" ]] || return 1

    if [[ -n "${interface_mtu}" ]]; then
        NETWORK_HEALTH_LAST_REASON="management-mtu"
        [[ "$(cat "/sys/class/net/${interface}/mtu" 2>/dev/null || true)" == "${interface_mtu}" ]] || return 1
    fi
    if [[ -n "${port_mtu}" ]]; then
        NETWORK_HEALTH_LAST_REASON="physical-port-mtu"
        [[ "$(cat "/sys/class/net/${physical_port}/mtu" 2>/dev/null || true)" == "${port_mtu}" ]] || return 1
    fi

    NETWORK_HEALTH_LAST_REASON="gateway-probe"
    timeout "${NETWORK_HEALTH_GATEWAY_PROBE_TIMEOUT_SECONDS}s" \
        ping -4 -n -c 1 -W 1 -I "${source_ip}" "${gateway}" >/dev/null 2>&1 || return 1

    NETWORK_HEALTH_LAST_REASON="healthy"
    return 0
}


network_connectivity_target_files_unchanged() {
    local validated_tree="$1"
    local stage_root="$2"
    local has_interfaces_d="$3"
    local has_pinning="$4"

    network_restored_state_matches_stage "${stage_root}" "${has_interfaces_d}" "${has_pinning}" \
        && network_validated_tree_unchanged "${validated_tree}"
}


network_connectivity_previous_files_unchanged() {
    network_previous_tree_matches "$@"
}


network_connectivity_wait_for_health() {
    # Return codes: 0 healthy; 10 timeout; 11 file drift; 12 ifupdown2 runtime
    # drift; 13 internal health machinery error.
    local profile="$1"
    local state_file="$2"
    local expected_state="$3"
    local files_check_function="$4"
    shift 4
    local start_ms=""
    local now_ms=""
    local deadline_ms=0
    local consecutive=0
    local health_rc=0
    local current_state=""

    NETWORK_CONNECTIVITY_WAIT_REASON=""
    start_ms="$(network_connectivity_monotonic_ms)" || {
        NETWORK_CONNECTIVITY_WAIT_REASON="monotonic-clock-unavailable"
        return 13
    }
    [[ "${start_ms}" =~ ^[0-9]+$ ]] || {
        NETWORK_CONNECTIVITY_WAIT_REASON="monotonic-clock-invalid"
        return 13
    }
    deadline_ms=$(( start_ms + NETWORK_HEALTH_DEADLINE_MS ))

    while true; do
        if ! "${files_check_function}" "$@"; then
            NETWORK_CONNECTIVITY_WAIT_REASON="network-file-drift"
            network_connectivity_record "health aborted: ${NETWORK_CONNECTIVITY_WAIT_REASON}"
            return 11
        fi

        current_state="$(network_state_fingerprint "${state_file}" 2>/dev/null)" || {
            NETWORK_CONNECTIVITY_WAIT_REASON="ifupdown2-state-unreadable"
            network_connectivity_record "health aborted: ${NETWORK_CONNECTIVITY_WAIT_REASON}"
            return 13
        }
        if [[ "${current_state}" != "${expected_state}" ]]; then
            NETWORK_CONNECTIVITY_WAIT_REASON="ifupdown2-runtime-drift"
            network_connectivity_record "health aborted: ${NETWORK_CONNECTIVITY_WAIT_REASON}"
            return 12
        fi

        if network_connectivity_health_once "${profile}"; then
            consecutive=$(( consecutive + 1 ))
            network_connectivity_record "health pass ${consecutive}/${NETWORK_HEALTH_REQUIRED_CONSECUTIVE_PASSES}"
            if (( consecutive >= NETWORK_HEALTH_REQUIRED_CONSECUTIVE_PASSES )); then
                # Commit-confirm needs a final gate after the last successful
                # health probe. A foreign file/runtime change during that probe,
                # or a probe that completes after the deadline, must not commit.
                if ! "${files_check_function}" "$@"; then
                    NETWORK_CONNECTIVITY_WAIT_REASON="network-file-drift"
                    network_connectivity_record "health final gate aborted: ${NETWORK_CONNECTIVITY_WAIT_REASON}"
                    return 11
                fi

                current_state="$(network_state_fingerprint "${state_file}" 2>/dev/null)" || {
                    NETWORK_CONNECTIVITY_WAIT_REASON="ifupdown2-state-unreadable"
                    network_connectivity_record "health final gate aborted: ${NETWORK_CONNECTIVITY_WAIT_REASON}"
                    return 13
                }
                if [[ "${current_state}" != "${expected_state}" ]]; then
                    NETWORK_CONNECTIVITY_WAIT_REASON="ifupdown2-runtime-drift"
                    network_connectivity_record "health final gate aborted: ${NETWORK_CONNECTIVITY_WAIT_REASON}"
                    return 12
                fi

                now_ms="$(network_connectivity_monotonic_ms)" || {
                    NETWORK_CONNECTIVITY_WAIT_REASON="monotonic-clock-unavailable"
                    return 13
                }
                [[ "${now_ms}" =~ ^[0-9]+$ ]] || {
                    NETWORK_CONNECTIVITY_WAIT_REASON="monotonic-clock-invalid"
                    return 13
                }
                if (( now_ms >= deadline_ms )); then
                    NETWORK_CONNECTIVITY_WAIT_REASON="health-deadline-exceeded:final-commit-gate"
                    network_connectivity_record "health timeout: ${NETWORK_CONNECTIVITY_WAIT_REASON}"
                    return 10
                fi

                NETWORK_CONNECTIVITY_WAIT_REASON="healthy"
                return 0
            fi
        else
            health_rc=$?
            if (( health_rc == 2 )); then
                NETWORK_CONNECTIVITY_WAIT_REASON="health-profile-invalid"
                network_connectivity_record "health aborted: ${NETWORK_CONNECTIVITY_WAIT_REASON}"
                return 13
            fi
            consecutive=0
            NETWORK_CONNECTIVITY_WAIT_REASON="${NETWORK_HEALTH_LAST_REASON:-unhealthy}"
            network_connectivity_record "health retry: ${NETWORK_CONNECTIVITY_WAIT_REASON}"
        fi

        now_ms="$(network_connectivity_monotonic_ms)" || {
            NETWORK_CONNECTIVITY_WAIT_REASON="monotonic-clock-unavailable"
            return 13
        }
        [[ "${now_ms}" =~ ^[0-9]+$ ]] || {
            NETWORK_CONNECTIVITY_WAIT_REASON="monotonic-clock-invalid"
            return 13
        }
        if (( now_ms >= deadline_ms )); then
            NETWORK_CONNECTIVITY_WAIT_REASON="health-deadline-exceeded:${NETWORK_CONNECTIVITY_WAIT_REASON}"
            network_connectivity_record "health timeout: ${NETWORK_CONNECTIVITY_WAIT_REASON}"
            return 10
        fi
        sleep "${NETWORK_HEALTH_RETRY_INTERVAL_SECONDS}"
    done
}


network_connectivity_reapply_previous_and_confirm() {
    local profile="$1"
    local state_file="$2"
    shift 2
    local state_after=""

    # Recovery must first try to re-establish PREVIOUS runtime even when its
    # optional C-28 health metadata is unavailable. Missing metadata may prevent
    # a success claim, but must not suppress the re-apply itself.
    if ! run_network_live_apply; then
        NETWORK_CONNECTIVITY_WAIT_REASON="previous-ifreload-failed"
        return 1
    fi
    if (( NETWORK_IFRELOAD_DIAGNOSTIC == 1 )); then
        NETWORK_CONNECTIVITY_WAIT_REASON="previous-ifreload-diagnostic"
        return 1
    fi

    [[ -f "${profile}" && ! -L "${profile}" ]] || {
        NETWORK_CONNECTIVITY_WAIT_REASON="previous-profile-unavailable-after-reapply"
        return 1
    }

    state_after="$(network_state_fingerprint "${state_file}" 2>/dev/null)" || {
        NETWORK_CONNECTIVITY_WAIT_REASON="previous-ifupdown2-state-unreadable"
        return 1
    }

    if ! network_connectivity_wait_for_health "${profile}" "${state_file}" "${state_after}" \
        network_connectivity_previous_files_unchanged "$@"; then
        return 1
    fi
    return 0
}


run_network_live_apply() {
    # Live apply stays strict. rc 89 means no handler ran, so retry for a
    # bounded window. Capture output so rc=0 cannot hide explicit error:/Traceback
    # diagnostics from hooks; callers treat such a result as not cleanly proven.
    local rc=0
    local waited=0
    local delay=1
    local remaining=0
    local messages_file="${WORKDIR}/network-live-apply.out"

    NETWORK_IFRELOAD_RC=0
    NETWORK_IFRELOAD_DIAGNOSTIC=0

    while true; do
        : > "${messages_file}"
        if ifreload -a >"${messages_file}" 2>&1 5>&- 7>&- 8>&-; then
            NETWORK_IFRELOAD_RC=0
            [[ ! -s "${messages_file}" ]] || cat "${messages_file}" || true
            if grep -Eiq '(^|[[:space:]])error:|Traceback \(most recent call last\):' "${messages_file}"; then
                NETWORK_IFRELOAD_DIAGNOSTIC=1
            fi
            return 0
        else
            rc=$?
        fi

        NETWORK_IFRELOAD_RC="${rc}"
        if (( rc != 89 )); then
            [[ ! -s "${messages_file}" ]] || cat "${messages_file}" >&2 || true
            return "${rc}"
        fi

        if ! network_ifupdown_lock_path_usable; then
            echo "ifupdown2 returned rc=89 and /run/network/.lock is not usable." >&2 || true
            return 89
        fi

        if (( waited >= NETWORK_LOCK_WAIT_SECONDS )); then
            echo "ifupdown2 remained busy (rc=89) for ${NETWORK_LOCK_WAIT_SECONDS} seconds." >&2 || true
            return 89
        fi

        remaining=$(( NETWORK_LOCK_WAIT_SECONDS - waited ))
        (( delay > remaining )) && delay="${remaining}"
        echo "ifupdown2 is busy (rc=89); waiting before retrying live network apply..." >&2 || true
        sleep "${delay}"
        waited=$(( waited + delay ))
        (( delay < 5 )) && delay=$(( delay * 2 ))
        (( delay > 5 )) && delay=5
    done
}


network_path_matches_snapshot() {
    # Compare existence, object type, symlink target and content. Special files
    # are rejected instead of handing FIFOs/devices/sockets to diff.
    local live_path="$1"
    local snapshot_path="$2"
    local existed="$3"

    if (( existed == 0 )); then
        [[ ! -e "${live_path}" && ! -L "${live_path}" ]]
        return
    fi

    [[ -e "${live_path}" || -L "${live_path}" ]] || return 1
    [[ -e "${snapshot_path}" || -L "${snapshot_path}" ]] || return 1

    if [[ -L "${snapshot_path}" ]]; then
        [[ -L "${live_path}" ]] || return 1
        [[ "$(readlink -- "${snapshot_path}")" == "$(readlink -- "${live_path}")" ]]
        return
    fi

    [[ ! -L "${live_path}" ]] || return 1

    if [[ -d "${snapshot_path}" ]]; then
        [[ -d "${live_path}" ]] || return 1
        network_tree_has_special_files "${snapshot_path}" && return 1
        network_tree_has_special_files "${live_path}" && return 1
        diff -qr --no-dereference -- "${snapshot_path}" "${live_path}" >/dev/null 2>&1
        return
    fi

    if [[ -f "${snapshot_path}" ]]; then
        [[ -f "${live_path}" ]] || return 1
        diff -q --no-dereference -- "${snapshot_path}" "${live_path}" >/dev/null 2>&1
        return
    fi

    # FIFO/socket/device/other unusual top-level object: fail closed, never hang.
    return 1
}


network_restore_path() {
    # Copy the source into a private sibling first, then move objects at the live
    # path with mv -T. The final move uses --no-clobber and verifies that the
    # staged object actually moved, so a destination recreated in the rename
    # window is not silently overwritten.
    local source_path="$1"
    local live_path="$2"
    local existed="$3"
    local parent=""
    local base=""
    local staging=""
    local moved_old=0

    if (( existed == 1 )); then
        [[ -e "${source_path}" || -L "${source_path}" ]] || return 1
    elif [[ ! -e "${live_path}" && ! -L "${live_path}" ]]; then
        # Snapshot says the object did not exist and it is still absent.
        # There is nothing to restore, so no parent/staging path is needed.
        return 0
    fi

    if [[ -e "${live_path}" || -L "${live_path}" ]]; then
        if mountpoint -q -- "${live_path}"; then
            echo "Refusing to replace network restore target because it is a mountpoint: ${live_path}" >&2
            return 1
        fi
    fi

    parent="$(dirname -- "${live_path}")" || return 1
    base="$(basename -- "${live_path}")" || return 1
    [[ -d "${parent}" ]] || return 1

    staging="$(mktemp -d "${parent}/.${base}.pve-config-restore.XXXXXX")" || return 1
    chmod 700 "${staging}" || { rm -rf -- "${staging}"; return 1; }

    if (( existed == 1 )); then
        if ! cp -a -- "${source_path}" "${staging}/new"; then
            rm -rf -- "${staging}"
            return 1
        fi
    fi

    if [[ -e "${live_path}" || -L "${live_path}" ]]; then
        if ! mv -T -- "${live_path}" "${staging}/old"; then
            rm -rf -- "${staging}"
            return 1
        fi
        moved_old=1
    fi

    # If the desired end state is absence, any object recreated after the first
    # rename is foreign concurrent state. Leave it untouched and retain staging
    # evidence for the caller instead of reporting a false success.
    if (( existed == 0 )); then
        if [[ -e "${live_path}" || -L "${live_path}" ]]; then
            NETWORK_RESTORE_PATH_CONCURRENT=1
            NETWORK_RESTORE_PATH_CONFLICT_STAGING="${staging}"
            return 1
        fi
        rm -rf -- "${staging}" || return 1
        return 0
    fi

    if [[ -e "${live_path}" || -L "${live_path}" ]]; then
        # Something recreated the destination after live -> staging/old.
        # Do not overwrite it and do not discard staging/old.
        NETWORK_RESTORE_PATH_CONCURRENT=1
        NETWORK_RESTORE_PATH_CONFLICT_STAGING="${staging}"
        return 1
    fi

    # --no-clobber is deliberate: if another process creates the destination
    # immediately before this move, mv leaves staging/new in place. Verify that
    # the source vanished because GNU mv -n itself returns success on no-clobber.
    if ! mv -T -n -- "${staging}/new" "${live_path}"; then
        if (( moved_old == 1 )) && [[ ! -e "${live_path}" && ! -L "${live_path}" ]]; then
            mv -T -- "${staging}/old" "${live_path}" || true
        fi
        rm -rf -- "${staging}"
        return 1
    fi
    if [[ -e "${staging}/new" || -L "${staging}/new" ]]; then
        if [[ -e "${live_path}" || -L "${live_path}" ]]; then
            NETWORK_RESTORE_PATH_CONCURRENT=1
            NETWORK_RESTORE_PATH_CONFLICT_STAGING="${staging}"
            return 1
        fi
        if (( moved_old == 1 )); then
            mv -T -- "${staging}/old" "${live_path}" || true
        fi
        rm -rf -- "${staging}"
        return 1
    fi

    rm -rf -- "${staging}" || return 1
    return 0
}

network_restore_previous_tree() {
    local old_interfaces="$1"
    local had_interfaces="$2"
    local old_interfaces_new="$3"
    local had_interfaces_new="$4"
    local old_interfaces_d="$5"
    local had_interfaces_d="$6"
    local old_pinning="$7"
    local had_pinning="$8"

    network_restore_path "${old_interfaces}" /etc/network/interfaces "${had_interfaces}" || return 1
    network_restore_path "${old_interfaces_new}" /etc/network/interfaces.new "${had_interfaces_new}" || return 1
    network_restore_path "${old_interfaces_d}" /etc/network/interfaces.d "${had_interfaces_d}" || return 1

    if (( had_pinning == 1 )); then
        ensure_directory /usr/local/lib/systemd || return 1
    fi
    network_restore_path "${old_pinning}" /usr/local/lib/systemd/network "${had_pinning}" || return 1
    return 0
}


network_previous_tree_matches() {
    local old_interfaces="$1"
    local had_interfaces="$2"
    local old_interfaces_new="$3"
    local had_interfaces_new="$4"
    local old_interfaces_d="$5"
    local had_interfaces_d="$6"
    local old_pinning="$7"
    local had_pinning="$8"

    network_path_matches_snapshot /etc/network/interfaces "${old_interfaces}" "${had_interfaces}" \
        && network_path_matches_snapshot /etc/network/interfaces.new "${old_interfaces_new}" "${had_interfaces_new}" \
        && network_path_matches_snapshot /etc/network/interfaces.d "${old_interfaces_d}" "${had_interfaces_d}" \
        && network_path_matches_snapshot /usr/local/lib/systemd/network "${old_pinning}" "${had_pinning}"
}


network_rollback_previous_tree() {
    network_restore_previous_tree "$@" || return 1
    network_previous_tree_matches "$@"
}


network_install_staged_tree() {
    local stage_root="$1"
    local has_interfaces_d="$2"
    local has_pinning="$3"

    NETWORK_RESTORE_PATH_CONCURRENT=0
    NETWORK_RESTORE_PATH_CONFLICT_STAGING=""

    network_restore_path "${stage_root}/etc/network/interfaces" /etc/network/interfaces 1 || return 1
    network_restore_path "" /etc/network/interfaces.new 0 || return 1
    network_restore_path "${stage_root}/etc/network/interfaces.d" /etc/network/interfaces.d "${has_interfaces_d}" || return 1

    if (( has_pinning == 1 )); then
        ensure_directory /usr/local/lib/systemd || return 1
    fi
    network_restore_path "${stage_root}/usr/local/lib/systemd/network" /usr/local/lib/systemd/network "${has_pinning}" || return 1
    return 0
}


network_restored_state_matches_stage() {
    local stage_root="$1"
    local has_interfaces_d="$2"
    local has_pinning="$3"

    network_path_matches_snapshot /etc/network/interfaces "${stage_root}/etc/network/interfaces" 1 \
        && network_path_matches_snapshot /etc/network/interfaces.new "${stage_root}/no-interfaces.new" 0 \
        && network_path_matches_snapshot /etc/network/interfaces.d "${stage_root}/etc/network/interfaces.d" "${has_interfaces_d}" \
        && network_path_matches_snapshot /usr/local/lib/systemd/network "${stage_root}/usr/local/lib/systemd/network" "${has_pinning}"
}


network_capture_validated_tree() {
    # Capture the candidate BEFORE it is validated; validation itself reads this
    # immutable copy, and later live-state checks compare against the same bytes.
    local destination="$1"

    [[ -d /etc/network && ! -L /etc/network ]] || return 1
    network_tree_has_special_files /etc/network && return 1
    mkdir -p -- "${destination}" || return 1
    cp -a -- /etc/network/. "${destination}/" || return 1
}


network_validated_tree_unchanged() {
    local validated_tree="$1"

    [[ -d /etc/network && ! -L /etc/network ]] || return 1
    [[ -d "${validated_tree}" && ! -L "${validated_tree}" ]] || return 1
    network_tree_has_special_files /etc/network && return 1
    network_tree_has_special_files "${validated_tree}" && return 1
    diff -qr --no-dereference -- "${validated_tree}" /etc/network >/dev/null 2>&1
}


network_detect_stp_transition() {
    # Linux checks bridge forward-delay 2..30 seconds whenever runtime STP is
    # enabled. ifupdown2 defaults bridge-stp to off, so an omitted bridge-stp
    # line is treated like explicit off/no for this safety decision. Analyze the
    # complete parsed candidate model, including non-auto bridge stanzas.
    local parsed_file="$1"
    local list_file="${WORKDIR}/network-stp-transition.list"
    local bridge=""
    local fd=""
    local state=""
    local found=0

    NETWORK_LIVE_APPLY_BLOCKED=0
    NETWORK_LIVE_APPLY_BLOCK_REASON=""

    awk '
        function reset() { fd = ""; stpoff = 1; stpseen = 0 }
        function commit() {
            if (in_iface && stpoff && fd ~ /^[0-9]+$/ && (fd < 2 || fd > 30)) print ifname, fd
        }
        $1 == "iface" {
            commit()
            in_iface = 1
            ifname = $2
            reset()
            next
        }
        in_iface && ($1 == "bridge-fd" || $1 == "bridge_fd") { fd = $2 }
        in_iface && ($1 == "bridge-stp" || $1 == "bridge_stp") {
            stpseen++
            if ($2 == "off" || $2 == "no") stpoff = 1
            else stpoff = 0
        }
        END { commit() }
    ' "${parsed_file}" | sort -u > "${list_file}"

    while read -r bridge fd; do
        [[ -n "${bridge}" ]] || continue
        [[ -e "/sys/class/net/${bridge}" ]] || continue

        if [[ ! -d "/sys/class/net/${bridge}/bridge" || ! -r "/sys/class/net/${bridge}/bridge/stp_state" ]]; then
            echo "Live apply blocked: ${bridge} exists but its runtime bridge STP state cannot be verified." >&2
            found=1
            continue
        fi

        state="$(cat "/sys/class/net/${bridge}/bridge/stp_state" 2>/dev/null || true)"
        if [[ "${state}" != "0" ]]; then
            echo "Live apply blocked: ${bridge} runtime stp_state='${state:-unreadable}', target STP off/default with bridge-fd ${fd}." >&2
            found=1
        fi
    done < "${list_file}"

    if (( found == 1 )); then
        NETWORK_LIVE_APPLY_BLOCKED=1
        NETWORK_LIVE_APPLY_BLOCK_REASON="A bridge needs an unsafe one-step STP/forward-delay transition; use a controlled reboot instead of ifreload -a."
    fi

    return 0
}


validate_network_config() {
    # Validate one immutable candidate tree without applying it. ifquery and
    # both ifreload -a -s passes see that same captured /etc/network tree in
    # private mount namespaces. R7 pass A preserves bridge MTUs so dependent
    # syntax checks keep their original MTU relationships; only C-26 fd 0 -> 2
    # is rewritten there. If pass A fails solely for the exact reviewed bridge-
    # MTU false-positive, pass B additionally neutralizes the pre-approved bridge
    # MTUs. The real/restored source candidate is never modified by either pass.
    local source_root="${1:-/etc/network}"
    local pinning_root="/usr/local/lib/systemd/network"
    (( $# >= 2 )) && pinning_root="$2"
    local require_target_pinning="${3:-0}"
    local ifquery_out="${WORKDIR}/network-ifquery.out"
    local ifquery_err="${WORKDIR}/network-ifquery.err"
    local candidate_model="${WORKDIR}/network-candidate-model.out"
    local candidate_model_err="${WORKDIR}/network-candidate-model.err"
    local ifreload_messages="${WORKDIR}/network-ifreload-syntax.out"
    local c27_dependency_messages="${WORKDIR}/network-c27-dependency-syntax.out"
    local bridge_mtu_allowlist="${WORKDIR}/network-c27-bridge-mtu-allowlist"
    local bridge_mtu_seen_allowlist="${WORKDIR}/network-c27-pass-a-seen.list"
    local empty_bridge_mtu_allowlist="${WORKDIR}/network-c27-empty-bridge-mtu-allowlist"
    local dependency_validation_dir=""
    local validation_dir=""
    local ifquery_rc=0
    local candidate_model_rc=0
    local dependency_ifreload_rc=0
    local ifreload_rc=0
    local c27_pass_a_concurrent=0

    NETWORK_VALIDATION_CONCURRENT=0
    NETWORK_VALIDATION_REASON=""
    : > "${ifquery_out}"
    : > "${ifquery_err}"
    : > "${candidate_model}"
    : > "${candidate_model_err}"
    : > "${ifreload_messages}"
    : > "${c27_dependency_messages}"
    : > "${bridge_mtu_allowlist}"
    : > "${bridge_mtu_seen_allowlist}"
    : > "${empty_bridge_mtu_allowlist}"

    if ! network_validation_source_tree_safe "${source_root}"; then
        NETWORK_VALIDATION_REASON="diagnostic"
        return 1
    fi

    if network_ifupdown2_daemon_mode_enabled "${source_root}"; then
        NETWORK_VALIDATION_REASON="isolation"
        echo "C-26 private network validation refuses ifupdown2 daemon mode (use_daemon=yes)." >&2
        echo "The daemon runs outside the private mount namespace and would not validate the captured candidate safely." >&2
        return 1
    fi

    if run_network_ifquery_isolated "${source_root}" "${ifquery_out}" "${ifquery_err}"; then
        ifquery_rc=0
    else
        ifquery_rc=$?
    fi

    if (( ifquery_rc != 0 )); then
        [[ -n "${NETWORK_VALIDATION_REASON}" ]] || NETWORK_VALIDATION_REASON="diagnostic"
        echo "ifquery -a could not produce the effective network configuration (exit code ${ifquery_rc})." >&2
        sed 's/^/  /' "${ifquery_err}" >&2
        return 1
    fi

    if [[ -s "${ifquery_err}" ]]; then
        NETWORK_VALIDATION_REASON="diagnostic"
        echo "ifquery -a printed parser diagnostics; network validation refuses them:" >&2
        sed 's/^/  /' "${ifquery_err}" >&2
        return 1
    fi

    if run_network_candidate_model_isolated "${source_root}" "${candidate_model}" "${candidate_model_err}"; then
        :
    else
        candidate_model_rc=$?
        [[ -n "${NETWORK_VALIDATION_REASON}" ]] || NETWORK_VALIDATION_REASON="diagnostic"
        echo "ifquery could not build the complete frozen network candidate model (exit code ${candidate_model_rc})." >&2
        sed 's/^/  /' "${candidate_model_err}" >&2
        return 1
    fi
    if [[ -s "${candidate_model_err}" ]]; then
        NETWORK_VALIDATION_REASON="diagnostic"
        echo "ifquery printed diagnostics while building the complete frozen network candidate model:" >&2
        sed 's/^/  /' "${candidate_model_err}" >&2
        return 1
    fi

    if ! network_ifquery_bridge_fd_zero_stanzas_safe "${candidate_model}"; then
        NETWORK_VALIDATION_REASON="diagnostic"
        echo "bridge-fd 0 is not unambiguously paired with STP off/no/default-off in the complete candidate configuration." >&2
        echo "Conflicting or ambiguous bridge stanzas are not covered by C-26 and are refused." >&2
        return 1
    fi

    if ! network_build_bridge_mtu_rewrite_allowlist "${source_root}" "${bridge_mtu_allowlist}"; then
        NETWORK_VALIDATION_REASON="diagnostic"
        echo "C-27 bridge-MTU safety analysis refused the candidate; no MTU was neutralized." >&2
        return 1
    fi

    if [[ -s "${bridge_mtu_allowlist}" ]] \
        && ! network_c27_bridge_mtu_workaround_supported "${source_root}"; then
        NETWORK_VALIDATION_REASON="diagnostic"
        echo "C-27 bridge-MTU validation requires review for this installed ifupdown2 implementation." >&2
        return 1
    fi

    if ! network_required_links_present "${candidate_model}" "${pinning_root}" "${require_target_pinning}"; then
        NETWORK_VALIDATION_REASON="diagnostic"
        return 1
    fi

    # R7 pass A is needed only when C-27 would otherwise remove a bridge MTU.
    # It retains all bridge MTUs while still applying the already-reviewed C-26
    # fd rewrite. This preserves cross-interface dependency information such as
    # VLAN MTU comparisons against a bridge parent.
    if [[ -s "${bridge_mtu_allowlist}" ]]; then
        dependency_validation_dir="$(mktemp -d "${WORKDIR}/network-c27-dependency-validation.XXXXXX")" || {
            NETWORK_VALIDATION_REASON="isolation"
            echo "Could not create the C-27 dependency-preserving validation directory." >&2
            return 1
        }

        if ! prepare_network_validation_copy "${source_root}" "${dependency_validation_dir}" "${empty_bridge_mtu_allowlist}"; then
            rm -rf -- "${dependency_validation_dir}" || true
            return 1
        fi

        echo "NOTE: C-27 R7 first validates a private dependency-preserving copy." >&2
        echo "C-26 bridge-fd 0 handling is active there, but explicit bridge MTUs remain intact." >&2

        NETWORK_VALIDATION_REASON=""
        if run_network_syntax_check "${dependency_validation_dir}" "${c27_dependency_messages}"; then
            dependency_ifreload_rc=0
        else
            dependency_ifreload_rc=$?
        fi
        c27_pass_a_concurrent="${NETWORK_VALIDATION_CONCURRENT}"

        # Preserve validator-originated hard refusal reasons before any generic
        # rc classification or C-27 diagnostic filtering. These mean the syntax
        # result itself is not safe to interpret and must never become an
        # overridable generic diagnostic.
        if [[ -n "${NETWORK_VALIDATION_REASON}" ]]; then
            case "${NETWORK_VALIDATION_REASON}" in
                busy)
                    echo "ifupdown2 remained busy for ${NETWORK_LOCK_WAIT_SECONDS} seconds during C-27 dependency validation." >&2
                    ;;
                lock-unavailable)
                    echo "ifupdown2 returned rc=89, but /run/network/.lock is not usable during C-27 dependency validation." >&2
                    ;;
                isolation)
                    echo "The C-27 dependency-preserving private mount-namespace validation could not be established safely." >&2
                    ;;
                *)
                    echo "C-27 dependency-preserving validation failed before its diagnostics could be safely classified." >&2
                    ;;
            esac
            sed 's/^/  /' "${c27_dependency_messages}" >&2
            rm -rf -- "${dependency_validation_dir}" || true
            return 1
        fi

        # Only rc=0 and rc=1 are meaningful C-27 syntax outcomes. Other return
        # codes without a dedicated validator reason are generic diagnostics.
        if (( dependency_ifreload_rc != 0 && dependency_ifreload_rc != 1 )); then
            NETWORK_VALIDATION_REASON="diagnostic"
            echo "C-27 R7 dependency-preserving syntax validation returned unexpected exit code ${dependency_ifreload_rc}; only rc=0/1 are reviewed for the pinned bridge-MTU path." >&2
            sed 's/^/  /' "${c27_dependency_messages}" >&2
            rm -rf -- "${dependency_validation_dir}" || true
            return 1
        fi

        # The ifupdown2 implementation is outside the private mount namespace.
        # Re-check only after a usable rc=0/1 result before trusting diagnostics.
        if ! network_c27_bridge_mtu_workaround_supported "${source_root}"; then
            NETWORK_VALIDATION_REASON="diagnostic"
            echo "C-27 R7 dependency validation is rejected because the reviewed ifupdown2 implementation changed during validation." >&2
            rm -rf -- "${dependency_validation_dir}" || true
            return 1
        fi

        if (( dependency_ifreload_rc == 0 )); then
            if [[ -s "${c27_dependency_messages}" ]] \
                && ! network_syntax_messages_safe "${c27_dependency_messages}" "${candidate_model}"; then
                NETWORK_VALIDATION_REASON="diagnostic"
                echo "C-27 R7 dependency-preserving ifreload -a -s printed diagnostics that are not safe to accept:" >&2
                sed 's/^/  /' "${c27_dependency_messages}" >&2
                rm -rf -- "${dependency_validation_dir}" || true
                return 1
            fi

            if ! rm -rf -- "${dependency_validation_dir}" \
                || [[ -e "${dependency_validation_dir}" || -L "${dependency_validation_dir}" ]]; then
                NETWORK_VALIDATION_REASON="isolation"
                echo "Could not remove the C-27 dependency-preserving validation copy." >&2
                return 1
            fi

            echo "NOTE: The dependency-preserving syntax pass succeeded without using the C-27 MTU rewrite." >&2
            return 0
        fi

        if ! network_c27_bridge_mtu_false_positive_messages_safe \
            "${c27_dependency_messages}" "${bridge_mtu_allowlist}" "${candidate_model}" \
            "${bridge_mtu_seen_allowlist}"; then
            NETWORK_VALIDATION_REASON="diagnostic"
            echo "C-27 R7 dependency-preserving syntax validation found diagnostics beyond the reviewed bridge-MTU false-positive:" >&2
            sed 's/^/  /' "${c27_dependency_messages}" >&2
            rm -rf -- "${dependency_validation_dir}" || true
            return 1
        fi

        [[ -s "${bridge_mtu_seen_allowlist}" ]] || {
            NETWORK_VALIDATION_REASON="diagnostic"
            echo "C-27 R7 pass A accepted no concrete bridge-MTU false-positive; pass B is refused." >&2
            rm -rf -- "${dependency_validation_dir}" || true
            return 1
        }

        echo "NOTE: C-27 R7 pass A found only the reviewed bridge-MTU false-positive plus already accepted software-interface warnings." >&2
        echo "Dependent MTU relationships were checked while the original bridge MTUs were still present." >&2
        echo "Pass B will neutralize MTU only for the bridge interfaces whose exact false-positive was seen in pass A:" >&2
        sed 's/^/  /' "${bridge_mtu_seen_allowlist}" >&2

        if ! rm -rf -- "${dependency_validation_dir}" \
            || [[ -e "${dependency_validation_dir}" || -L "${dependency_validation_dir}" ]]; then
            NETWORK_VALIDATION_REASON="isolation"
            echo "Could not remove the C-27 dependency-preserving validation copy." >&2
            return 1
        fi

        # Gate once more immediately before pass B. This does not turn the gate
        # into a package-manager lock, but it rejects persistent implementation
        # drift between the two private syntax passes.
        if ! network_c27_bridge_mtu_workaround_supported "${source_root}"; then
            NETWORK_VALIDATION_REASON="diagnostic"
            echo "C-27 R7 bridge-MTU validation is rejected because the reviewed ifupdown2 implementation changed between validation passes." >&2
            return 1
        fi
    fi

    validation_dir="$(mktemp -d "${WORKDIR}/network-validation.XXXXXX")" || {
        NETWORK_VALIDATION_REASON="isolation"
        echo "Could not create a fresh private network validation directory." >&2
        return 1
    }

    if ! prepare_network_validation_copy "${source_root}" "${validation_dir}" "${bridge_mtu_seen_allowlist}"; then
        rm -rf -- "${validation_dir}" || true
        return 1
    fi

    echo "NOTE: C-26/C-27 validate a throw-away private copy of the selected network candidate." >&2
    echo "Only unambiguous bridge-fd 0 + STP off/no/default-off stanzas are changed to fd 2." >&2
    if [[ -s "${bridge_mtu_seen_allowlist}" ]]; then
        echo "C-27 R7 pass B removes one pre-validated explicit MTU only from bridge-ports interfaces whose exact false-positive was seen in pass A" >&2
        echo "inside the second private copy:" >&2
        sed 's/^/  /' "${bridge_mtu_seen_allowlist}" >&2
    fi
    echo "The real/restored source candidate is not modified by either workaround." >&2

    NETWORK_VALIDATION_REASON=""
    if run_network_syntax_check "${validation_dir}" "${ifreload_messages}"; then
        ifreload_rc=0
    else
        ifreload_rc=$?
    fi

    # run_network_syntax_check resets NETWORK_VALIDATION_CONCURRENT for each
    # invocation. Preserve any concurrency observed in pass A by logically ORing
    # it with pass B immediately, before any subsequent return path.
    if (( c27_pass_a_concurrent == 1 )); then
        NETWORK_VALIDATION_CONCURRENT=1
    fi

    # Pass B mirrors pass A's fail-closed ordering. A validator-originated
    # hard refusal means the syntax result is not safe to interpret at all;
    # preserve that reason and return before any implementation gate can
    # reclassify it as a generic diagnostic.
    if [[ -n "${NETWORK_VALIDATION_REASON}" ]]; then
        case "${NETWORK_VALIDATION_REASON}" in
            busy)
                echo "ifupdown2 remained busy for ${NETWORK_LOCK_WAIT_SECONDS} seconds during C-27 pass-B validation." >&2
                ;;
            lock-unavailable)
                echo "ifupdown2 returned rc=89, but /run/network/.lock is not usable during C-27 pass-B validation." >&2
                ;;
            isolation)
                echo "The C-27 pass-B private mount-namespace validation could not be established safely." >&2
                ;;
            *)
                echo "C-27 pass-B validation failed before its diagnostics could be safely classified." >&2
                ;;
        esac
        sed 's/^/  /' "${ifreload_messages}" >&2
        rm -rf -- "${validation_dir}" || true
        return 1
    fi

    # Only rc=0 and rc=1 are meaningful C-27 syntax outcomes. Other return
    # codes without a dedicated validator reason are generic diagnostics and
    # are rejected before the post-pass-B implementation gate.
    if (( ifreload_rc != 0 && ifreload_rc != 1 )); then
        NETWORK_VALIDATION_REASON="diagnostic"
        echo "C-27 R7 pass-B syntax validation returned unexpected exit code ${ifreload_rc}; only rc=0/1 are reviewed for the pinned bridge-MTU path." >&2
        sed 's/^/  /' "${ifreload_messages}" >&2
        rm -rf -- "${validation_dir}" || true
        return 1
    fi

    # If C-27 was used, re-check the reviewed package/files after pass B only
    # for an otherwise interpretable rc=0/1 result. Persistent package/code
    # drift still invalidates the syntax result, but can no longer overwrite a
    # validator-originated hard refusal.
    if [[ -s "${bridge_mtu_seen_allowlist}" ]] \
        && ! network_c27_bridge_mtu_workaround_supported "${source_root}"; then
        NETWORK_VALIDATION_REASON="diagnostic"
        echo "C-27 bridge-MTU validation is rejected because the reviewed ifupdown2 implementation changed during pass B." >&2
        rm -rf -- "${validation_dir}" || true
        return 1
    fi

    if (( ifreload_rc == 0 )); then
        if [[ -s "${ifreload_messages}" ]]; then
            if ! network_syntax_messages_safe "${ifreload_messages}" "${candidate_model}"; then
                NETWORK_VALIDATION_REASON="diagnostic"
                echo "ifreload -a -s printed diagnostics that are not safe to accept:" >&2
                sed 's/^/  /' "${ifreload_messages}" >&2
                rm -rf -- "${validation_dir}" || true
                return 1
            fi
            echo "NOTE: Accepted only software-interface 'interface not recognized' warnings from the private syntax check:" >&2
            sed 's/^/  /' "${ifreload_messages}" >&2
        fi

        if ! rm -rf -- "${validation_dir}" || [[ -e "${validation_dir}" || -L "${validation_dir}" ]]; then
            NETWORK_VALIDATION_REASON="isolation"
            echo "Could not remove the private network validation copy." >&2
            return 1
        fi
        return 0
    fi

    if [[ -z "${NETWORK_VALIDATION_REASON}" ]]; then
        NETWORK_VALIDATION_REASON="diagnostic"
    fi

    case "${NETWORK_VALIDATION_REASON}" in
        busy)
            echo "ifupdown2 remained busy for ${NETWORK_LOCK_WAIT_SECONDS} seconds; network validation was not performed." >&2
            ;;
        lock-unavailable)
            echo "ifupdown2 returned rc=89, but /run/network/.lock is not usable; this is not treated as a configuration error." >&2
            ;;
        isolation)
            echo "The private mount-namespace validation could not be established safely." >&2
            ;;
        *)
            echo "ifreload -a -s failed network validation in the private copy (exit code ${ifreload_rc})." >&2
            ;;
    esac
    sed 's/^/  /' "${ifreload_messages}" >&2
    rm -rf -- "${validation_dir}" || true
    return 1
}

network_pre_restore_advisory() {
    # Run before begin_restore_session: no backup timer stop, no pre-restore
    # snapshot and no retention side effect merely because the current live
    # files are already damaged. The result is advisory except for isolation
    # and unresolved ifupdown2-lock failures, which mean the validator itself
    # cannot operate safely.
    local saved_workdir="${WORKDIR}"
    local precheck_dir=""
    local rc=0
    local reason=""

    precheck_dir="$(mktemp -d /run/pve-config-restore-precheck.XXXXXX)" || {
        NETWORK_VALIDATION_REASON="isolation"
        echo "Could not create the network pre-restore diagnostic directory." >&2
        return 1
    }
    chmod 700 "${precheck_dir}" || {
        rm -rf -- "${precheck_dir}" || true
        NETWORK_VALIDATION_REASON="isolation"
        return 1
    }

    WORKDIR="${precheck_dir}"
    if validate_network_config /etc/network /usr/local/lib/systemd/network; then
        rc=0
    else
        rc=$?
    fi
    reason="${NETWORK_VALIDATION_REASON}"

    if ! rm -rf -- "${precheck_dir}"; then
        reason="isolation"
        rc=1
    fi
    WORKDIR="${saved_workdir}"
    NETWORK_VALIDATION_REASON="${reason}"
    return "${rc}"
}


backup_members_present() {
    # Like R-06: required members are checked before a restore session
    # starts, so a missing file is a normal refusal, not an unexpected failure.
    local archive="$1"
    local member=""
    local missing=0

    shift
    for member in "$@"; do
        if ! archive_has_member "${archive}" "${member}"; then
            echo "The selected backup does not contain ${member} (or the archive could not be read)." >&2
            missing=1
        fi
    done

    (( missing == 0 ))
}


vm_tx_standalone_scope_ok() {
    # C-29 VM 1.12 is intentionally validated/released only for standalone PVE.
    # Optional path arguments exist only so the fail-closed gate can be tested
    # without touching the host's real corosync files.
    local local_corosync="${1:-/etc/corosync/corosync.conf}"
    local pmxcfs_corosync="${2:-/etc/pve/corosync.conf}"

    if [[ -e "${local_corosync}" || -L "${local_corosync}" \
        || -e "${pmxcfs_corosync}" || -L "${pmxcfs_corosync}" ]]; then
        return 1
    fi
    return 0
}


vm_qemu_process_guard() {
    # Return 0 only when no matching QEMU process exists. RC10 means a process
    # is present; RC20 means pgrep itself failed and must be treated fail-closed.
    local vmid="$1"
    local messages="${2:-}"
    local rc=0

    if pgrep -fa -- "-id ${vmid}([[:space:]]|$)" >/dev/null 2>&1; then
        [[ -z "${messages}" ]] \
            || printf '%s\n' "VM ${vmid} has a running QEMU process" > "${messages}"
        return 10
    else
        rc=$?
    fi

    if (( rc == 1 )); then
        return 0
    fi

    [[ -z "${messages}" ]] \
        || printf '%s\n' "QEMU process detection for VM ${vmid} failed (pgrep rc=${rc})" > "${messages}"
    return 20
}


vm_tx_native_lock_path() {
    local vmid="$1"

    perl -MPVE::QemuConfig -e '
        use strict;
        use warnings;
        my ($vmid) = @ARGV;
        die "invalid VMID for QEMU lock path\n" if !defined($vmid) || $vmid !~ /^[1-9][0-9]{0,8}$/;
        die "PVE::QemuConfig::config_file_lock is unavailable\n"
            if !PVE::QemuConfig->can(q{config_file_lock});
        my $path = PVE::QemuConfig->config_file_lock($vmid);
        die "PVE::QemuConfig returned no lock path\n" if !defined($path) || $path eq q{};
        print $path;
    ' "${vmid}" 7>&- 8>&-
}


vm_tx_canonical_lock_path() {
    local path="$1"
    readlink -f -- "${path}" 2>/dev/null
}


vm_tx_verify_native_lock_contract() {
    # Behavioural contract test, not a source-hash assumption: while our Bash
    # process owns the resolved flock, a separate Proxmox lock_config_full()
    # process must be unable to enter its callback. FD 6 is explicitly closed
    # in the child so it cannot inherit our already-held lock.
    local vmid="$1"
    local expected_path="$2"

    perl -MPVE::QemuConfig -e '
        use strict;
        use warnings;
        my ($vmid, $expected) = @ARGV;
        die "invalid expected QEMU lock path\n" if !defined($expected) || $expected eq q{};
        die "PVE::QemuConfig::config_file_lock is unavailable\n"
            if !PVE::QemuConfig->can(q{config_file_lock});
        die "PVE::QemuConfig::lock_config_full is unavailable\n"
            if !PVE::QemuConfig->can(q{lock_config_full});
        my $actual = PVE::QemuConfig->config_file_lock($vmid);
        die "QEMU lock path drifted before contract probe\n"
            if !defined($actual) || $actual ne $expected;

        my $callback_ran = 0;
        my ($eval_ok, $err);
        {
            open(my $null, q{>}, q{/dev/null}) or die "open /dev/null failed: $!\n";
            local *STDERR = $null;
            $eval_ok = eval {
                PVE::QemuConfig->lock_config_full(
                    $vmid, 1, sub { $callback_ran = 1; return 1; }
                );
                1;
            };
            $err = $@;
        }

        die "Proxmox lock callback unexpectedly ran while restore held the VM lock\n"
            if $callback_ran;
        die "Proxmox lock call returned without contention while restore held the VM lock\n"
            if $eval_ok;
        die "Proxmox lock contention failed for an unexpected reason: $err"
            if !defined($err) || $err eq q{} || $err !~ /lock/i || index($err, $expected) < 0;
        exit 0;
    ' "${vmid}" "${expected_path}" 6>&- 7>&- 8>&-
}


acquire_vm_config_lock() {
    # Resolve the native lock from the installed Proxmox implementation, then
    # prove behaviourally that PVE::QemuConfig->lock_config_full() contends with
    # the flock held by this restore process. This refuses fail-closed on future
    # lock-contract drift instead of silently trusting a historical hardcoded path.
    local vmid="$1"
    local lock_path=""
    local canonical_lock_path=""
    local lock_dir=""
    local fd_target=""

    if ! lock_path="$(vm_tx_native_lock_path "${vmid}")"; then
        echo "Could not resolve the native Proxmox QEMU lock path for VM ${vmid}." >&2
        return 1
    fi

    case "${lock_path}" in
        "/var/lock/qemu-server/lock-${vmid}.conf"|"/run/lock/qemu-server/lock-${vmid}.conf") ;;
        *)
            echo "Refusing unexpected Proxmox QEMU lock path: ${lock_path}" >&2
            return 1
            ;;
    esac

    lock_dir="${lock_path%/*}"
    ensure_directory "${lock_dir}" || return 1

    if [[ -L "${lock_path}" ]] \
        || { [[ -e "${lock_path}" ]] && [[ ! -f "${lock_path}" ]]; }; then
        echo "Refusing unsafe Proxmox QEMU lock object: ${lock_path}" >&2
        return 1
    fi

    exec 6>>"${lock_path}" || return 1
    if ! flock -w 10 6; then
        exec 6>&-
        return 1
    fi

    VM_CONFIG_LOCK_HELD=1

    canonical_lock_path="$(vm_tx_canonical_lock_path "${lock_path}" || true)"
    fd_target="$(readlink "/proc/${BASHPID}/fd/6" 2>/dev/null || true)"
    if [[ -z "${canonical_lock_path}" || "${fd_target}" != "${canonical_lock_path}" ]]; then
        echo "The held VM lock FD does not resolve to the canonical Proxmox lock path." >&2
        release_vm_config_lock
        return 1
    fi
    VM_CONFIG_LOCK_PATH="${canonical_lock_path}"

    if ! vm_tx_verify_native_lock_contract "${vmid}" "${lock_path}"; then
        echo "The installed Proxmox QEMU lock contract could not be proven compatible." >&2
        release_vm_config_lock
        return 1
    fi

    return 0
}


release_vm_config_lock() {
    if (( VM_CONFIG_LOCK_HELD == 1 )); then
        flock -u 6 >/dev/null 2>&1 || true
        exec 6>&-
        VM_CONFIG_LOCK_HELD=0
    fi
    VM_CONFIG_LOCK_PATH=""
}


acquire_pve_network_config_lock() {
    # Proxmox API network create/update/delete operations use the same flock
    # file via PVE::Tools::lock_file(). Holding it prevents those configuration
    # writers from racing with this restore. The API's separate Apply operation
    # does not hold this lock, therefore the pre-apply drift check remains
    # mandatory as a second line of defence.
    [[ -d /etc/network && ! -L /etc/network ]] || {
        echo "Cannot acquire the Proxmox network configuration lock because /etc/network is not a real directory." >&2
        return 1
    }

    if [[ -L /etc/network/.pve-interfaces.lock ]] \
        || { [[ -e /etc/network/.pve-interfaces.lock ]] && [[ ! -f /etc/network/.pve-interfaces.lock ]]; }; then
        echo "Refusing an unsafe Proxmox network lock path: /etc/network/.pve-interfaces.lock" >&2
        return 1
    fi

    exec 5>>/etc/network/.pve-interfaces.lock || {
        echo "Could not open /etc/network/.pve-interfaces.lock." >&2
        return 1
    }

    if ! flock -w 10 5; then
        exec 5>&-
        echo "Could not acquire the Proxmox network configuration lock within 10 seconds." >&2
        return 1
    fi

    PVE_NETWORK_LOCK_HELD=1
    return 0
}


release_pve_network_config_lock() {
    if (( PVE_NETWORK_LOCK_HELD == 1 )); then
        flock -u 5 >/dev/null 2>&1 || true
        exec 5>&-
        PVE_NETWORK_LOCK_HELD=0
    fi
}


cleanup_workdir() {
    # A failed critical preservation move must not become deletion on EXIT or
    # on a later cleanup call. Retain the original path for manual recovery.
    if [[ "${RESTORE_RECOVERY_REQUIRED:-0}" != 0 ]]; then
        if [[ -n "${WORKDIR:-}" && -d "${WORKDIR}" ]]; then
            printf 'Recovery files retained at: %s\n' "${WORKDIR}" >&2 || true
        fi
        return 0
    fi

    if [[ -n "${WORKDIR:-}" && -d "${WORKDIR}" ]]; then
        rm -rf -- "${WORKDIR}" || true
    fi
    WORKDIR=""
}


resume_backup_timer() {
    [[ "${RESTORE_RECOVERY_REQUIRED:-0}" == 0 ]] || return 0

    if (( BACKUP_TIMER_SUSPENDED == 1 )); then
        if (( BACKUP_TIMER_WAS_ACTIVE == 1 )); then
            systemctl start "${BACKUP_TIMER}" >/dev/null 2>&1 || \
                echo "WARNING: Could not restart ${BACKUP_TIMER}." >&2
        fi
        BACKUP_TIMER_SUSPENDED=0
        BACKUP_TIMER_WAS_ACTIVE=0
    fi
}



release_backup_lock() {
    if (( BACKUP_LOCK_HELD == 1 )); then
        flock -u 7 >/dev/null 2>&1 || true
        exec 7>&-
        BACKUP_LOCK_HELD=0
    fi
}


acquire_backup_lock() {
    exec 7>"${BACKUP_LOCKFILE}"
    if ! flock -n 7; then
        exec 7>&-
        echo "Could not acquire the backup lock; another backup started concurrently." >&2
        return 1
    fi
    BACKUP_LOCK_HELD=1
    return 0
}

unpin_selected_backup() {
    local remove_pinned=1
    local pinned_path="${PINNED_BACKUP:-}"

    if [[ -n "${pinned_path}" && -d "${pinned_path}" ]]; then
        # The pre-restore snapshot runs the normal backup tool, including its
        # retention policy. If that policy removed the originally selected
        # backup because it was old, put the pinned copy back before cleanup.
        if [[ -n "${BACKUP:-}" && ! -d "${BACKUP}" ]]; then
            echo "Restoring selected backup that was removed by retention: ${BACKUP}" >&2

            if ! cp -a -- "${pinned_path}" "${BACKUP}"; then
                echo "CRITICAL: Could not restore the original selected backup path." >&2
                echo "The protected backup copy is being kept at: ${pinned_path}" >&2
                remove_pinned=0
            fi
        fi

        if (( remove_pinned == 1 )); then
            rm -rf -- "${pinned_path}" || {
                echo "WARNING: Could not remove protected backup copy: ${pinned_path}" >&2
                remove_pinned=0
            }
        fi

        if (( remove_pinned == 0 )); then
            echo "Protected backup copy preserved at: ${pinned_path}" >&2
        fi
    fi

    PINNED_BACKUP=""
    RESTORE_BACKUP=""
}


preserve_workdir_after_unexpected_failure() {
    local rescue_base="/var/lib/vz/host-config-emergency-rollback"
    local rescue_dir=""

    if [[ -z "${WORKDIR:-}" || ! -d "${WORKDIR}" ]]; then
        return 0
    fi

    mkdir -p "${rescue_base}" || return 1
    chmod 700 "${rescue_base}" || true

    rescue_dir="${rescue_base}/unexpected-$(date '+%Y-%m-%d_%H-%M-%S').${BASHPID}"

    if mv -- "${WORKDIR}" "${rescue_dir}"; then
        chmod 700 "${rescue_dir}" || true
        WORKDIR=""
        echo "Preserved in-progress rollback files at: ${rescue_dir}" >&2
        return 0
    fi

    return 1
}


cleanup() {
    local rc=$?
    local active_restore="${RESTORE_SESSION_ACTIVE}"

    # A failing message (for example on a closed SSH terminal) must not abort
    # the remaining cleanup steps and must not trigger the ERR report.
    set +e
    trap - ERR

    if (( rc != 0 && active_restore == 1 )); then
        log_event crit "exited unexpectedly (exit code ${rc}) during an active restore operation; backup timer left stopped"
        echo >&2
        echo "WARNING: Recovery tool exited unexpectedly during an active restore operation." >&2
        echo "The automatic backup timer stays stopped for safety." >&2
        echo "Note: an enabled timer starts again automatically after the next reboot." >&2

        # If an active transaction already mutated a live object, make one
        # ownership-aware in-process rollback attempt before preserving evidence.
        # The hook never overwrites FOREIGN/AMBIGUOUS live state. Even after a
        # successful rollback the timer stays stopped because the process itself
        # terminated unexpectedly.
        if (( TX_ACTIVE == 1 && TX_MUTATION_STARTED == 1 )); then
            if tx_unexpected_rollback; then
                log_event warning "${TX_DOMAIN:-unknown} transaction rolled back after an unexpected process error"
                echo "The active transaction was rolled back to its verified PREVIOUS state." >&2 || true
            else
                log_event crit "${TX_DOMAIN:-unknown} transaction could not be rolled back safely after an unexpected process error (state=${TX_STATE:-unknown})"
                echo "Automatic rollback was not safe or did not validate; live state was not blindly overwritten." >&2 || true
            fi
        fi

        preserve_workdir_after_unexpected_failure || \
            echo "WARNING: Could not preserve the temporary rollback directory." >&2
    fi

    release_vm_config_lock
    release_pve_network_config_lock

    # Restore/preserve the selected backup before releasing the backup lock.
    unpin_selected_backup
    release_backup_lock

    # During an intentional emergency reboot, or after an unexpected failure
    # during an active restore, leave the timer stopped. Otherwise restore its
    # previous active state.
    if (( EMERGENCY_REBOOT_PENDING == 0 && !(rc != 0 && active_restore == 1) )); then
        resume_backup_timer
    fi

    if ! (( rc != 0 && active_restore == 1 )); then
        cleanup_workdir
    fi

    if (( rc != 0 && active_restore == 1 )); then
        echo "A pre-restore snapshot should exist. Inspect the affected configuration before continuing." >&2
        if (( PVE_CLUSTER_RUNTIME_MASKED_BY_TOOL == 1 )); then
            echo "pve-cluster is still runtime-masked by this recovery session." >&2
            echo "Do not unmask/start it or reboot until config.db has been checked manually." >&2
        fi
        if (( BACKUP_TIMER_WAS_ACTIVE == 1 || BACKUP_TIMER_SUSPENDED == 1 )); then
            echo "After recovery, restart the timer with: systemctl start ${BACKUP_TIMER}" >&2
        fi
    fi
}


trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Without an own HUP trap, Bash runs the EXIT trap with $? = 0 after an SSH
# disconnect. cleanup then treated an active restore as finished: it restarted
# the backup timer and deleted the rollback copies in WORKDIR.
trap 'exit 129' HUP

# Report line and command when set -e ends the tool unexpectedly (set -E makes
# functions inherit this trap). cleanup removes it.
trap 'on_unexpected_error "$?" "${LINENO}" "${BASH_COMMAND}"' ERR


critical_section_begin() {
    # While live files are being changed, INT/TERM/HUP are ignored. Ignored
    # signals are inherited by child processes (ifreload, sshd -t,
    # pve-firewall, ...), so Ctrl+C or a dropped SSH session cannot kill a
    # half-finished apply or rollback step. If the terminal is gone, the next
    # prompt or message fails and the regular failure path in cleanup runs.
    trap '' INT TERM HUP
}


critical_section_end() {
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
}


new_workdir() {
    cleanup_workdir
    WORKDIR="$(mktemp -d /run/pve-config-restore.XXXXXX)"
    chmod 700 "${WORKDIR}"
}


confirm_word() {
    local prompt="$1"
    local expected="$2"
    local answer=""

    echo
    echo "${prompt}"
    read -r -p "Type ${expected} to continue: " answer
    [[ "${answer}" == "${expected}" ]]
}


require_commands_for_operation() {
    local cmd=""

    for cmd in "$@"; do
        if ! command -v "${cmd}" >/dev/null 2>&1; then
            echo "Required command for this operation is missing: ${cmd}" >&2
            return 1
        fi
    done

    return 0
}


archive_has_member() {
    local archive="$1"
    local member="$2"
    tar -tzf "${archive}" -- "${member}" >/dev/null 2>&1
}


archive_has_prefix() {
    local archive="$1"
    local prefix="$2"
    local list_file=""
    local rc=0

    # Return 1 only when the prefix is really absent. A listing error must not
    # be read as "absent": the callers then delete the live directory
    # (sshd_config.d, interfaces.d, interface pinning) without replacement.
    list_file="$(mktemp /run/pve-config-restore.prefix.XXXXXX)" \
        || die "Could not create a temporary archive listing."

    if ! tar -tzf "${archive}" > "${list_file}"; then
        rm -f -- "${list_file}"
        die "Could not list ${archive}; ${prefix} is not treated as absent."
    fi

    awk -v prefix="${prefix}" '$0 == prefix || $0 == prefix "/" || index($0, prefix "/") == 1 { found = 1 } END { exit(found ? 0 : 1) }' \
        "${list_file}" || rc=$?
    rm -f -- "${list_file}"

    (( rc <= 1 )) || die "Could not evaluate the listing of ${archive}."
    return "${rc}"
}


extract_member() {
    local archive="$1"
    local member="$2"

    archive_has_member "${archive}" "${member}" \
        || die "Archive member not found: ${member}"

    tar -xzf "${archive}" -C "${WORKDIR}" -- "${member}"
}


extract_tree() {
    local archive="$1"
    local prefix="$2"
    local list_file=""
    local -a members=()

    [[ -n "${WORKDIR}" && -d "${WORKDIR}" ]] || return 1

    list_file="$(mktemp "${WORKDIR}/.tar-list.XXXXXX")" || return 1

    # Do not use process substitution here: mapfile would report only its own
    # status and could hide a failed tar listing. With pipefail, this pipeline
    # fails if tar or awk fails.
    if ! tar -tzf "${archive}" \
        | awk -v prefix="${prefix}" '$0 == prefix || $0 == prefix "/" || index($0, prefix "/") == 1 { print }' \
        > "${list_file}"; then
        rm -f -- "${list_file}"
        return 1
    fi

    if ! mapfile -t members < "${list_file}"; then
        rm -f -- "${list_file}"
        return 1
    fi

    rm -f -- "${list_file}" || return 1

    ((${#members[@]} > 0)) || return 1

    # --no-recursion: the list already contains the directory entry AND every
    # file below it. Without this option GNU tar matches the files through the
    # recursive directory name first, reports the explicitly listed file names
    # as "Not found in archive" and exits with status 2 as soon as the
    # directory contains at least one file (e.g. sshd_config.d/*.conf).
    tar -xzf "${archive}" -C "${WORKDIR}" --no-recursion -- "${members[@]}"
}


archive_paths_are_safe() {
    local archive="$1"

    tar -tzf "${archive}" \
        | awk '
            BEGIN { bad = 0 }
            /^\// { bad = 1 }
            {
                n = split($0, part, "/")
                for (i = 1; i <= n; i++) {
                    if (part[i] == "..") {
                        bad = 1
                    }
                }
            }
            END { exit(bad ? 1 : 0) }
        '
}


checksum_lists_file() {
    local sums_file="$1"
    local expected_name="$2"

    awk -v expected="${expected_name}" '
        NF >= 2 {
            name = $2
            sub(/^\*/, "", name)
            if (name == expected) {
                found = 1
            }
        }
        END { exit(found ? 0 : 1) }
    ' "${sums_file}"
}


checksum_manifest_paths_are_safe() {
    local sums_file="$1"

    # The backup tool currently writes simple basenames to SHA256SUMS.
    # Reject paths, option-like names, malformed hashes and unexpected
    # whitespace so `sha256sum -c` can never be tricked into reading files
    # outside the selected backup directory.
    awk '
        BEGIN { bad = 0 }

        NF != 2 {
            bad = 1
            next
        }

        {
            hash = $1
            name = $2
            sub(/^\*/, "", name)

            if (length(hash) != 64 || hash !~ /^[0-9A-Fa-f]+$/) {
                bad = 1
            }

            if (name == "" || name == "." || name == "..") {
                bad = 1
            }

            if (name ~ /\// || name ~ /^-/ || name ~ /[[:space:]]/) {
                bad = 1
            }
        }

        END { exit(bad ? 1 : 0) }
    ' "${sums_file}"
}


verify_sqlite_backup_copy() {
    local source="$1"
    local check_dir=""
    local result=""
    local rc=0

    # Validate a private copy instead of opening the selected backup through a
    # file: URI. URI filename support is build-dependent in SQLite.
    # The disposable private directory contains any transient WAL/SHM files,
    # so the selected backup and its directory mtime stay untouched.
    check_dir="$(mktemp -d /run/pve-config-restore.sqlite-check.XXXXXX)" || return 1
    chmod 700 "${check_dir}" || {
        rm -rf -- "${check_dir}"
        return 1
    }

    if ! cp -- "${source}" "${check_dir}/config.db"; then
        rm -rf -- "${check_dir}"
        return 1
    fi

    result="$(sqlite_integrity_check "${check_dir}/config.db")" || rc=$?

    if ! rm -rf -- "${check_dir}"; then
        return 1
    fi

    (( rc == 0 )) || return "${rc}"
    printf '%s\n' "${result}"
}


verify_backup_path() {
    local path="$1"
    local db_result=""
    local backup_node=""
    local verified_node=""
    local critical_file=""
    local -a expected_payload=(
        backup-info.txt
        config.db
        etc-pve.tar.gz
        etc-host.tar.gz
        pve-config-backup.sh
        system-state.txt
    )

    echo
    echo "Verifying backup: ${path}"

    [[ -d "${path}" ]] || die "Backup directory does not exist: ${path}"
    [[ ! -L "${path}" ]] || die "Backup directory must not be a symbolic link: ${path}"
    [[ -f "${path}/VERIFIED" ]] || die "Backup has no VERIFIED marker."
    [[ ! -L "${path}/VERIFIED" ]] || die "VERIFIED must not be a symbolic link."
    grep -qx 'Status: OK' "${path}/VERIFIED" \
        || die "VERIFIED marker does not contain 'Status: OK'."

    # These files are produced by the matching pve-config-backup script and
    # together form one complete configuration backup set.
    for critical_file in SHA256SUMS "${expected_payload[@]}"; do
        [[ -s "${path}/${critical_file}" ]] || die "${critical_file} missing or empty."
        [[ ! -L "${path}/${critical_file}" ]] || die "${critical_file} must not be a symbolic link."
        [[ -f "${path}/${critical_file}" ]] || die "${critical_file} must be a regular file."
    done

    checksum_manifest_paths_are_safe "${path}/SHA256SUMS" \
        || die "SHA256SUMS contains malformed or unsafe file names."

    for critical_file in "${expected_payload[@]}"; do
        checksum_lists_file "${path}/SHA256SUMS" "${critical_file}" \
            || die "SHA256SUMS does not contain ${critical_file}."
    done

    # Every check in this function must fail explicitly: it also runs inside
    # `begin_restore_session || { pause; return 0; }`, where Bash ignores `set -e`.
    (
        cd "${path}" && sha256sum -c SHA256SUMS
    ) || die "SHA-256 verification failed for ${path}."

    backup_node="$(awk -F': ' '$1 == "Node" {print $2; exit}' "${path}/backup-info.txt")"
    [[ -n "${backup_node}" ]] || die "Could not determine node from backup-info.txt."

    verified_node="$(awk -F': ' '$1 == "Node" {print $2; exit}' "${path}/VERIFIED")"
    [[ -n "${verified_node}" ]] || die "Could not determine node from VERIFIED marker."

    if [[ "${verified_node}" != "${backup_node}" ]]; then
        die "Backup metadata mismatch: backup-info.txt says '${backup_node}', VERIFIED says '${verified_node}'."
    fi

    if [[ "${backup_node}" != "${NODE}" ]]; then
        die "Backup belongs to node '${backup_node}', but current node is '${NODE}'."
    fi

    # Verify a private copy. This avoids relying on build-dependent SQLite URI
    # handling and guarantees that any transient SQLite helper files cannot
    # modify the selected backup directory or its retention mtime.
    db_result="$(verify_sqlite_backup_copy "${path}/config.db")" \
        || die "SQLite could not safely validate ${path}/config.db."
    [[ "${db_result}" == "ok" ]] || die "SQLite integrity check failed: ${db_result}"

    tar -tzf "${path}/etc-pve.tar.gz" >/dev/null \
        || die "etc-pve.tar.gz cannot be read completely."
    tar -tzf "${path}/etc-host.tar.gz" >/dev/null \
        || die "etc-host.tar.gz cannot be read completely."

    archive_paths_are_safe "${path}/etc-pve.tar.gz" \
        || die "etc-pve.tar.gz contains unsafe archive paths."
    archive_paths_are_safe "${path}/etc-host.tar.gz" \
        || die "etc-host.tar.gz contains unsafe archive paths."

    echo "Backup verification: OK"
}


verify_backup() {
    verify_backup_path "${BACKUP}"
}


select_backup() {
    local choice=""
    local i=0
    local info=""
    local -a backups=()

    mapfile -t backups < <(
        find "${BASE}" \
            -mindepth 1 \
            -maxdepth 1 \
            -type d \
            -name '????-??-??_??-??-??' \
            -exec test -f '{}/VERIFIED' ';' \
            -printf '%f\n' \
        | sort -r
    )

    ((${#backups[@]} > 0)) || die "No VERIFIED backups found in ${BASE}."

    echo
    echo "Available VERIFIED backups:"
    echo

    for i in "${!backups[@]}"; do
        info=""
        if [[ -f "${BASE}/${backups[$i]}/backup-info.txt" ]]; then
            info="$(grep -E '^(Node|Started):' "${BASE}/${backups[$i]}/backup-info.txt" | tr '\n' ' ' || true)"
        fi
        printf '  %2d) %s  %s\n' "$((i + 1))" "${backups[$i]}" "${info}"
    done

    echo
    while true; do
        read -r -p "Select backup number: " choice

        # Only 1 to 5 digits without a leading zero: Bash arithmetic reads a
        # leading 0 as octal ("010" is 8, "08" is an error).
        if [[ "${choice}" =~ ^[1-9][0-9]{0,4}$ ]] \
            && (( choice <= ${#backups[@]} )); then
            BACKUP="${BASE}/${backups[$((choice - 1))]}"
            break
        fi

        echo "Invalid selection."
    done
}


choose_backup() {
    select_backup
    verify_backup
}


pmxcfs_is_healthy() {
    systemctl is-active --quiet pve-cluster \
        && mountpoint -q /etc/pve \
        && [[ -d "/etc/pve/nodes/${NODE}" ]]
}


require_pmxcfs() {
    if ! systemctl is-active --quiet pve-cluster; then
        echo "pve-cluster is not active. Use the emergency config.db recovery option if pmxcfs is damaged." >&2
        pause
        return 1
    fi

    if ! mountpoint -q /etc/pve; then
        echo "/etc/pve is not mounted. Use the emergency config.db recovery option if pmxcfs is damaged." >&2
        pause
        return 1
    fi

    if [[ ! -d "/etc/pve/nodes/${NODE}" ]]; then
        echo "The local pmxcfs node directory is missing: /etc/pve/nodes/${NODE}" >&2
        echo "Use the emergency config.db recovery option if pmxcfs is damaged." >&2
        pause
        return 1
    fi

    return 0
}


pin_selected_backup() {
    [[ -n "${BACKUP}" ]] || die "No backup selected."

    local pinned=""

    verify_backup

    # This function runs inside `begin_restore_session || { pause; return 0; }`.
    # Bash ignores `set -e` there, so every step is checked explicitly. Without
    # these checks a failing mktemp left the path empty and the copy became
    # `cp -a -- "${BACKUP}/." "/"`.
    pinned="$(mktemp -d "${BASE}/.restore-selected.XXXXXX")" \
        || die "Could not create a protected copy directory below ${BASE}."

    case "${pinned}" in
        "${BASE}"/.restore-selected.??????) ;;
        *) die "Unexpected protected copy path: '${pinned}'" ;;
    esac

    [[ -d "${pinned}" && ! -L "${pinned}" ]] \
        || die "Protected copy path is not a directory: ${pinned}"

    # Only a validated path is handed to unpin_selected_backup (rm -rf).
    PINNED_BACKUP="${pinned}"

    cp -a -- "${BACKUP}/." "${PINNED_BACKUP}/" \
        || die "Could not copy the selected backup to ${PINNED_BACKUP}."

    # cp -a applies the mode and timestamps of the source directory to the
    # target directory, so the copy is restricted only after copying.
    chmod 700 "${PINNED_BACKUP}" \
        || die "Could not set permissions on ${PINNED_BACKUP}."

    RESTORE_BACKUP="${PINNED_BACKUP}"

    verify_backup_path "${RESTORE_BACKUP}"
}


suspend_backup_timer() {
    # unit_is_busy instead of `systemctl is-active`: a running Type=oneshot
    # backup is "activating", which is-active reports as not active.
    if unit_is_busy "${BACKUP_SERVICE}"; then
        echo "The automatic backup service is currently running (state: $(unit_active_state "${BACKUP_SERVICE}")). Wait for it to finish and retry." >&2
        return 1
    fi

    if systemctl is-active --quiet "${BACKUP_TIMER}"; then
        if ! systemctl stop "${BACKUP_TIMER}"; then
            echo "Could not temporarily stop ${BACKUP_TIMER}." >&2
            return 1
        fi
        BACKUP_TIMER_WAS_ACTIVE=1
        BACKUP_TIMER_SUSPENDED=1
    fi

    # Close the race between the first service check and stopping the timer.
    if unit_is_busy "${BACKUP_SERVICE}"; then
        echo "A backup started while the timer was being suspended. Wait for it to finish and retry." >&2
        return 1
    fi

    return 0
}


network_backup_pre_snapshot_preflight() {
    # RESTORE_BACKUP is the protected selected backup at this point. Exercise
    # the exact network extraction before the pre-restore snapshot/retention run
    # and reject link/special structures that C-26 intentionally does not restore.
    local archive="${RESTORE_BACKUP}/etc-host.tar.gz"
    local tmp=""
    local list_file=""
    local -a members=()
    local bad=""

    tmp="$(mktemp -d /run/pve-config-restore-netpreflight.XXXXXX)" || {
        echo "Network backup preflight could not create its temporary directory." >&2
        return 1
    }
    chmod 700 "${tmp}" || {
        echo "Network backup preflight could not restrict permissions on its temporary directory." >&2
        rm -rf -- "${tmp}"
        return 1
    }
    list_file="${tmp}/members.list"

    if ! tar -tzf "${archive}" \
        | awk '$0 == "etc/network/interfaces" \
            || $0 == "etc/network/interfaces.d" || $0 == "etc/network/interfaces.d/" || index($0, "etc/network/interfaces.d/") == 1 \
            || $0 == "usr/local/lib/systemd/network" || $0 == "usr/local/lib/systemd/network/" || index($0, "usr/local/lib/systemd/network/") == 1 { print }' \
        > "${list_file}"; then
        echo "Network backup preflight could not list ${archive}." >&2
        rm -rf -- "${tmp}"
        return 1
    fi
    if ! mapfile -t members < "${list_file}" || ((${#members[@]} == 0)); then
        echo "Network backup preflight found no restorable network members." >&2
        rm -rf -- "${tmp}"
        return 1
    fi

    if ! tar -xzf "${archive}" -C "${tmp}" --no-recursion -- "${members[@]}"; then
        echo "Network backup preflight could not safely extract the selected network members." >&2
        rm -rf -- "${tmp}"
        return 1
    fi

    if [[ ! -f "${tmp}/etc/network/interfaces" || -L "${tmp}/etc/network/interfaces" ]]; then
        echo "Network backup preflight refuses etc/network/interfaces unless it is a regular non-symlink file." >&2
        rm -rf -- "${tmp}"
        return 1
    fi
    if [[ -n "$(find "${tmp}/etc/network/interfaces" -type f -links +1 -print -quit 2>/dev/null || true)" ]]; then
        echo "Network backup preflight refuses a hard-linked interfaces file." >&2
        rm -rf -- "${tmp}"
        return 1
    fi

    for bad in "${tmp}/etc/network/interfaces.d" "${tmp}/usr/local/lib/systemd/network"; do
        [[ -e "${bad}" || -L "${bad}" ]] || continue
        if [[ ! -d "${bad}" || -L "${bad}" ]]; then
            echo "Network backup preflight refuses non-directory/symlink tree: ${bad#${tmp}/}" >&2
            rm -rf -- "${tmp}"
            return 1
        fi
        if [[ -n "$(find "${bad}" -type l -print -quit 2>/dev/null || true)" ]] \
            || [[ -n "$(find "${bad}" \( -type p -o -type b -o -type c -o -type s \) -print -quit 2>/dev/null || true)" ]] \
            || [[ -n "$(find "${bad}" -type f -links +1 -print -quit 2>/dev/null || true)" ]]; then
            echo "Network backup preflight refuses symlink, hardlink or special-file members below: ${bad#${tmp}/}" >&2
            rm -rf -- "${tmp}"
            return 1
        fi
    done

    if ! network_validation_source_tree_safe "${tmp}/etc/network" "etc/network"; then
        echo "Network backup preflight refuses parser inputs that escape the captured interfaces.d tree." >&2
        rm -rf -- "${tmp}"
        return 1
    fi

    rm -rf -- "${tmp}"
    return 0
}


pre_restore_snapshot() {
    echo
    echo "Creating a pre-restore configuration snapshot..."

    if [[ ! -x "${BACKUP_TOOL}" ]]; then
        echo "WARNING: ${BACKUP_TOOL} is not executable."
        confirm_word "Continue without a pre-restore snapshot?" "CONTINUE" \
            || return 1
        return 0
    fi

    # The backup run (and everything it starts) must not inherit restore,
    # backup, VM or Proxmox-network lock descriptors from this process.
    if "${BACKUP_TOOL}" 5>&- 6>&- 7>&- 8>&-; then
        echo "Pre-restore snapshot: OK"
        return 0
    fi

    echo
    echo "WARNING: The pre-restore snapshot failed."
    confirm_word "Continue anyway?" "CONTINUE" || return 1
}


restore_session_admission_allowed() {
    [[ "${RESTORE_RECOVERY_REQUIRED:-0}" == 0 ]] && return 0

    printf '%s\n' \
        "CRITICAL: Manual recovery is required. Further restores are blocked in this process." \
        "Inspect the preserved evidence and live configuration before starting a new recovery process." >&2 || true
    return 1
}


begin_restore_session() {
    # Stop the scheduled timer first. Then briefly take the backup lock while
    # pinning the selected backup so neither retention nor a manual backup can
    # remove it during the copy. An optional operation-specific preflight runs
    # against that protected copy before the pre-restore snapshot/retention run.
    local pre_snapshot_hook="${1:-}"

    # Refuse before timer handling, backup pinning, hooks or a new snapshot.
    restore_session_admission_allowed || return 1

    if ! suspend_backup_timer; then
        resume_backup_timer
        return 1
    fi

    if ! acquire_backup_lock; then
        resume_backup_timer
        return 1
    fi

    pin_selected_backup
    release_backup_lock

    if [[ -n "${pre_snapshot_hook}" ]] && ! "${pre_snapshot_hook}"; then
        unpin_selected_backup
        resume_backup_timer
        return 1
    fi

    # The normal backup tool needs the same lock, so create the pre-restore
    # snapshot before taking the lock for the actual restore operation.
    if ! pre_restore_snapshot; then
        unpin_selected_backup
        resume_backup_timer
        return 1
    fi

    # Close the race with manually started backups before changing files.
    if ! acquire_backup_lock; then
        unpin_selected_backup
        resume_backup_timer
        return 1
    fi

    RESTORE_SESSION_ACTIVE=1
    critical_section_begin
    log_event notice "restore session started: ${FUNCNAME[1]:-unknown} from ${BACKUP}"
    return 0
}


end_restore_session() {
    RESTORE_SESSION_ACTIVE=0
    release_vm_config_lock
    release_pve_network_config_lock
    unpin_selected_backup
    release_backup_lock
    resume_backup_timer
    cleanup_workdir
    critical_section_end
    log_event notice "restore session ended: ${FUNCNAME[1]:-unknown}"
}


end_restore_session_keep_timer_stopped() {
    RESTORE_RECOVERY_REQUIRED=1
    echo "pve-cluster state: $(unit_active_state pve-cluster). Inspect it with: journalctl -b -u pve-cluster" >&2
    if (( PVE_CLUSTER_RUNTIME_MASKED_BY_TOOL == 1 )); then
        echo "pve-cluster is still runtime-masked by this session. Remove the mask with: systemctl unmask --runtime pve-cluster" >&2
    fi
    if (( BACKUP_TIMER_WAS_ACTIVE == 1 )); then
        echo "After recovery, restart the backup timer with: systemctl start ${BACKUP_TIMER}" >&2
    fi
    log_event crit "pmxcfs could not be returned to a healthy state (pve-cluster: $(unit_active_state pve-cluster)); backup timer left stopped"

    RESTORE_SESSION_ACTIVE=0
    release_vm_config_lock
    release_pve_network_config_lock
    unpin_selected_backup
    release_backup_lock

    # Do not restart the timer. Clear state only so the EXIT trap does not
    # attempt to restart it later.
    BACKUP_TIMER_SUSPENDED=0
    BACKUP_TIMER_WAS_ACTIVE=0

    cleanup_workdir
    critical_section_end
}


end_restore_session_critical() {
    local message="${1:-Critical rollback validation failed.}"

    # Latch before diagnostics or cleanup can fail, and before tx_reset runs.
    RESTORE_RECOVERY_REQUIRED=1
    log_event crit "CRITICAL: ${message}"
    echo >&2
    echo "CRITICAL: ${message}" >&2
    echo "The automatic backup timer stays stopped for safety." >&2
    echo "Note: an enabled timer starts again automatically after the next reboot." >&2
    if (( PVE_CLUSTER_RUNTIME_MASKED_BY_TOOL == 1 )); then
        echo "pve-cluster is runtime-masked by this recovery session until it is explicitly unmasked or the host reboots." >&2
        echo "After manual verification of config.db: systemctl unmask --runtime pve-cluster" >&2
    fi

    RESTORE_SESSION_ACTIVE=0
    release_vm_config_lock
    release_pve_network_config_lock
    unpin_selected_backup
    release_backup_lock

    # Keep the timer stopped and prevent the EXIT trap from restarting it.
    BACKUP_TIMER_SUSPENDED=0
    BACKUP_TIMER_WAS_ACTIVE=0

    preserve_workdir_after_unexpected_failure || \
        echo "WARNING: Could not preserve the rollback work directory." >&2

    echo "After manual verification/recovery, restart it with:" >&2
    echo "  systemctl start ${BACKUP_TIMER}" >&2

    critical_section_end
}


mask_pve_cluster_runtime_for_db_change() {
    # A status check immediately before mv still has a TOCTOU window. A
    # temporary systemd mask prevents normal/manual/dependency-based systemd
    # activation for the whole database-change window. --runtime means the
    # mask itself is not persistent across a reboot.
    if (( PVE_CLUSTER_RUNTIME_MASKED_BY_TOOL == 0 )); then
        if ! systemctl mask --runtime pve-cluster >/dev/null 2>&1; then
            return 1
        fi
        PVE_CLUSTER_RUNTIME_MASKED_BY_TOOL=1
    fi

    # The mask only works if no unit file with higher priority (for example a
    # full copy in /etc/systemd/system) shadows the runtime mask in /run.
    if [[ "$(systemctl is-enabled pve-cluster 2>/dev/null || true)" != "masked-runtime" ]]; then
        return 1
    fi

    # A start job could already have been in flight before the mask was
    # installed. Stop unconditionally under the mask: `systemctl is-active`
    # reports "activating", "deactivating" and the auto-restart phase of
    # Restart=on-failure as not active, although pmxcfs may already have
    # opened config.db. Stopping an inactive unit is a no-op.
    systemctl stop pve-cluster >/dev/null 2>&1 || return 1

    # Stopped means: unit inactive or failed, no /etc/pve mount and no pmxcfs
    # process (this also covers a pmxcfs started outside systemd).
    pve_cluster_fully_stopped
}


unmask_pve_cluster_runtime_for_start() {
    if (( PVE_CLUSTER_RUNTIME_MASKED_BY_TOOL == 1 )); then
        if ! systemctl unmask --runtime pve-cluster >/dev/null 2>&1; then
            return 1
        fi
        PVE_CLUSTER_RUNTIME_MASKED_BY_TOOL=0
    fi

    return 0
}


start_pmxcfs_and_validate() {
    local i=0

    unmask_pve_cluster_runtime_for_start || return 1

    # A database that makes pmxcfs exit is retried by Restart=on-failure until
    # the start rate limit is hit. systemd then also refuses manual starts
    # until the interval has passed; the rollback start failed because of
    # that. reset-failed flushes the rate counter.
    systemctl reset-failed pve-cluster >/dev/null 2>&1 || true

    if ! systemctl start pve-cluster; then
        return 1
    fi

    for i in {1..10}; do
        if systemctl is-active --quiet pve-cluster \
            && mountpoint -q /etc/pve \
            && [[ -d "/etc/pve/nodes/${NODE}" ]]; then
            return 0
        fi
        sleep 1
    done

    return 1
}


write_pmxcfs_file_atomic() {
    local source="$1"
    local destination="$2"
    local tmp="${destination}.tmp.${BASHPID}"

    # Same pattern as PVE's own file_set_contents: write a temporary file in
    # the same directory, then rename. A direct `cat > file` truncates first;
    # daemons that re-read the file (e.g. pve-firewall) can see an empty or
    # partial file in between.
    [[ -f "${source}" ]] || { echo "Source file missing: ${source}" >&2; return 1; }
    mkdir -p "$(dirname "${destination}")" || return 1

    if ! cat "${source}" > "${tmp}"; then
        rm -f -- "${tmp}"
        return 1
    fi

    if ! mv -f -- "${tmp}" "${destination}"; then
        rm -f -- "${tmp}"
        return 1
    fi

    return 0
}


storage_tx_locked_operation() {
    # Execute the storage.cfg linearization point under Proxmox's own cfs lock.
    # Actions:
    #   context  - prove the current /etc/pve pmxcfs context only
    #   assert   - prove LIVE == expected under the storage.cfg lock
    #   apply    - atomically check PREVIOUS and write TARGET under one lock
    #   rollback - atomically check ownership and restore PREVIOUS under one lock
    #
    # Return codes are internal to the transaction layer:
    #   0  requested operation/postcondition succeeded
    #   70 Proxmox storage lock could not be acquired/executed
    #   71 pmxcfs context is not healthy/current
    #   72 LIVE does not match the required transaction-owned state
    #   73 source/descriptor admission failed
    #   74 write failed/no desired transition became live
    #   75 write reported failure after desired state became live
    #   76 post-write state is neither expected nor desired
    #   77 pmxcfs context changed after an attempted live mutation
    #   78 absence of this operation's temporary artifact could not be proved
    local action="$1"
    local source="$2"
    local expected_descriptor="$3"
    local desired_descriptor="$4"
    local messages="$5"

    : > "${messages}" || return 1

    perl -MPVE::Storage -MPVE::Cluster -MDigest::SHA -MFcntl=O_RDONLY,O_WRONLY,O_CREAT,O_EXCL,S_ISREG -e '
        use strict;
        use warnings;
        use Errno qw(ENOENT EEXIST);

        my ($action, $source, $expected_file, $desired_file, $node) = @ARGV;
        my $status = 70;
        my $temp_cleanup_pending = 0;
        my $temp_cleanup_uncertain = 0;

        sub read_descriptor {
            my ($path) = @_;
            return undef if !defined($path) || $path eq q{-};
            open(my $fh, q{<}, $path) or return undef;
            my $line = <$fh>;
            my $extra = <$fh>;
            close($fh);
            return undef if !defined($line) || defined($extra);
            chomp($line);
            return $line if $line eq q{ABSENT};
            return $line if $line =~ /^FILE\t[0-9a-f]{64}$/;
            return undef;
        }

        sub file_state {
            my ($path) = @_;
            return q{ABSENT} if !-e $path && !-l $path;
            return undef if -l $path || !-f $path;

            open(my $fh, q{<}, $path) or return undef;
            binmode($fh);
            my $sha = Digest::SHA->new(256);
            eval { $sha->addfile($fh); 1 } or do { close($fh); return undef; };
            close($fh) or return undef;
            return q{FILE} . "\t" . $sha->hexdigest;
        }

        sub current_pmxcfs_mount_id {
            open(my $fh, q{<}, q{/proc/self/mountinfo}) or return undef;
            my $mount_id;
            while (my $line = <$fh>) {
                chomp($line);
                my ($pre, $post) = split(/ - /, $line, 2);
                next if !defined($post);
                my @pre = split(/ /, $pre);
                next if @pre < 5 || $pre[4] ne q{/etc/pve};
                my ($fstype) = split(/ /, $post, 2);
                next if !defined($fstype) || $fstype !~ /^fuse(?:\.|$)/;
                $mount_id = $pre[0];
                last;
            }
            close($fh);
            return $mount_id;
        }

        sub fd_mount_id {
            my ($fd) = @_;
            open(my $fh, q{<}, "/proc/self/fdinfo/$fd") or return undef;
            my $mount_id;
            while (my $line = <$fh>) {
                if ($line =~ /^mnt_id:\s*(\d+)\s*$/) {
                    $mount_id = $1;
                    last;
                }
            }
            close($fh);
            return $mount_id;
        }

        sub context_current {
            my ($fdroot, $fd, $node_name) = @_;

            eval { PVE::Cluster::cfs_update(1); 1 } or return 0;
            return 0 if !PVE::Cluster::check_cfs_is_mounted(1);

            my $live_mount_id = current_pmxcfs_mount_id();
            my $pinned_mount_id = fd_mount_id($fd);
            return 0 if !defined($live_mount_id) || !defined($pinned_mount_id);
            return 0 if $live_mount_id ne $pinned_mount_id;

            my @live = stat(q{/etc/pve});
            my @pinned = stat($fdroot);
            return 0 if !@live || !@pinned;
            return 0 if $live[0] != $pinned[0] || $live[1] != $pinned[1];
            return 0 if !-d "$fdroot/nodes/$node_name";
            my $local_target = readlink("$fdroot/local");
            return 0 if !defined($local_target) || $local_target ne "nodes/$node_name";
            return 1;
        }

        sub copy_file_atomic_pinned {
            my ($src, $fdroot) = @_;
            my $dest = "$fdroot/storage.cfg";
            my ($in, $out, $tmp);
            my @owned;
            my $created = 0;

            # Keep the obligation outside the eval: a callback exception must
            # not turn a partially created temporary file into a clean abort.
            my $write_ok = eval {
                for my $attempt (1..20) {
                    $tmp = "$fdroot/storage.cfg.tmp.$$.$attempt";
                    $temp_cleanup_pending = 1;
                    if (sysopen($out, $tmp, O_WRONLY|O_CREAT|O_EXCL, 0600)) {
                        @owned = stat($out);
                        die "cannot identify owned storage temporary file: $!\n" if !@owned;
                        $created = 1;
                        last;
                    }
                    my $open_errno = 0 + $!;
                    if ($open_errno == EEXIST && (!defined($out) || !defined(fileno($out)))) {
                        # O_EXCL refused a pre-existing object: it is not ours.
                        $temp_cleanup_pending = 0;
                        undef $out;
                        next;
                    }
                    @owned = stat($out) if defined($out) && defined(fileno($out));
                    die "cannot create storage temporary file: $open_errno\n";
                }
                die "no free storage temporary filename\n" if !$created;

                open($in, q{<}, $src) or die "open storage source failed: $!\n";
                binmode($in);
                binmode($out);

                my $buf;
                while (1) {
                    my $n = sysread($in, $buf, 65536);
                    die "read storage source failed: $!\n" if !defined($n);
                    last if $n == 0;
                    my $off = 0;
                    while ($off < $n) {
                        my $w = syswrite($out, $buf, $n - $off, $off);
                        die "write storage temporary file failed: $!\n" if !defined($w) || $w == 0;
                        $off += $w;
                    }
                }

                close($in) or die "close storage source failed: $!\n";
                undef $in;
                close($out) or die "close storage temporary file failed: $!\n";
                undef $out;
                rename($tmp, $dest) or die "rename storage temporary file failed: $!\n";
                1;
            };
            my $write_error = $@;

            # This runs while the callback still holds the domain lock and its
            # directory FD is alive. Never delete an existing collision or a
            # replacement object whose device/inode/type is not our own.
            eval { close($in) if defined($in) && defined(fileno($in)); 1; };
            eval { close($out) if defined($out) && defined(fileno($out)); 1; };
            if ($temp_cleanup_pending) {
                my @current = lstat($tmp);
                if (!@current && $! == ENOENT) {
                    $temp_cleanup_pending = 0;
                } elsif (@current && @owned && S_ISREG($current[2])
                    && $current[0] == $owned[0] && $current[1] == $owned[1]) {
                    # Absence, not unlink rc alone, is the cleanup postcondition.
                    unlink($tmp);
                    my @after = lstat($tmp);
                    $temp_cleanup_pending = 0 if !@after && $! == ENOENT;
                }
            }
            if ($temp_cleanup_pending) {
                $temp_cleanup_uncertain = 1;
                print STDERR "storage temporary cleanup unproven: $tmp (pinned /etc/pve)\n";
            }
            print STDERR $write_error if !$write_ok && $write_error;
            return $write_ok && !$temp_cleanup_uncertain ? 1 : 0;
        }

        sub remove_file_pinned {
            my ($fdroot) = @_;
            my $dest = "$fdroot/storage.cfg";
            return 1 if !-e $dest && !-l $dest;
            return unlink($dest) ? 1 : ($! == ENOENT ? 1 : 0);
        }

        my $lock_ok = eval {
            PVE::Storage::lock_storage_config(sub {
                my $expected = read_descriptor($expected_file);
                my $desired = read_descriptor($desired_file);

                if ($action ne q{context} && !defined($expected)) {
                    $status = 73;
                    return;
                }
                if (($action eq q{apply} || $action eq q{rollback}) && !defined($desired)) {
                    $status = 73;
                    return;
                }

                sysopen(my $dirfh, q{/etc/pve}, O_RDONLY) or do { $status = 71; return; };
                my $dirfd = fileno($dirfh);
                my $fdroot = q{/proc/self/fd/} . $dirfd;
                if (!-d $fdroot || !context_current($fdroot, $dirfd, $node)) {
                    $status = 71;
                    return;
                }

                if ($action eq q{context}) {
                    $status = 0;
                    return;
                }

                my $live_path = "$fdroot/storage.cfg";
                my $current = file_state($live_path);
                if (!defined($current)) {
                    $status = 76;
                    return;
                }

                if ($action eq q{assert}) {
                    if ($current ne $expected) {
                        $status = 72;
                        return;
                    }
                    $status = context_current($fdroot, $dirfd, $node) ? 0 : 71;
                    return;
                }

                if ($action eq q{rollback} && $current eq $desired) {
                    $status = context_current($fdroot, $dirfd, $node) ? 0 : 71;
                    return;
                }

                if ($current ne $expected) {
                    $status = 72;
                    return;
                }

                if ($desired =~ /^FILE\t/) {
                    my $source_state = file_state($source);
                    if (!defined($source_state) || $source_state ne $desired) {
                        $status = 73;
                        return;
                    }
                } elsif ($desired ne q{ABSENT}) {
                    $status = 73;
                    return;
                }

                # Re-prove the current mounted pmxcfs context after all admission
                # work and immediately before the write. All file operations below
                # use the pinned /etc/pve directory descriptor, so an unmount cannot
                # redirect them into the underlying local /etc/pve directory.
                if (!context_current($fdroot, $dirfd, $node)) {
                    $status = 71;
                    return;
                }

                # PREVIOUS ownership, staged source identity and the current
                # pmxcfs context were admitted under this same domain lock.
                # Equal states need no write; Bash must still validate TARGET
                # and pass its final locked identity gate before committing.
                if ($current eq $desired) {
                    $status = 0;
                    return;
                }

                my $write_ok = $desired eq q{ABSENT}
                    ? remove_file_pinned($fdroot)
                    : copy_file_atomic_pinned($source, $fdroot);

                if ($temp_cleanup_pending || $temp_cleanup_uncertain) {
                    $status = 78;
                    return;
                }

                my $after = file_state($live_path);
                if (!context_current($fdroot, $dirfd, $node)) {
                    $status = 77;
                    return;
                }
                if (!defined($after)) {
                    $status = 76;
                    return;
                }

                if ($after eq $desired) {
                    $status = $write_ok ? 0 : 75;
                    return;
                }
                if ($after eq $expected) {
                    $status = 74;
                    return;
                }
                $status = 76;
                return;
            }, q{storage.cfg transaction lock failed});
            1;
        };

        if (!$lock_ok) {
            my $err = $@ || q{unknown storage lock failure};
            print STDERR $err;
            if ($temp_cleanup_pending || $temp_cleanup_uncertain) {
                print STDERR "storage callback failed with unresolved temporary cleanup\n";
                exit 78;
            }
            exit 70;
        }

        exit 78 if $temp_cleanup_pending || $temp_cleanup_uncertain;
        exit $status;
    ' "${action}" "${source}" "${expected_descriptor}" "${desired_descriptor}" "${NODE}" \
        >/dev/null 2>"${messages}"
}


storage_tx_locked_context_gate() {
    local messages="${WORKDIR}/storage.lock-context.err"
    storage_tx_locked_operation context - - - "${messages}"
}


storage_tx_locked_assert_descriptor() {
    local descriptor="$1"
    local messages="${WORKDIR}/storage.lock-assert.err"
    storage_tx_locked_operation assert - "${descriptor}" - "${messages}"
}


storage_tx_locked_apply() {
    local target="$1"
    local messages="${WORKDIR}/storage.lock-apply.err"
    storage_tx_locked_operation apply "${target}" \
        "${TX_PREVIOUS_DESCRIPTOR}" "${TX_TARGET_DESCRIPTOR}" "${messages}"
}


storage_tx_locked_rollback() {
    local messages="${WORKDIR}/storage.lock-rollback.err"
    storage_tx_locked_operation rollback "${TX_PREVIOUS_COPY}" \
        "${TX_EXPECTED_DESCRIPTOR}" "${TX_PREVIOUS_DESCRIPTOR}" "${messages}"
}


vm_tx_prevalidate_candidate() {
    # Strict staged parser gate. qemu-server keeps the parser in
    # PVE::QemuServer, while PVE::QemuConfig supplies the config/lock wrapper.
    # Any diagnostics are rejected before a live VM configuration is touched.
    local candidate="$1"
    local vmid="$2"
    local messages="$3"
    local rc=0

    : > "${messages}" || return 1
    [[ -f "${candidate}" && ! -L "${candidate}" ]] || return 64
    [[ "${vmid}" =~ ^[1-9][0-9]{0,8}$ ]] || return 64

    if perl -MPVE::QemuServer -e '
        use strict;
        use warnings;
        my ($candidate, $node, $vmid) = @ARGV;
        die "PVE::QemuServer::parse_vm_config is unavailable\n"
            if !PVE::QemuServer->can(q{parse_vm_config});
        die "invalid node name for staged VM parser\n"
            if !defined($node) || $node !~ /^[A-Za-z0-9][A-Za-z0-9._-]*$/;
        open(my $fh, q{<}, $candidate) or die "open staged VM config failed: $!\n";
        local $/;
        my $raw = <$fh>;
        close($fh) or die "close staged VM config failed: $!\n";
        die "staged VM config could not be read\n" if !defined($raw);
        my $synthetic = "nodes/$node/qemu-server/$vmid.conf";
        my $conf = PVE::QemuServer::parse_vm_config($synthetic, $raw, 1);
        die "strict VM parser returned no configuration\n" if !defined($conf);
    ' "${candidate}" "${NODE}" "${vmid}" 7>&- 8>&- >/dev/null 2>"${messages}"; then
        rc=0
    else
        rc=$?
    fi

    (( rc == 0 )) || return "${rc}"
    [[ ! -s "${messages}" ]] || return 2
    return 0
}


vm_tx_pinned_operation() {
    # VM_CONFIG_LOCK_HELD proves that the outer restore process owns the same
    # exclusive flock used by PVE::QemuConfig->lock_config(). The Perl helper
    # below performs the pmxcfs context/descriptor/write operation while that
    # lock remains held. It pins /etc/pve through a directory FD, mirroring the
    # Storage pilot's protection against writes into an unmounted local path.
    #
    # Return codes mirror the Storage transaction adapter where practical:
    #   0  requested operation/postcondition succeeded
    #   70 required VM lock/helper invocation is unavailable
    #   71 pmxcfs context is not healthy/current
    #   72 LIVE does not match required transaction-owned state
    #   73 source/descriptor/path admission failed
    #   74 write failed/no desired transition became live
    #   75 write reported failure after desired state became live
    #   76 post-write state is neither expected nor desired
    #   77 pmxcfs context changed after attempted live mutation
    #   78 absence of this operation's temporary artifact could not be proved
    local action="$1"
    local source="$2"
    local expected_descriptor="$3"
    local desired_descriptor="$4"
    local messages="$5"
    local vmid="${TX_DOMAIN_ID}"
    local expected_live=""
    local lock_fd_target=""
    local rc=0

    : > "${messages}" || return 1

    [[ "${TX_DOMAIN}" == "vm" ]] || {
        echo "VM transaction helper called outside the VM domain." > "${messages}"
        return 70
    }
    [[ "${vmid}" =~ ^[1-9][0-9]{0,8}$ ]] || {
        echo "VM transaction has no valid VMID." > "${messages}"
        return 73
    }
    (( VM_CONFIG_LOCK_HELD == 1 )) || {
        echo "Required Proxmox VM configuration lock is not held." > "${messages}"
        return 70
    }

    expected_live="/etc/pve/nodes/${NODE}/qemu-server/${vmid}.conf"
    [[ "${TX_LIVE_PATH}" == "${expected_live}" ]] || {
        echo "Unexpected VM live path for transaction: ${TX_LIVE_PATH}" > "${messages}"
        return 73
    }

    [[ -n "${VM_CONFIG_LOCK_PATH}" ]] || {
        echo "VM transaction has no resolved native Proxmox lock path." > "${messages}"
        return 70
    }
    lock_fd_target="$(readlink "/proc/${BASHPID}/fd/6" 2>/dev/null || true)"
    [[ "${lock_fd_target}" == "${VM_CONFIG_LOCK_PATH}" ]] || {
        echo "VM lock file descriptor does not reference the resolved native Proxmox lock file." > "${messages}"
        return 70
    }

    if perl -MPVE::Cluster -MDigest::SHA -MFcntl=O_RDONLY,O_WRONLY,O_CREAT,O_EXCL,S_ISREG -e '
        use strict;
        use warnings;
        use Errno qw(ENOENT EEXIST);

        my ($action, $source, $expected_file, $desired_file, $node, $vmid) = @ARGV;
        my $status = 70;
        my $temp_cleanup_pending = 0;
        my $temp_cleanup_uncertain = 0;

        sub read_descriptor {
            my ($path) = @_;
            return undef if !defined($path) || $path eq q{-};
            open(my $fh, q{<}, $path) or return undef;
            my $line = <$fh>;
            my $extra = <$fh>;
            close($fh);
            return undef if !defined($line) || defined($extra);
            chomp($line);
            return $line if $line eq q{ABSENT};
            return $line if $line =~ /^FILE\t[0-9a-f]{64}$/;
            return undef;
        }

        sub file_state {
            my ($path) = @_;
            return q{ABSENT} if !-e $path && !-l $path;
            return undef if -l $path || !-f $path;
            open(my $fh, q{<}, $path) or return undef;
            binmode($fh);
            my $sha = Digest::SHA->new(256);
            eval { $sha->addfile($fh); 1 } or do { close($fh); return undef; };
            close($fh) or return undef;
            return q{FILE} . "\t" . $sha->hexdigest;
        }

        sub current_pmxcfs_mount_id {
            open(my $fh, q{<}, q{/proc/self/mountinfo}) or return undef;
            my $mount_id;
            while (my $line = <$fh>) {
                chomp($line);
                my ($pre, $post) = split(/ - /, $line, 2);
                next if !defined($post);
                my @pre = split(/ /, $pre);
                next if @pre < 5 || $pre[4] ne q{/etc/pve};
                my ($fstype) = split(/ /, $post, 2);
                next if !defined($fstype) || $fstype !~ /^fuse(?:\.|$)/;
                $mount_id = $pre[0];
                last;
            }
            close($fh);
            return $mount_id;
        }

        sub fd_mount_id {
            my ($fd) = @_;
            open(my $fh, q{<}, "/proc/self/fdinfo/$fd") or return undef;
            my $mount_id;
            while (my $line = <$fh>) {
                if ($line =~ /^mnt_id:\s*(\d+)\s*$/) {
                    $mount_id = $1;
                    last;
                }
            }
            close($fh);
            return $mount_id;
        }

        sub context_current {
            my ($fdroot, $fd, $node_name) = @_;
            eval { PVE::Cluster::cfs_update(1); 1 } or return 0;
            return 0 if !PVE::Cluster::check_cfs_is_mounted(1);
            my $live_mount_id = current_pmxcfs_mount_id();
            my $pinned_mount_id = fd_mount_id($fd);
            return 0 if !defined($live_mount_id) || !defined($pinned_mount_id);
            return 0 if $live_mount_id ne $pinned_mount_id;
            my @live = stat(q{/etc/pve});
            my @pinned = stat($fdroot);
            return 0 if !@live || !@pinned;
            return 0 if $live[0] != $pinned[0] || $live[1] != $pinned[1];
            return 0 if -e q{/etc/corosync/corosync.conf} || -l q{/etc/corosync/corosync.conf};
            return 0 if -e "$fdroot/corosync.conf" || -l "$fdroot/corosync.conf";
            return 0 if !-d "$fdroot/nodes/$node_name/qemu-server";
            my $local_target = readlink("$fdroot/local");
            return 0 if !defined($local_target) || $local_target ne "nodes/$node_name";
            return 1;
        }

        sub copy_file_atomic_pinned {
            my ($src, $dir, $vmid_value) = @_;
            my $dest = "$dir/$vmid_value.conf";
            my ($in, $out, $tmp);
            my @owned;
            my $created = 0;

            my $write_ok = eval {
                for my $attempt (1..20) {
                    $tmp = "$dir/$vmid_value.conf.tmp.$$.$attempt";
                    $temp_cleanup_pending = 1;
                    if (sysopen($out, $tmp, O_WRONLY|O_CREAT|O_EXCL, 0600)) {
                        @owned = stat($out);
                        die "cannot identify owned VM temporary file: $!\n" if !@owned;
                        $created = 1;
                        last;
                    }
                    my $open_errno = 0 + $!;
                    if ($open_errno == EEXIST && (!defined($out) || !defined(fileno($out)))) {
                        $temp_cleanup_pending = 0;
                        undef $out;
                        next;
                    }
                    @owned = stat($out) if defined($out) && defined(fileno($out));
                    die "cannot create VM temporary file: $open_errno\n";
                }
                die "no free VM temporary filename\n" if !$created;

                open($in, q{<}, $src) or die "open VM source failed: $!\n";
                binmode($in);
                binmode($out);
                my $buf;
                while (1) {
                    my $n = sysread($in, $buf, 65536);
                    die "read VM source failed: $!\n" if !defined($n);
                    last if $n == 0;
                    my $off = 0;
                    while ($off < $n) {
                        my $w = syswrite($out, $buf, $n - $off, $off);
                        die "write VM temporary file failed: $!\n" if !defined($w) || $w == 0;
                        $off += $w;
                    }
                }

                close($in) or die "close VM source failed: $!\n";
                undef $in;
                close($out) or die "close VM temporary file failed: $!\n";
                undef $out;
                rename($tmp, $dest) or die "rename VM temporary file failed: $!\n";
                1;
            };
            my $write_error = $@;

            eval { close($in) if defined($in) && defined(fileno($in)); 1; };
            eval { close($out) if defined($out) && defined(fileno($out)); 1; };
            if ($temp_cleanup_pending) {
                my @current = lstat($tmp);
                if (!@current && $! == ENOENT) {
                    $temp_cleanup_pending = 0;
                } elsif (@current && @owned && S_ISREG($current[2])
                    && $current[0] == $owned[0] && $current[1] == $owned[1]) {
                    unlink($tmp);
                    my @after = lstat($tmp);
                    $temp_cleanup_pending = 0 if !@after && $! == ENOENT;
                }
            }
            if ($temp_cleanup_pending) {
                $temp_cleanup_uncertain = 1;
                print STDERR "VM temporary cleanup unproven: $tmp (pinned /etc/pve)\n";
            }
            print STDERR $write_error if !$write_ok && $write_error;
            return $write_ok && !$temp_cleanup_uncertain ? 1 : 0;
        }

        sub remove_file_pinned {
            my ($dest) = @_;
            return 1 if !-e $dest && !-l $dest;
            return unlink($dest) ? 1 : ($! == ENOENT ? 1 : 0);
        }

        my $expected = read_descriptor($expected_file);
        my $desired = read_descriptor($desired_file);
        if ($action ne q{context} && !defined($expected)) {
            exit 73;
        }
        if (($action eq q{apply} || $action eq q{rollback}) && !defined($desired)) {
            exit 73;
        }

        sysopen(my $dirfh, q{/etc/pve}, O_RDONLY) or exit 71;
        my $dirfd = fileno($dirfh);
        my $fdroot = q{/proc/self/fd/} . $dirfd;
        if (!-d $fdroot || !context_current($fdroot, $dirfd, $node)) {
            exit 71;
        }

        if ($action eq q{context}) {
            exit 0;
        }

        my $dir = "$fdroot/nodes/$node/qemu-server";
        my $live_path = "$dir/$vmid.conf";
        my $current = file_state($live_path);
        exit 76 if !defined($current);

        if ($action eq q{assert}) {
            exit 72 if $current ne $expected;
            exit(context_current($fdroot, $dirfd, $node) ? 0 : 71);
        }

        if ($action eq q{rollback} && $current eq $desired) {
            exit(context_current($fdroot, $dirfd, $node) ? 0 : 71);
        }
        exit 72 if $current ne $expected;

        if ($desired =~ /^FILE\t/) {
            my $source_state = file_state($source);
            exit 73 if !defined($source_state) || $source_state ne $desired;
        } elsif ($desired ne q{ABSENT}) {
            exit 73;
        }

        exit 71 if !context_current($fdroot, $dirfd, $node);
        exit 0 if $current eq $desired;

        my $write_ok = $desired eq q{ABSENT}
            ? remove_file_pinned($live_path)
            : copy_file_atomic_pinned($source, $dir, $vmid);

        exit 78 if $temp_cleanup_pending || $temp_cleanup_uncertain;

        my $after = file_state($live_path);
        exit 77 if !context_current($fdroot, $dirfd, $node);
        exit 76 if !defined($after);
        exit($write_ok ? 0 : 75) if $after eq $desired;
        exit 74 if $after eq $expected;
        exit 76;
    ' "${action}" "${source}" "${expected_descriptor}" "${desired_descriptor}" \
        "${NODE}" "${vmid}" 7>&- 8>&- >/dev/null 2>"${messages}"; then
        rc=0
    else
        rc=$?
    fi

    (( rc == 0 )) || return "${rc}"
    [[ ! -s "${messages}" ]] || return 70
    return 0
}


vm_tx_assert_descriptor() {
    local descriptor="$1"
    local messages="${WORKDIR}/vm.lock-assert.err"
    vm_tx_pinned_operation assert - "${descriptor}" - "${messages}"
}


vm_tx_apply() {
    local target="$1"
    local messages="${WORKDIR}/vm.lock-apply.err"
    vm_tx_pinned_operation apply "${target}" \
        "${TX_PREVIOUS_DESCRIPTOR}" "${TX_TARGET_DESCRIPTOR}" "${messages}"
}


vm_tx_rollback() {
    local messages="${WORKDIR}/vm.lock-rollback.err"
    vm_tx_pinned_operation rollback "${TX_PREVIOUS_COPY}" \
        "${TX_EXPECTED_DESCRIPTOR}" "${TX_PREVIOUS_DESCRIPTOR}" "${messages}"
}


vm_tx_validate_live() {
    # No user prompt is allowed after mutation. RC0 plus any stderr diagnostic is
    # therefore a validation failure. Cross-guest VMID conflicts and an out-of-
    # band QEMU process are also treated as domain validation failures.
    local phase="$1"
    local messages="$2"
    local vmid="${TX_DOMAIN_ID}"
    local previous_state=""
    local status=""
    local conflicts=""
    local rc=0

    : > "${messages}" || return 1
    [[ "${vmid}" =~ ^[1-9][0-9]{0,8}$ ]] || return 64
    (( VM_CONFIG_LOCK_HELD == 1 )) || {
        printf '%s\n' "required Proxmox VM configuration lock is not held" > "${messages}"
        return 70
    }

    conflicts="$(current_vmid_conflicts "${vmid}" "${TX_LIVE_PATH}")"
    if [[ -n "${conflicts}" ]]; then
        printf '%s\n%s\n' \
            "VMID ${vmid} conflicts with another guest configuration:" \
            "${conflicts}" > "${messages}"
        return 2
    fi

    if vm_qemu_process_guard "${vmid}" "${messages}"; then
        :
    else
        rc=$?
        (( rc == 10 )) && return 2
        return "${rc}"
    fi

    if [[ "${phase}" == "rollback" || "${phase}" == "previous" ]]; then
        previous_state="$(cat -- "${TX_PREVIOUS_DESCRIPTOR}")" || return 64
        if [[ "${previous_state}" == "ABSENT" ]]; then
            return 0
        fi
    fi

    if status="$(qm status "${vmid}" 7>&- 8>&- 2>>"${messages}" | awk '{print $2}')"; then
        :
    else
        rc=$?
        return "${rc:-1}"
    fi

    if [[ "${status}" != "stopped" ]]; then
        printf '%s\n' "VM ${vmid} status is not exactly stopped (observed: ${status:-unknown})" >> "${messages}"
        return 2
    fi

    if qm config "${vmid}" 7>&- 8>&- >/dev/null 2>>"${messages}"; then
        rc=0
    else
        rc=$?
    fi
    (( rc == 0 )) || return "${rc}"
    [[ ! -s "${messages}" ]] || return 2
    return 0
}


tx_domain_live_matches_descriptor() {
    local descriptor="$1"

    case "${TX_DOMAIN}" in
        storage) storage_tx_locked_assert_descriptor "${descriptor}" ;;
        vm) vm_tx_assert_descriptor "${descriptor}" ;;
        *) tx_pmxcfs_file_matches_descriptor "${TX_LIVE_PATH}" "${descriptor}" ;;
    esac
}

tx_reset() {
    TX_ACTIVE=0
    TX_DOMAIN=""
    TX_DOMAIN_ID=""
    TX_STATE="IDLE"
    TX_MUTATION_STARTED=0
    TX_TEMP_CLEANUP_UNCERTAIN=0
    TX_LIVE_PATH=""
    TX_PREVIOUS_COPY=""
    TX_PREVIOUS_DESCRIPTOR=""
    TX_TARGET_DESCRIPTOR=""
    TX_EXPECTED_DESCRIPTOR=""
    TX_VALIDATOR_FUNCTION=""
    TX_TARGET_VALIDATION_MESSAGES=""
    TX_ROLLBACK_VALIDATION_MESSAGES=""
    TX_FAILURE_REASON=""
    TX_OUTCOME=""
}


tx_pmxcfs_file_state() {
    # Byte/object descriptor for a single file: existence, object type and file
    # content. For a LIVE pmxcfs path this descriptor is not sufficient by itself;
    # the domain adapter must also prove the current pmxcfs context. pmxcfs owns
    # live metadata, so uid/gid/mode are not part of this descriptor.
    local path="$1"
    local sum=""

    if [[ ! -e "${path}" && ! -L "${path}" ]]; then
        printf 'ABSENT\n'
        return 0
    fi

    if [[ -L "${path}" || ! -f "${path}" ]]; then
        return 2
    fi

    sum="$(sha256sum -- "${path}")" || return 1
    sum="${sum%% *}"
    [[ "${sum}" =~ ^[0-9a-f]{64}$ ]] || return 1
    printf 'FILE\t%s\n' "${sum}"
}


tx_write_pmxcfs_file_descriptor() {
    local path="$1"
    local descriptor="$2"
    local state=""

    state="$(tx_pmxcfs_file_state "${path}")" || return $?
    printf '%s\n' "${state}" > "${descriptor}"
}


tx_pmxcfs_file_matches_descriptor() {
    local path="$1"
    local descriptor="$2"
    local expected=""
    local current=""

    expected="$(cat -- "${descriptor}")" || return 2
    current="$(tx_pmxcfs_file_state "${path}")" || return 2
    [[ "${current}" == "${expected}" ]]
}


tx_capture_stable_pmxcfs_previous() {
    # Stable PREVIOUS proof: hash/existence before copy, copy, live state after
    # copy, and copy identity must all agree. This closes the normal
    # PREVIOUS-capture race without pretending to block a hostile root writer.
    local live="$1"
    local previous_copy="$2"
    local descriptor="$3"
    local before=""
    local after=""
    local copied=""

    before="$(tx_pmxcfs_file_state "${live}")" || return 2

    case "${before}" in
        ABSENT)
            rm -f -- "${previous_copy}" || return 1
            ;;
        FILE$'\t'*)
            cp -a -- "${live}" "${previous_copy}" || return 1
            copied="$(tx_pmxcfs_file_state "${previous_copy}")" || return 1
            [[ "${copied}" == "${before}" ]] || return 3
            ;;
        *)
            return 2
            ;;
    esac

    after="$(tx_pmxcfs_file_state "${live}")" || return 2
    [[ "${after}" == "${before}" ]] || return 3

    printf '%s\n' "${before}" > "${descriptor}"
}


tx_begin_single_pmxcfs_file() {
    local domain="$1"
    local live="$2"
    local previous_copy="$3"
    local previous_descriptor="$4"
    local target_descriptor="$5"
    local validator_function="$6"
    local target_messages="$7"
    local rollback_messages="$8"
    local domain_id="${9:-}"

    tx_reset
    TX_ACTIVE=1
    TX_DOMAIN="${domain}"
    TX_DOMAIN_ID="${domain_id}"
    TX_STATE="PREPARED"
    TX_LIVE_PATH="${live}"
    TX_PREVIOUS_COPY="${previous_copy}"
    TX_PREVIOUS_DESCRIPTOR="${previous_descriptor}"
    TX_TARGET_DESCRIPTOR="${target_descriptor}"
    TX_EXPECTED_DESCRIPTOR="${previous_descriptor}"
    TX_VALIDATOR_FUNCTION="${validator_function}"
    TX_TARGET_VALIDATION_MESSAGES="${target_messages}"
    TX_ROLLBACK_VALIDATION_MESSAGES="${rollback_messages}"
}


tx_restore_previous_single_pmxcfs_file() {
    local previous_state=""

    previous_state="$(cat -- "${TX_PREVIOUS_DESCRIPTOR}")" || return 1

    case "${previous_state}" in
        ABSENT)
            if ! rm -f -- "${TX_LIVE_PATH}"; then
                tx_pmxcfs_file_matches_descriptor \
                    "${TX_LIVE_PATH}" "${TX_PREVIOUS_DESCRIPTOR}" || return 1
            fi
            ;;
        FILE$'\t'*)
            tx_pmxcfs_file_matches_descriptor \
                "${TX_PREVIOUS_COPY}" "${TX_PREVIOUS_DESCRIPTOR}" || return 1
            if ! write_pmxcfs_file_atomic \
                "${TX_PREVIOUS_COPY}" "${TX_LIVE_PATH}"; then
                # A writer can report failure after the destination transition
                # became effective. The postcondition, not the command status
                # alone, decides whether PREVIOUS was restored.
                tx_pmxcfs_file_matches_descriptor \
                    "${TX_LIVE_PATH}" "${TX_PREVIOUS_DESCRIPTOR}" || return 1
            fi
            ;;
        *)
            return 1
            ;;
    esac

    tx_pmxcfs_file_matches_descriptor \
        "${TX_LIVE_PATH}" "${TX_PREVIOUS_DESCRIPTOR}"
}


tx_validate_previous_state() {
    local validator_rc=0

    TX_EXPECTED_DESCRIPTOR="${TX_PREVIOUS_DESCRIPTOR}"
    TX_STATE="ROLLBACK_VALIDATING"

    if "${TX_VALIDATOR_FUNCTION}" \
        rollback "${TX_ROLLBACK_VALIDATION_MESSAGES}"; then
        validator_rc=0
    else
        validator_rc=$?
        if ! tx_domain_live_matches_descriptor "${TX_PREVIOUS_DESCRIPTOR}"; then
            TX_STATE="AMBIGUOUS"
            TX_OUTCOME="AMBIGUOUS"
            TX_FAILURE_REASON="live state/context changed during failed rollback validation (validator rc=${validator_rc})"
            return 2
        fi
        TX_STATE="ROLLBACK_VALIDATION_FAILED"
        TX_OUTCOME="ROLLBACK_FAILED"
        TX_FAILURE_REASON="PREVIOUS bytes/context are exact, but the rollback validator failed (rc=${validator_rc})"
        return 3
    fi

    # The final PREVIOUS identity gate is the rollback linearization point. For
    # Storage it is reacquired under Proxmox's storage.cfg cfs lock after the
    # semantic validator ran outside that lock.
    if ! tx_domain_live_matches_descriptor "${TX_PREVIOUS_DESCRIPTOR}"; then
        TX_STATE="AMBIGUOUS"
        TX_OUTCOME="AMBIGUOUS"
        TX_FAILURE_REASON="live state/context changed during rollback validation"
        return 2
    fi

    TX_STATE="ROLLED_BACK"
    TX_OUTCOME="ROLLED_BACK"
    TX_ACTIVE=0
    return 0
}

tx_rollback_single_pmxcfs_file() {
    local op_rc=0

    if (( TX_TEMP_CLEANUP_UNCERTAIN == 1 )); then
        TX_STATE="AMBIGUOUS"
        TX_OUTCOME="AMBIGUOUS"
        return 2
    fi

    # Storage rollback combines ownership-check and PREVIOUS write inside the
    # same Proxmox storage.cfg cfs lock. This closes the check->write race that
    # allowed a cooperating storage writer to be overwritten in R3.
    if [[ "${TX_DOMAIN}" == "storage" ]]; then
        TX_STATE="ROLLING_BACK"
        if storage_tx_locked_rollback; then
            op_rc=0
        else
            op_rc=$?
        fi

        case "${op_rc}" in
            0)
                tx_validate_previous_state
                return $?
                ;;
            72)
                TX_STATE="AMBIGUOUS"
                TX_OUTCOME="AMBIGUOUS"
                TX_FAILURE_REASON="live state no longer matches PREVIOUS or the transaction-owned state before rollback"
                return 2
                ;;
            75)
                # The locked writer reported failure, but its postcondition proved
                # that exact PREVIOUS became live in a healthy/current pmxcfs
                # context. Preserve the R3 rule that postcondition beats the raw
                # writer status and complete the normal rollback validation.
                tx_validate_previous_state
                return $?
                ;;
            70)
                # As with apply, a cfs-lock/callback error does not by itself
                # prove whether the write became effective. If exact PREVIOUS can
                # be re-proved under the domain lock, finish normal rollback
                # validation. Otherwise fail closed without another blind write.
                if tx_domain_live_matches_descriptor "${TX_PREVIOUS_DESCRIPTOR}"; then
                    tx_validate_previous_state
                    return $?
                fi
                TX_STATE="ROLLBACK_FAILED"
                TX_OUTCOME="ROLLBACK_FAILED"
                TX_FAILURE_REASON="storage lock/callback failed and rollback postcondition could not be classified safely (storage lock rc=${op_rc})"
                return 3
                ;;
            78)
                TX_TEMP_CLEANUP_UNCERTAIN=1
                TX_STATE="AMBIGUOUS"
                TX_OUTCOME="AMBIGUOUS"
                TX_FAILURE_REASON="storage rollback temporary cleanup is unproven; inspect preserved storage.lock-rollback.err"
                return 2
                ;;
            71|73|74|76|77)
                TX_STATE="ROLLBACK_FAILED"
                TX_OUTCOME="ROLLBACK_FAILED"
                TX_FAILURE_REASON="locked PREVIOUS rollback could not be completed safely (storage lock rc=${op_rc})"
                return 3
                ;;
            *)
                TX_STATE="ROLLBACK_FAILED"
                TX_OUTCOME="ROLLBACK_FAILED"
                TX_FAILURE_REASON="locked PREVIOUS rollback returned unexpected status ${op_rc}"
                return 3
                ;;
        esac
    fi

    # VM restore holds Proxmox's native per-VM flock continuously across the
    # complete critical window. The pinned transition combines ownership/context
    # classification with the PREVIOUS write while that lock is still held.
    if [[ "${TX_DOMAIN}" == "vm" ]]; then
        TX_STATE="ROLLING_BACK"
        if vm_tx_rollback; then
            op_rc=0
        else
            op_rc=$?
        fi

        case "${op_rc}" in
            0|75)
                tx_validate_previous_state
                return $?
                ;;
            72)
                TX_STATE="AMBIGUOUS"
                TX_OUTCOME="AMBIGUOUS"
                TX_FAILURE_REASON="VM live state no longer matches PREVIOUS or the transaction-owned state before rollback"
                return 2
                ;;
            70)
                if tx_domain_live_matches_descriptor "${TX_PREVIOUS_DESCRIPTOR}"; then
                    tx_validate_previous_state
                    return $?
                fi
                TX_STATE="ROLLBACK_FAILED"
                TX_OUTCOME="ROLLBACK_FAILED"
                TX_FAILURE_REASON="VM transaction helper/lock failed and rollback postcondition could not be classified safely (rc=${op_rc})"
                return 3
                ;;
            78)
                TX_TEMP_CLEANUP_UNCERTAIN=1
                TX_STATE="AMBIGUOUS"
                TX_OUTCOME="AMBIGUOUS"
                TX_FAILURE_REASON="VM rollback temporary cleanup is unproven; inspect preserved vm.lock-rollback.err"
                return 2
                ;;
            71|73|74|76|77)
                TX_STATE="ROLLBACK_FAILED"
                TX_OUTCOME="ROLLBACK_FAILED"
                TX_FAILURE_REASON="pinned VM PREVIOUS rollback could not be completed safely (rc=${op_rc})"
                return 3
                ;;
            *)
                TX_STATE="ROLLBACK_FAILED"
                TX_OUTCOME="ROLLBACK_FAILED"
                TX_FAILURE_REASON="pinned VM PREVIOUS rollback returned unexpected status ${op_rc}"
                return 3
                ;;
        esac
    fi

    # Generic fallback retained for future adapters that do not yet provide a
    # domain-native compare/write primitive.
    if tx_pmxcfs_file_matches_descriptor \
        "${TX_LIVE_PATH}" "${TX_PREVIOUS_DESCRIPTOR}"; then
        tx_validate_previous_state
        return $?
    fi

    if ! tx_pmxcfs_file_matches_descriptor \
        "${TX_LIVE_PATH}" "${TX_EXPECTED_DESCRIPTOR}"; then
        TX_STATE="AMBIGUOUS"
        TX_OUTCOME="AMBIGUOUS"
        TX_FAILURE_REASON="live state no longer matches the transaction-owned state before rollback"
        return 2
    fi

    TX_STATE="ROLLING_BACK"
    if ! tx_restore_previous_single_pmxcfs_file; then
        TX_STATE="ROLLBACK_FAILED"
        TX_OUTCOME="ROLLBACK_FAILED"
        TX_FAILURE_REASON="PREVIOUS could not be restored exactly"
        return 3
    fi

    tx_validate_previous_state
}

tx_unexpected_rollback() {
    # Used only by EXIT cleanup after an unexpected in-process error. Classification
    # uses the domain identity gate; domain adapters include their pmxcfs context
    # and native serialization requirements. A later rollback rechecks ownership.
    (( TX_ACTIVE == 1 && TX_MUTATION_STARTED == 1 )) || return 0

    # Exact live bytes cannot discharge an unresolved transaction temporary artifact.
    if (( TX_TEMP_CLEANUP_UNCERTAIN == 1 )); then
        TX_STATE="AMBIGUOUS"
        TX_OUTCOME="AMBIGUOUS"
        return 1
    fi

    if tx_domain_live_matches_descriptor "${TX_PREVIOUS_DESCRIPTOR}"; then
        if tx_validate_previous_state; then
            return 0
        else
            return $?
        fi
    fi

    if tx_domain_live_matches_descriptor "${TX_TARGET_DESCRIPTOR}"; then
        TX_EXPECTED_DESCRIPTOR="${TX_TARGET_DESCRIPTOR}"
        if tx_rollback_single_pmxcfs_file; then
            return 0
        else
            return $?
        fi
    fi

    TX_STATE="AMBIGUOUS"
    TX_OUTCOME="AMBIGUOUS"
    TX_FAILURE_REASON="unexpected process error left a live state/context that is neither PREVIOUS nor TARGET"
    return 1
}

tx_apply_single_pmxcfs_file() {
    local target="$1"
    local write_rc=0
    local validator_rc=0

    TX_OUTCOME=""
    TX_FAILURE_REASON=""

    # Immutable TARGET gate: the staged source must still be the exact target
    # that was fingerprinted before PREVIOUS was captured.
    if ! tx_pmxcfs_file_matches_descriptor \
        "${target}" "${TX_TARGET_DESCRIPTOR}"; then
        TX_STATE="ABORTED_BEFORE_MUTATION"
        TX_OUTCOME="ABORTED_BEFORE_MUTATION"
        TX_FAILURE_REASON="staged TARGET changed before apply"
        TX_ACTIVE=0
        return 11
    fi

    TX_STATE="ARMED"
    TX_MUTATION_STARTED=1
    TX_STATE="APPLYING"

    if [[ "${TX_DOMAIN}" == "storage" ]]; then
        # For Storage, PREVIOUS ownership-check and TARGET write are one locked
        # Proxmox operation. A normal Proxmox storage writer cannot interpose in
        # the R3 check->write gap anymore.
        if storage_tx_locked_apply "${target}"; then
            write_rc=0
        else
            write_rc=$?
        fi

        case "${write_rc}" in
            0)
                ;;
            70)
                # A cfs-lock callback can fail after an effective write (for
                # example its fixed callback alarm can fire). The raw lock RC
                # therefore cannot prove that no mutation happened. Reclassify
                # the postcondition under the same domain lock before deciding.
                if tx_domain_live_matches_descriptor "${TX_PREVIOUS_DESCRIPTOR}"; then
                    TX_STATE="ABORTED_BEFORE_MUTATION"
                    TX_OUTCOME="ABORTED_BEFORE_MUTATION"
                    TX_FAILURE_REASON="storage lock/callback failed, but exact PREVIOUS is still live (rc=${write_rc})"
                    TX_MUTATION_STARTED=0
                    TX_ACTIVE=0
                    return 11
                fi

                if tx_domain_live_matches_descriptor "${TX_TARGET_DESCRIPTOR}"; then
                    TX_EXPECTED_DESCRIPTOR="${TX_TARGET_DESCRIPTOR}"
                    TX_STATE="TARGET_APPLIED"
                    TX_FAILURE_REASON="storage lock/callback failed after exact TARGET became live (rc=${write_rc})"
                    if tx_rollback_single_pmxcfs_file; then
                        return 10
                    fi
                    [[ "${TX_STATE}" == "AMBIGUOUS" ]] && return 20
                    return 21
                fi

                TX_STATE="AMBIGUOUS"
                TX_OUTCOME="AMBIGUOUS"
                TX_FAILURE_REASON="storage lock/callback failed and the live postcondition could not be classified safely (rc=${write_rc})"
                return 20
                ;;
            71|72|73|74)
                TX_STATE="ABORTED_BEFORE_MUTATION"
                TX_OUTCOME="ABORTED_BEFORE_MUTATION"
                TX_FAILURE_REASON="locked TARGET apply made no safe transaction-owned transition (storage lock rc=${write_rc})"
                TX_MUTATION_STARTED=0
                TX_ACTIVE=0
                return 11
                ;;
            75)
                TX_EXPECTED_DESCRIPTOR="${TX_TARGET_DESCRIPTOR}"
                TX_STATE="TARGET_APPLIED"
                TX_FAILURE_REASON="TARGET write reported failure after TARGET became live"
                if tx_rollback_single_pmxcfs_file; then
                    return 10
                fi
                [[ "${TX_STATE}" == "AMBIGUOUS" ]] && return 20
                return 21
                ;;
            78)
                TX_TEMP_CLEANUP_UNCERTAIN=1
                TX_STATE="AMBIGUOUS"
                TX_OUTCOME="AMBIGUOUS"
                TX_FAILURE_REASON="storage apply temporary cleanup is unproven; inspect preserved storage.lock-apply.err"
                return 20
                ;;
            76|77)
                TX_STATE="AMBIGUOUS"
                TX_OUTCOME="AMBIGUOUS"
                TX_FAILURE_REASON="locked TARGET apply ended with ambiguous live state/context (storage lock rc=${write_rc})"
                return 20
                ;;
            *)
                TX_STATE="AMBIGUOUS"
                TX_OUTCOME="AMBIGUOUS"
                TX_FAILURE_REASON="locked TARGET apply returned unexpected status ${write_rc}"
                return 20
                ;;
        esac
    elif [[ "${TX_DOMAIN}" == "vm" ]]; then
        # The outer restore owns the same flock used by normal Proxmox QEMU
        # operations. The pinned helper additionally keeps each live transition
        # rooted in the current pmxcfs mount.
        if vm_tx_apply "${target}"; then
            write_rc=0
        else
            write_rc=$?
        fi

        case "${write_rc}" in
            0)
                ;;
            70)
                if tx_domain_live_matches_descriptor "${TX_PREVIOUS_DESCRIPTOR}"; then
                    TX_STATE="ABORTED_BEFORE_MUTATION"
                    TX_OUTCOME="ABORTED_BEFORE_MUTATION"
                    TX_FAILURE_REASON="VM helper/lock failed, but exact PREVIOUS is still live (rc=${write_rc})"
                    TX_MUTATION_STARTED=0
                    TX_ACTIVE=0
                    return 11
                fi
                if tx_domain_live_matches_descriptor "${TX_TARGET_DESCRIPTOR}"; then
                    TX_EXPECTED_DESCRIPTOR="${TX_TARGET_DESCRIPTOR}"
                    TX_STATE="TARGET_APPLIED"
                    TX_FAILURE_REASON="VM helper/lock failed after exact TARGET became live (rc=${write_rc})"
                    if tx_rollback_single_pmxcfs_file; then
                        return 10
                    fi
                    [[ "${TX_STATE}" == "AMBIGUOUS" ]] && return 20
                    return 21
                fi
                TX_STATE="AMBIGUOUS"
                TX_OUTCOME="AMBIGUOUS"
                TX_FAILURE_REASON="VM helper/lock failed and the live postcondition could not be classified safely (rc=${write_rc})"
                return 20
                ;;
            71|72|73|74)
                TX_STATE="ABORTED_BEFORE_MUTATION"
                TX_OUTCOME="ABORTED_BEFORE_MUTATION"
                TX_FAILURE_REASON="pinned VM TARGET apply made no safe transaction-owned transition (rc=${write_rc})"
                TX_MUTATION_STARTED=0
                TX_ACTIVE=0
                return 11
                ;;
            75)
                TX_EXPECTED_DESCRIPTOR="${TX_TARGET_DESCRIPTOR}"
                TX_STATE="TARGET_APPLIED"
                TX_FAILURE_REASON="VM TARGET write reported failure after TARGET became live"
                if tx_rollback_single_pmxcfs_file; then
                    return 10
                fi
                [[ "${TX_STATE}" == "AMBIGUOUS" ]] && return 20
                return 21
                ;;
            78)
                TX_TEMP_CLEANUP_UNCERTAIN=1
                TX_STATE="AMBIGUOUS"
                TX_OUTCOME="AMBIGUOUS"
                TX_FAILURE_REASON="VM apply temporary cleanup is unproven; inspect preserved vm.lock-apply.err"
                return 20
                ;;
            76|77)
                TX_STATE="AMBIGUOUS"
                TX_OUTCOME="AMBIGUOUS"
                TX_FAILURE_REASON="pinned VM TARGET apply ended with ambiguous live state/context (rc=${write_rc})"
                return 20
                ;;
            *)
                TX_STATE="AMBIGUOUS"
                TX_OUTCOME="AMBIGUOUS"
                TX_FAILURE_REASON="pinned VM TARGET apply returned unexpected status ${write_rc}"
                return 20
                ;;
        esac
    else
        # Generic fallback retained for future adapters. It still uses optimistic
        # identity gates until that domain supplies its native writer lock.
        if ! tx_pmxcfs_file_matches_descriptor \
            "${TX_LIVE_PATH}" "${TX_PREVIOUS_DESCRIPTOR}"; then
            TX_STATE="ABORTED_BEFORE_MUTATION"
            TX_OUTCOME="ABORTED_BEFORE_MUTATION"
            TX_FAILURE_REASON="live state changed after PREVIOUS capture and before apply"
            TX_MUTATION_STARTED=0
            TX_ACTIVE=0
            return 11
        fi

        if write_pmxcfs_file_atomic "${target}" "${TX_LIVE_PATH}"; then
            write_rc=0
        else
            write_rc=$?

            if tx_pmxcfs_file_matches_descriptor \
                "${TX_LIVE_PATH}" "${TX_PREVIOUS_DESCRIPTOR}"; then
                TX_STATE="ABORTED_BEFORE_MUTATION"
                TX_OUTCOME="ABORTED_BEFORE_MUTATION"
                TX_FAILURE_REASON="TARGET write failed without changing LIVE (rc=${write_rc})"
                TX_MUTATION_STARTED=0
                TX_ACTIVE=0
                return 11
            fi

            if tx_pmxcfs_file_matches_descriptor \
                "${TX_LIVE_PATH}" "${TX_TARGET_DESCRIPTOR}"; then
                TX_EXPECTED_DESCRIPTOR="${TX_TARGET_DESCRIPTOR}"
                TX_STATE="TARGET_APPLIED"
                TX_FAILURE_REASON="TARGET write reported failure after TARGET became live (rc=${write_rc})"
                if tx_rollback_single_pmxcfs_file; then
                    return 10
                fi
                [[ "${TX_STATE}" == "AMBIGUOUS" ]] && return 20
                return 21
            fi

            TX_STATE="AMBIGUOUS"
            TX_OUTCOME="AMBIGUOUS"
            TX_FAILURE_REASON="TARGET write failed and LIVE is neither PREVIOUS nor TARGET (rc=${write_rc})"
            return 20
        fi

        if ! tx_pmxcfs_file_matches_descriptor \
            "${TX_LIVE_PATH}" "${TX_TARGET_DESCRIPTOR}"; then
            if tx_pmxcfs_file_matches_descriptor \
                "${TX_LIVE_PATH}" "${TX_PREVIOUS_DESCRIPTOR}"; then
                TX_STATE="ABORTED_BEFORE_MUTATION"
                TX_OUTCOME="ABORTED_BEFORE_MUTATION"
                TX_FAILURE_REASON="TARGET write returned success but LIVE remained PREVIOUS"
                TX_MUTATION_STARTED=0
                TX_ACTIVE=0
                return 11
            fi
            TX_STATE="AMBIGUOUS"
            TX_OUTCOME="AMBIGUOUS"
            TX_FAILURE_REASON="TARGET write returned success but LIVE is neither TARGET nor PREVIOUS"
            return 20
        fi
    fi

    TX_EXPECTED_DESCRIPTOR="${TX_TARGET_DESCRIPTOR}"
    TX_STATE="TARGET_APPLIED"
    TX_STATE="VALIDATING"

    if "${TX_VALIDATOR_FUNCTION}" \
        target "${TX_TARGET_VALIDATION_MESSAGES}"; then
        validator_rc=0
    else
        validator_rc=$?
        TX_FAILURE_REASON="TARGET validator failed or produced diagnostics (rc=${validator_rc})"
        if tx_rollback_single_pmxcfs_file; then
            return 10
        fi
        [[ "${TX_STATE}" == "AMBIGUOUS" ]] && return 20
        return 21
    fi

    TX_STATE="COMMIT_READY"
    # Validator success alone is not commit. Re-prove exact TARGET plus the
    # domain-specific live context under its native serialization. This final
    # identity gate is the transaction linearization/commit point.
    if ! tx_domain_live_matches_descriptor "${TX_TARGET_DESCRIPTOR}"; then
        TX_STATE="AMBIGUOUS"
        TX_OUTCOME="AMBIGUOUS"
        TX_FAILURE_REASON="live state/context changed during TARGET validation or before commit"
        return 20
    fi

    TX_STATE="COMMITTED"
    TX_OUTCOME="COMMITTED"
    TX_ACTIVE=0
    return 0
}

storage_tx_prevalidate_candidate() {
    # Parse a staged storage.cfg with Proxmox's own storage parser before the
    # file is made live. Loading PVE::Storage initializes the standard and
    # installed custom storage plugins; parse_config performs the same
    # SectionConfig/schema parsing used for storage.cfg. This is intentionally
    # an offline syntax/schema admission gate, not a backend reachability test.
    local candidate="$1"
    local messages="$2"
    local rc=0

    [[ -f "${candidate}" && ! -L "${candidate}" ]] || return 64
    : > "${messages}" || return 1

    if perl -MPVE::Storage -MPVE::Storage::Plugin -e '
        use strict;
        use warnings;

        my ($path) = @ARGV;
        open(my $fh, "<", $path) or die "open $path failed: $!\n";
        local $/;
        my $raw = <$fh>;
        close($fh) or die "close $path failed: $!\n";

        my $cfg = PVE::Storage::Plugin->parse_config($path, $raw);
        die "storage parser returned no configuration\n"
            if ref($cfg) ne "HASH" || ref($cfg->{ids}) ne "HASH";
    ' "${candidate}" >/dev/null 2>"${messages}"; then
        rc=0
    else
        rc=$?
        return "${rc}"
    fi

    # Parser warnings are semantically relevant admission diagnostics. Do not
    # silently accept a candidate that the Proxmox parser warns about.
    [[ ! -s "${messages}" ]] || return 2
    return 0
}


storage_tx_validate_live() {
    local phase="$1"
    local messages="$2"
    local rc=0

    [[ "${phase}" == "previous" || "${phase}" == "target" || "${phase}" == "rollback" ]] || return 64
    : > "${messages}" || return 1

    if pvesm status >/dev/null 2>"${messages}" 7>&- 8>&-; then
        rc=0
    else
        rc=$?
        return "${rc}"
    fi

    # R4 deliberately preserves the R3 validator policy: this is a command-level
    # live acceptance/status gate (RC 0 and no stderr diagnostics). It does NOT
    # claim that every configured backend is reachable/active; `pvesm status` can
    # report inactive/disabled storages on stdout while itself returning RC 0.
    # The transaction path has no post-mutation KEEP prompt.
    [[ ! -s "${messages}" ]] || return 2
    return 0
}


tx_print_validation_messages_noncritical() {
    local label="$1"
    local messages="$2"

    [[ -s "${messages}" ]] || return 0
    printf '%s\n' "${label}:" >&2 || true
    sed 's/^/  /' "${messages}" >&2 || true
    return 0
}


restore_ssh() {
    local rc=0
    local helper=""

    verify_backup

    if ! require_commands_for_operation python3 tar flock stat sha256sum systemctl; then
        echo "C29 SSH R6 requires Python3 and essential validation utilities." >&2
        pause
        return 0
    fi
    if [[ ! -x /usr/sbin/sshd ]]; then
        echo "C29 SSH R6: /usr/sbin/sshd is unavailable." >&2
        pause
        return 0
    fi
    if ! backup_members_present "${BACKUP}/etc-host.tar.gz" "etc/ssh/sshd_config"; then
        echo "C29 SSH R6: backup has no SSH main configuration." >&2
        pause
        return 0
    fi

    echo
    echo "C29 SSH R6 (Restore 1.14): sshd_config + sshd_config.d transaction."
    echo "The temporary Dateifreigabe directory /run/dateifreigabe is NOT restored or modified."
    echo "Keep current SSH session and IPMI access available throughout host validation."
    confirm_word "Restore SSH configuration from ${BACKUP}?" "RESTORE" || { cancelled; return 0; }
    begin_restore_session || { pause; return 0; }
    new_workdir
    helper="${WORKDIR}/c29_ssh_r6_helper.py"
    if ! cat > "${helper}" <<'C29_SSH_R6_EMBEDDED_PYTHON'
#!/usr/bin/env python3
"""C29 SSH R6. Embedded in pve-config-restore 1.14; strictly standalone-only SSH tree transaction.

Return codes: 0 committed/same-state, 20 rejected before mutation, 78 critical/uncertain,
74 failed but previous proven restored. SIGKILL/death persistence is C30, not claimed. In-process rename/cleanup is classified.
"""
import errno
import ctypes
import fcntl
import glob
import hashlib
import os
import re
import shutil
import signal
import stat
import subprocess
import sys
import tarfile
import time
from decimal import Decimal, InvalidOperation
from pathlib import Path

SSH_ROOT = Path('/etc/ssh')
SSH_DAEMON = '/usr/sbin/sshd'
SERVICE_COMMAND = ('systemctl', 'reload', 'ssh.service')
SERVICE_HEALTH = ('systemctl', 'is-active', '--quiet', 'ssh.service')
LOCK_FILE = Path('/run/lock/pve-config-restore-ssh.lock')
EXTERNAL_GLOB = '/run/dateifreigabe/*.conf'
EXTERNAL_SCAN_GLOB = EXTERNAL_GLOB
LOCAL_INCLUDE = '/etc/ssh/sshd_config.d/*.conf'
MAIN = 'sshd_config'
DROP = 'sshd_config.d'
MAX_MEMBER = 1024 * 1024
MAX_TOTAL = 16 * 1024 * 1024
MAX_ENTRIES = 500


class Reject(Exception):
    pass


class Critical(Exception):
    pass


def sha(data):
    return hashlib.sha256(data).hexdigest()


def emit(*items, **kwargs):
    print(*items, flush=True, **kwargs)


def require(condition, detail):
    if not condition:
        raise Reject(detail)


def owned_stat(path):
    s = os.lstat(path)
    typ = 'D' if stat.S_ISDIR(s.st_mode) else ('F' if stat.S_ISREG(s.st_mode) else '?')
    return (typ, s.st_dev, s.st_ino, s.st_uid, s.st_gid, stat.S_IMODE(s.st_mode),
            s.st_size if typ == 'F' else 0, s.st_mtime_ns, s.st_ctime_ns, s.st_nlink)


def xattr_empty(path):
    # ACL metadata is represented as system.posix_acl_* extended attributes on Linux.
    try:
        return not os.listxattr(path, follow_symlinks=False)
    except OSError as exc:
        raise Reject(f'cannot establish xattr/ACL absence: {exc}') from exc


def file_desc(path):
    first = owned_stat(path)
    require(first[0] == 'F' and first[-1] == 1, f'non-regular/hardlinked SSH object: {path}')
    require(first[3:5] == (0, 0) and not (first[5] & 0o022), f'unsafe permissions: {path}')
    require(xattr_empty(path), f'unhandled xattr/ACL: {path}')
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        before = os.fstat(fd)
        require((before.st_dev, before.st_ino) == first[1:3], f'file moved before reading: {path}')
        require(before.st_size <= MAX_MEMBER, f'oversized SSH file: {path}')
        chunks = []
        total = 0
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            total += len(chunk)
            require(total <= MAX_MEMBER, f'oversized SSH file: {path}')
            chunks.append(chunk)
        data = b''.join(chunks)
        after = os.fstat(fd)
    finally:
        os.close(fd)
    require((before.st_size, before.st_mtime_ns, before.st_ctime_ns) ==
            (after.st_size, after.st_mtime_ns, after.st_ctime_ns), f'concurrent file update: {path}')
    require(first == owned_stat(path), f'file changed while scanning: {path}')
    return (first, sha(data), data)


def require_safe_parents(root):
    """No symlink parent traversals, or group/world writable non-sticky ancestors."""
    path = Path(root)
    for parent in reversed(path.parents):
        st = os.lstat(parent)
        require(stat.S_ISDIR(st.st_mode) and st.st_uid == 0,
                f'unsafe SSH ancestor type/owner: {parent}')
        mode = stat.S_IMODE(st.st_mode)
        # /tmp is only permitted as an isolated fixture's sticky ancestor.
        require(not (mode & 0o022) or
                (path != Path('/etc/ssh') and mode & 0o1000 and st.st_uid == 0),
                f'unsafe SSH ancestor mode: {parent}')


def snapshot_tree(root=None):
    root = root or SSH_ROOT
    require_safe_parents(root)
    require(owned_stat(root)[0] == 'D', 'SSH root is not a real directory')
    require(owned_stat(root)[3:5] == (0, 0), 'SSH root owner not root:root')
    require(not (owned_stat(root)[5] & 0o022), 'unsafe writable SSH root directory')
    require(xattr_empty(root), 'SSH root unexpected xattrs')
    out = {}
    main = root / MAIN
    out[MAIN] = file_desc(main)[:2]
    drop = root / DROP
    s = owned_stat(drop)
    require(s[0] == 'D' and s[3:5] == (0, 0) and not s[5] & 0o022, 'SSH dropin is not safe directory')
    require(xattr_empty(drop), 'SSH dropin directory xattr/ACL present')
    out[DROP] = (s, None)
    count = 0
    for current, dirs, files in os.walk(drop, topdown=True, followlinks=False,
                                            onerror=lambda err: (_ for _ in ()).throw(Reject(str(err)))):
        dirs.sort()
        files.sort()
        for name in dirs + files:
            count += 1
            require(count <= MAX_ENTRIES, 'too many SSH dropin objects')
            p = Path(current) / name
            rel = p.relative_to(root).as_posix()
            require('\n' not in rel and '\r' not in rel, 'unsafe SSH object name')
            s = owned_stat(p)
            if name in dirs:
                require(s[0] == 'D' and s[3:5] == (0, 0) and not s[5] & 0o022, 'unsafe SSH directory')
                require(xattr_empty(p), 'unhandled SSH directory xattrs')
                out[rel] = (s, None)
            else:
                out[rel] = file_desc(p)[:2]
    return out


def dropin_snapshot_at(directory):
    """Full escrow tree audit; a matching parent inode alone cannot protect child data."""
    root = directory.parent
    # Snapshot exactly the provided directory tree without relying on its live name.
    s = owned_stat(directory)
    require(s[0] == 'D' and s[3:5] == (0, 0) and not s[5] & 0o022,
            'unsafe escrow root')
    require(xattr_empty(directory), 'escrow root unexpected xattrs')
    out = {DROP: (s, None)}
    total = 0
    for current, dirs, files in os.walk(directory, topdown=True, followlinks=False,
                                            onerror=lambda err: (_ for _ in ()).throw(Reject(str(err)))):
        dirs.sort(); files.sort()
        for name in dirs + files:
            total += 1
            require(total <= MAX_ENTRIES, 'too many escrow entries')
            p = Path(current) / name
            rel = DROP + '/' + p.relative_to(directory).as_posix()
            entry = owned_stat(p)
            if name in dirs:
                require(entry[0] == 'D' and entry[3:5] == (0,0) and not entry[5] & 0o022,
                        'unsafe escrow subdirectory')
                require(xattr_empty(p), 'unhandled escrow directory ACL/xattrs')
                out[rel] = (entry,None)
            else:
                out[rel] = file_desc(p)[:2]
    return out


def logical(snap):
    """Only restorable attributes: kind uid gid mode mtime + file digest/size."""
    return {key: (value[0][0], value[0][3:6], value[0][6] if value[0][0] == 'F' else None,
                  value[0][7], value[1]) for key, value in snap.items()}


def same_identity(a, b):
    return a == b  # recheck stable unmodified PREVIOUS only


def own_object(actual, expected):
    """A rename can update ctime; identity requires inode/device and restorable metadata."""
    return (actual[0][1:3] == expected[0][1:3]
            and logical({'x': actual}) == logical({'x': expected}))


def own_tree(actual, expected):
    return (set(actual) == set(expected)
            and all(own_object(actual[k], expected[k]) for k in expected))


def escrow_matches_previous(escrow_path, original):
    reference = {k: v for k, v in original.items() if k != MAIN}
    return own_tree(dropin_snapshot_at(escrow_path), reference)


def stable_snapshot(root=None):
    root = root or SSH_ROOT
    a = snapshot_tree(root)
    b = snapshot_tree(root)
    require(same_identity(a, b), 'SSH snapshot drift during capture')
    return b


def external_absent():
    try:
        # File matches include dangling symlinks; no reliance on file contents.
        return len(glob.glob(EXTERNAL_SCAN_GLOB)) == 0
    except (OSError, ValueError) as exc:
        raise Reject(f'external include unresolved: {exc}')


def parse_includes(data, *, dropin=False):
    try:
        lines = data.decode('utf-8').splitlines(keepends=True)
    except UnicodeError as exc:
        raise Reject(f'unsupported non-UTF8 SSH config: {exc}') from exc
    includes = []
    in_match = False
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith('#'):
            continue
        require('\x00' not in line and '\r' not in line, 'binary/newline SSH directive')
        # Reject Include within Match or continuation contexts, and other forms not proven.
        parts = stripped.split()
        require(parts, 'empty directive')
        if parts[0].lower() == 'match':
            in_match = True
        if parts[0].lower() == 'include':
            require(not dropin and not in_match and len(parts) == 2,
                    'unsupported Include in Dropin/Match/multi-pattern')
            includes.append(parts[1])
        require(not line.rstrip('\n').endswith('\\'), 'unsupported backslash continuation')
    if not dropin:
        require(includes == [LOCAL_INCLUDE, EXTERNAL_GLOB],
                f'SSH Include policy mismatch: {includes!r}')
    return lines


def target_archive(archive):
    objects = {}
    names = set()
    total = 0
    with tarfile.open(archive, 'r:gz') as tar:
        members = tar.getmembers()
        require(len(members) <= 200000, 'backup archive member count unreasonable')
        for member in members:
            raw = member.name
            name = raw.removeprefix('./').rstrip('/')
            require(not raw.startswith('/') and '\\' not in raw and '\x00' not in raw,
                    f'unsafe archive name: {raw!r}')
            path = name.split('/')
            require(not any(p in ('', '.', '..') for p in path), f'unsafe path: {raw!r}')
            if name in ('etc', 'etc/ssh'):
                require(member.isdir(), f'unsafe SSH parent: {raw}')
            if not (name == 'etc/ssh/sshd_config' or name == 'etc/ssh/sshd_config.d' or
                    name.startswith('etc/ssh/sshd_config.d/')):
                continue
            require(name not in names, f'duplicate SSH archive entry: {name}')
            names.add(name)
            rel = name.removeprefix('etc/ssh/')
            require(rel == MAIN or rel == DROP or rel.startswith(DROP + '/'), 'invalid SSH path')
            require(member.isfile() or member.isdir(), f'link/special SSH entry: {name}')
            require(member.uid == 0 and member.gid == 0 and not (member.mode & 0o022),
                    f'unsafe SSH entry permissions: {name}')
            require(not (member.pax_headers.keys() - {'atime', 'ctime', 'mtime'}),
                    f'unsupported SSH PAX attributes: {name}')
            require(member.size <= MAX_MEMBER, f'oversized SSH member {name}')
            total += member.size
            require(total <= MAX_TOTAL and len(names) <= MAX_ENTRIES, 'oversized SSH restore scope')
            if member.isfile():
                fh = tar.extractfile(member)
                require(fh is not None, f'cannot read SSH member: {name}')
                data = fh.read(MAX_MEMBER + 1)
                require(len(data) == member.size, f'partial SSH member: {name}')
            else:
                data = None
            try:
                mtime_ns = int(Decimal(str(member.pax_headers.get('mtime', member.mtime))) * 1_000_000_000)
            except (InvalidOperation, OverflowError) as exc:
                raise Reject(f'invalid SSH mtime: {name}') from exc
            require(0 <= mtime_ns <= 9_000_000_000_000_000_000, 'SSH mtime out of range')
            objects[rel] = (member.isdir(), data, member.uid, member.gid,
                            stat.S_IMODE(member.mode), mtime_ns)
    require(MAIN in objects and objects[MAIN][0] is False, 'SSH main file missing')
    require(DROP in objects and objects[DROP][0] is True, 'SSH dropin directory missing')
    for name in objects:
        if name.startswith(DROP + '/'):
            pieces = name.split('/')
            for i in range(2, len(pieces)):
                parent = '/'.join(pieces[:i])
                require(parent in objects and objects[parent][0], f'missing SSH parent: {name}')
    parse_includes(objects[MAIN][1])
    for name, obj in objects.items():
        if name.startswith(DROP + '/') and obj[0] is False and name.endswith('.conf'):
            parse_includes(obj[1], dropin=True)
    return objects


def set_meta(path, item):
    _, _, uid, gid, mode, mtime_ns = item
    os.chown(path, uid, gid, follow_symlinks=False)
    os.chmod(path, mode, follow_symlinks=False)
    os.utime(path, ns=(mtime_ns, mtime_ns), follow_symlinks=False)


def materialize(root, objects):
    root.mkdir(mode=0o700)
    # main file plus dropin hierarchy. All staged content root-owned and no-follow.
    for name in sorted(objects, key=lambda x: (x.count('/'), x)):
        p = root / name
        obj = objects[name]
        if obj[0]:
            p.mkdir(mode=0o700)
        else:
            fd = os.open(p, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
            try:
                data = obj[1]
                with os.fdopen(fd, 'wb', closefd=False) as fh:
                    fh.write(data)
                    fh.flush()
                    os.fsync(fd)
            finally:
                os.close(fd)
            set_meta(p, obj)
    for name in sorted((n for n in objects if objects[n][0]), key=lambda x: -x.count('/')):
        set_meta(root / name, objects[name])
    return snapshot_tree(root)


def stage_parser_copy(stage, objects):
    main_bytes = objects[MAIN][1]
    # A parser-only copy (not installed) substitutes the managed absolute Include.
    lines = parse_includes(main_bytes)
    output = []
    swapped = 0
    for line in lines:
        parts = line.strip().split()
        if parts and parts[0].lower() == 'include' and len(parts) == 2 and parts[1] == LOCAL_INCLUDE:
            output.append('Include ' + str(stage / DROP / '*.conf') + '\n')
            swapped += 1
        else:
            output.append(line)
    require(swapped == 1, 'parser copy Include rewriting mismatch')
    parser_file = stage / '.parser-sshd_config'
    fd = os.open(parser_file, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as out:
        out.write(''.join(output).encode('utf-8'))
        out.flush()
        os.fsync(out.fileno())
    return parser_file


def validate_parser(parser_file):
    require(external_absent(), 'temporary Dateifreigabe active during validation')
    checks = [(SSH_DAEMON, '-t', '-f', str(parser_file))]
    for user in ('admin', 'root'):
        checks.append((SSH_DAEMON, '-T', '-f', str(parser_file), '-C',
                       f'user={user},host=localhost,addr=127.0.0.1'))
    for args in checks:
        r = subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=20)
        require(r.returncode == 0 and not r.stderr, f'native SSH stage validation failed ({args[1]}): {r.stderr[:250]!r}')
    require(external_absent(), 'Dateifreigabe changed during staged validation')


def validate_live():
    require(external_absent(), 'Dateifreigabe active during live validation')
    r = subprocess.run((SSH_DAEMON, '-t'), stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=20)
    require(r.returncode == 0 and not r.stderr, 'native live sshd -t failed')
    require(external_absent(), 'Dateifreigabe changed during live validation')


def service_reload():
    require(external_absent(), 'Dateifreigabe active during SSH reload')
    r = subprocess.run(SERVICE_COMMAND, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=25)
    require(r.returncode == 0, 'systemctl reload ssh.service failed')
    r = subprocess.run(SERVICE_HEALTH, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=15)
    require(r.returncode == 0, 'ssh.service not active after reload request')
    require(external_absent(), 'Dateifreigabe appeared during SSH reload')
    emit('RELOAD_REQUEST_ACCEPTED=YES')
    emit('RELOAD_COMPLETION_NOT_PROVEN=YES')


def service_active_gate():
    """A bounded, point-in-time service-health assertion, not a reload-completion proof."""
    result = subprocess.run(SERVICE_HEALTH, stdout=subprocess.DEVNULL,
                            stderr=subprocess.PIPE, timeout=15)
    require(result.returncode == 0, 'ssh.service not active at final transaction gate')


def fresh_name(suffix):
    return '.c29-ssh-r6-' + os.urandom(12).hex() + '-' + suffix


def write_result(workdir, result, reason):
    path = Path(workdir) / 'SSH_R6_RESULT.txt'
    with open(path, 'w', encoding='utf-8') as fh:
        fh.write('RESULT=' + result + '\nREASON=' + str(reason).replace('\n', ' ')[:350] + '\n')
        fh.flush()
        os.fsync(fh.fileno())


def rename_noreplace(src, dst, *, src_dir_fd, dst_dir_fd):
    """Linux renameat2(RENAME_NOREPLACE): never replace even an empty foreign dir.

    Fail closed if libc/filesystem does not support the atomic guarantee.
    """
    libc = ctypes.CDLL(None, use_errno=True)
    fn = getattr(libc, 'renameat2', None)
    if fn is None:
        raise Critical('renameat2 RENAME_NOREPLACE unavailable')
    fn.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    fn.restype = ctypes.c_int
    if fn(src_dir_fd, os.fsencode(src), dst_dir_fd, os.fsencode(dst), 1) != 0:
        e = ctypes.get_errno()
        raise OSError(e, os.strerror(e), str(dst))


def path_state(path):
    try:
        return owned_stat(path)
    except FileNotFoundError:
        return None


def owned_entry(path, expected, *, allow_dir_mtime_drift=False):
    """Preserve inode ownership, verifying stable content and mode for regular entries."""
    try:
        actual = file_desc(path)[:2] if expected[0][0] == 'F' else (owned_stat(path), None)
        if expected[0][0] == 'D':
            a, b = actual[0], expected[0]
            return (a[0] == 'D' and a[1:3] == b[1:3] and a[3:6] == b[3:6]
                    and (allow_dir_mtime_drift or a[7] == b[7])
                    and xattr_empty(path))
        return own_object(actual, expected)
    except (OSError, Reject):
        return False


def inventory_objects(directory):
    """Snapshot arbitrary owned private subtree, including parser-only files."""
    found = {}
    if path_state(directory) is None:
        raise Critical(f'missing private directory: {directory}')
    found['.'] = (owned_stat(directory), None)
    for current, dirs, files in os.walk(directory, topdown=True, followlinks=False,
                                        onerror=lambda err: (_ for _ in ()).throw(Critical(str(err)))):
        dirs.sort(); files.sort()
        for name in dirs + files:
            entry = Path(current) / name
            key = entry.relative_to(directory).as_posix()
            item = owned_stat(entry)
            if item[0] == 'D':
                found[key] = (item, None)
            elif item[0] == 'F':
                found[key] = file_desc(entry)[:2]
            else:
                raise Critical(f'foreign special private object: {key}')
    return found


def guarded_remove_owned_tree(directory, inventory, *, stage_root_mtime_mutated=False):
    """Do not recursively delete unrecognized objects, including foreign additions.

    All deletes are individually bounded by a known ownership inventory; rmdir
    refuses an unexpected newly-created child. Non-cooperating root races remain
    outside any absolute exclusion claim.
    """
    if path_state(directory) is None:
        raise Critical('owned private tree vanished before cleanup')
    now = inventory_objects(directory)
    if set(now) != set(inventory):
        missing = sorted(set(inventory) - set(now))
        foreign = sorted(set(now) - set(inventory))
        raise Critical('private tree inventory mismatch; preserve evidence: '
                       f'missing={missing[:8]!r} foreign={foreign[:8]!r}')
    if not owned_entry(directory, inventory['.'],
                       allow_dir_mtime_drift=stage_root_mtime_mutated):
        raise Critical('private tree identity changed; preserve evidence')
    for k, value in now.items():
        if not owned_entry(directory if k == '.' else directory/k, inventory[k],
                           allow_dir_mtime_drift=(stage_root_mtime_mutated and k == '.')):
            raise Critical('private tree content/identity changed; preserve evidence: ' + k)
    for k in sorted((x for x in now if x != '.'), key=lambda v: (-v.count('/'),v), reverse=False):
        path = directory / k
        # Own prior unlinks can change their parent directory mtime. The
        # complete inventory and each directory mtime were checked BEFORE the
        # first deletion; do not confuse our own unlink with foreign drift.
        has_owned_children = any(x.startswith(k + '/') for x in inventory)
        if not owned_entry(path, inventory[k],
                           allow_dir_mtime_drift=(inventory[k][0][0] == 'D' and has_owned_children)):
            raise Critical('foreign private object before deletion: ' + k)
        if inventory[k][0][0] == 'D':
            os.rmdir(path)
        else:
            os.unlink(path)
    os.rmdir(directory)  # fails if an unexpected child appeared during cleanup


def expected_stage_remainder(stage_inventory, *, main_consumed, drop_consumed):
    """Require the EXACT remaining stage inventory after verified, owned renames.

    No new inventory is learned from mutable stage contents: membership is always
    derived from the pre-apply captured inventory and proved rename transitions.
    """
    if stage_inventory is None or '.' not in stage_inventory:
        raise Critical('stage baseline inventory unavailable')
    if main_consumed and MAIN not in stage_inventory:
        raise Critical('stage MAIN missing from original inventory')
    if drop_consumed and DROP not in stage_inventory:
        raise Critical('stage DROP missing from original inventory')
    return {key: value for key, value in stage_inventory.items()
            if not (main_consumed and key == MAIN)
            and not (drop_consumed and (key == DROP or key.startswith(DROP + '/')))}



def classify_live(original, target_main_desc, target_drop_desc, escrow, quarantine, root_identity, restored_main_desc=None):
    """Derive the in-process recovery state from actual objects, never flags."""
    if owned_stat(SSH_ROOT)[1:3] != root_identity:
        raise Critical('SSH root changed during transaction')
    main = file_desc(SSH_ROOT/MAIN)[:2]
    if own_object(main, original[MAIN]) or (restored_main_desc is not None and own_object(main, restored_main_desc)):
        main_status = 'PREVIOUS'
    elif target_main_desc is not None and own_object(main, target_main_desc):
        main_status = 'TARGET'
    else:
        raise Critical('FOREIGN/AMBIGUOUS SSH main')
    drop_path = SSH_ROOT / DROP
    if path_state(drop_path) is None:
        drop_status = 'ABSENT'
    else:
        current = snapshot_tree()
        actual = {k:v for k,v in current.items() if k != MAIN}
        prev = {k:v for k,v in original.items() if k != MAIN}
        targ = ({k:v for k,v in target_drop_desc.items() if k != MAIN}
                if target_drop_desc is not None else {})
        if own_tree(actual, prev):
            drop_status = 'PREVIOUS'
        elif targ and own_tree(actual, targ):
            drop_status = 'TARGET'
        else:
            raise Critical('FOREIGN/AMBIGUOUS SSH dropins')
    esc = path_state(escrow) if escrow is not None else None
    if esc is not None and not escrow_matches_previous(escrow, original):
        raise Critical('FOREIGN/AMBIGUOUS escrow')
    qua = path_state(quarantine) if quarantine is not None else None
    if qua is not None:
        targ = {k:v for k,v in target_drop_desc.items() if k != MAIN}
        if not own_tree(dropin_snapshot_at(quarantine), targ):
            raise Critical('FOREIGN/AMBIGUOUS quarantine')
    if main_status == 'PREVIOUS' and drop_status == 'PREVIOUS' and esc is None:
        return 'PREVIOUS'
    if main_status == 'TARGET' and drop_status == 'PREVIOUS' and esc is None:
        return 'MAIN_APPLIED'
    if main_status == 'TARGET' and drop_status == 'ABSENT' and esc is not None and qua is None:
        return 'DROP_ESCROWED'
    if main_status == 'TARGET' and drop_status == 'TARGET' and esc is not None and qua is None:
        return 'TARGET_APPLIED'
    if main_status == 'TARGET' and drop_status == 'ABSENT' and esc is not None and qua is not None:
        return 'ROLLBACK_DROP_QUARANTINED'
    if main_status == 'TARGET' and drop_status == 'PREVIOUS' and esc is None and qua is not None:
        return 'ROLLBACK_DROP_RESTORED'
    raise Critical(f'AMBIGUOUS SSH pair: main={main_status} drop={drop_status} escrow={bool(esc)} quarantine={bool(qua)}')


def transaction(archive, workdir):
    lockfd = None
    rootfd = None
    stagefd = None
    root_identity = None
    stage = None
    parser_file = None
    target_main_stage = None
    target_drop_stage = None
    previous_main_stage = None
    escrow = None
    quarantine = None
    original = None
    target_main_desc = None
    target_drop_desc = None
    applied_main = False
    escrowed = False
    applied_drop = False
    reload_called = False
    mutated = False  # diagnostic only; never a safety/ownership oracle
    stage_inventory = None
    parser_owned = None
    previous_main_owned = None
    # These are proved source-rename consumptions, not mutation-status oracles.
    stage_main_consumed = False
    stage_drop_consumed = False
    commit_irreversible = False
    restored_main_desc = None
    try:
        # Fail closed if a second restore is already active; no lock taken inside backup lock elsewhere.
        lockfd = os.open(LOCK_FILE, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        ls = os.fstat(lockfd)
        require(stat.S_ISREG(ls.st_mode) and ls.st_uid == 0 and ls.st_gid == 0 and
                stat.S_IMODE(ls.st_mode) == 0o600 and ls.st_nlink == 1, 'unsafe SSH transaction lock')
        try:
            fcntl.flock(lockfd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Reject('another SSH transaction owns the domain lock')
        require(SSH_ROOT.is_dir() and not SSH_ROOT.is_symlink(), 'unsafe /etc/ssh root')
        require_safe_parents(SSH_ROOT)
        root_identity = owned_stat(SSH_ROOT)[1:3]
        rootfd = os.open(SSH_ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
        require((os.fstat(rootfd).st_dev, os.fstat(rootfd).st_ino) == root_identity,
                'SSH root changed during directory pin')
        require(external_absent(), 'Dateifreigabe root access window active; defer SSH restore')
        objects = target_archive(archive)
        original = stable_snapshot()
        parse_includes(file_desc(SSH_ROOT / MAIN)[2])
        for rel in original:
            if rel.startswith(DROP + '/') and rel.endswith('.conf'):
                parse_includes(file_desc(SSH_ROOT / rel)[2], dropin=True)
        require(external_absent(), 'Dateifreigabe became active during admission')
        stage = SSH_ROOT / fresh_name('stage')
        target_stage_desc = materialize(stage, objects)
        stage_inventory = inventory_objects(stage)
        parser_file = stage_parser_copy(stage, objects)
        stage_inventory = inventory_objects(stage)
        parser_owned = file_desc(parser_file)[:2]
        validate_parser(parser_file)
        # Do not unlink a substituted parser-only object, even if its bytes match.
        require(owned_entry(parser_file, parser_owned), 'FOREIGN SSH parser temporary file before unlink')
        os.unlink(parser_file)
        parser_file = None
        stage_inventory = inventory_objects(stage)
        target_main_stage = stage / MAIN
        target_drop_stage = stage / DROP
        stagefd = os.open(stage, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
        target_main_desc = file_desc(target_main_stage)[:2]
        target_drop_desc = snapshot_tree(stage)
        target_logical = logical({k:v for k,v in target_drop_desc.items() if k != MAIN})
        target_main_logical = logical({MAIN: target_main_desc})[MAIN]
        require(same_identity(stable_snapshot(), original), 'live SSH changed during admission')
        if logical(original) == logical(target_stage_desc):
            validate_live()
            require(same_identity(stable_snapshot(), original), 'same-state drift during validation')
            require(external_absent(), 'Dateifreigabe appeared before same-state completion')
            guarded_remove_owned_tree(stage, stage_inventory)
            stage = None
            # A private cleanup or result write is still a race opportunity.
            # Do not certify SAME_STATE from a stale pre-cleanup snapshot.
            require(same_identity(stable_snapshot(), original),
                    'SAME_STATE live drift after private cleanup')
            require(external_absent(), 'Dateifreigabe appeared during SAME_STATE cleanup')
            write_result(workdir, 'SAME_STATE', 'TARGET and PREVIOUS match; no writes or reload')
            require(same_identity(stable_snapshot(), original),
                    'SAME_STATE live drift during result reporting')
            require(external_absent(), 'Dateifreigabe appeared during SAME_STATE result reporting')
            emit('C29_SSH_R6_SAME_STATE=PASS; NO_REWRITE=YES; NO_RELOAD=YES')
            return 0
        # POSIX rename staging is on same mount, with exact descriptor checks before mutation.
        require(os.stat(stage).st_dev == os.stat(SSH_ROOT).st_dev, 'stage not on SSH mount')
        require(same_identity(stable_snapshot(), original), 'live PREVIOUS modified before APPLY')
        require(external_absent(), 'Dateifreigabe active before APPLY')
        # PREVIOUS main stored via own O_EXCL temp with exact metadata.
        previous_main_stage = SSH_ROOT / fresh_name('previous-main')
        old_item = (False, file_desc(SSH_ROOT / MAIN)[2], 0, 0,
                    original[MAIN][0][5], original[MAIN][0][7])
        fd = os.open(previous_main_stage, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, 'wb') as output:
            output.write(old_item[1])
            output.flush()
            os.fsync(output.fileno())
        set_meta(previous_main_stage, old_item)
        previous_main_owned = file_desc(previous_main_stage)[:2]
        require(logical({MAIN: previous_main_owned})[MAIN] == logical({MAIN:original[MAIN]})[MAIN],
                'previous main staging not exact')
        # These names are only created by this invocation, in /etc/ssh, and never followed.
        escrow = SSH_ROOT / fresh_name('previous-dropins')
        quarantine = SSH_ROOT / fresh_name('retired-target-dropins')
        require(same_identity(stable_snapshot(), original), 'PREVIOUS changed before main replace')
        require(owned_stat(SSH_ROOT)[1:3] == root_identity, 'SSH root pin drift before main replace')
        os.replace(MAIN, MAIN, src_dir_fd=stagefd, dst_dir_fd=rootfd)
        mutated = applied_main = True  # never authoritative in recovery
        require(own_object(file_desc(SSH_ROOT / MAIN)[:2], target_main_desc), 'main TARGET not owned after rename')
        stage_main_consumed = True
        require(same_identity(snapshot_tree()[DROP], original[DROP]), 'DROP changed before swap')
        require(external_absent(), 'Dateifreigabe changed after main swap')
        require(owned_stat(SSH_ROOT)[1:3] == root_identity, 'SSH root pin drift before dropin swap')
        rename_noreplace(DROP, escrow.name, src_dir_fd=rootfd, dst_dir_fd=rootfd)
        escrowed = True  # never authoritative in recovery
        require(escrow_matches_previous(escrow, original), 'PREVIOUS dropin escrow mismatch')
        require(not (SSH_ROOT / DROP).exists(), 'dropin destination changed during swap')
        require(external_absent(), 'Dateifreigabe changed during dropin swap')
        require(owned_stat(SSH_ROOT)[1:3] == root_identity, 'SSH root pin drift before target dropin move')
        rename_noreplace(DROP, DROP, src_dir_fd=stagefd, dst_dir_fd=rootfd)
        applied_drop = True  # never authoritative in recovery
        # Dropin inventory excluding main from stage, with meta/inodes matching staged descriptors.
        post = stable_snapshot()
        require(own_object(post[MAIN], target_main_desc), 'main TARGET ownership lost')
        require(logical({k:v for k,v in post.items() if k != MAIN}) == target_logical,
                'dropin TARGET not exact')
        require(own_tree({k:v for k,v in post.items() if k != MAIN},
                         {k:v for k,v in target_drop_desc.items() if k != MAIN}),
                'dropin TARGET ownership lost')
        stage_drop_consumed = True
        require(external_absent(), 'Dateifreigabe changed before native live validation')
        validate_live()
        require(same_identity(stable_snapshot(), post), 'TARGET changed during validation')
        reload_called = True
        service_reload()
        require(same_identity(stable_snapshot(), post), 'TARGET changed around reload')
        require(external_absent(), 'Dateifreigabe changed after reload')
        # Commit preparation is reversible; once PREVIOUS objects are released,
        # post-commit failures are CRITICAL and NEVER treated as rollbackable.
        require(classify_live(original, target_main_desc, target_drop_desc,
                              escrow, quarantine, root_identity, restored_main_desc) == 'TARGET_APPLIED',
                'TARGET ownership missing before commit cleanup')
        # Stage may now contain only an empty owned directory; do not rmtree arbitrary foreign data.
        guarded_remove_owned_tree(stage, expected_stage_remainder(
            stage_inventory, main_consumed=True, drop_consumed=True),
            stage_root_mtime_mutated=True)
        stage = None
        require(same_identity(stable_snapshot(), post), 'TARGET changed during stage cleanup')
        require(external_absent(), 'Dateifreigabe changed during stage cleanup')
        write_result(workdir, 'COMMIT_PREPARED', 'TARGET verified; irreversible cleanup next')
        commit_irreversible = True
        # Escrow's known inode/content is checked per object; a foreign new child
        # cannot be recursively erased by shutil.rmtree.
        escrow_inventory = {'.': (original[DROP][0], None)}
        for rel, desc in original.items():
            if rel.startswith(DROP + '/'):
                escrow_inventory[rel[len(DROP)+1:]] = desc
        guarded_remove_owned_tree(escrow, escrow_inventory)
        escrowed = False
        require(same_identity(stable_snapshot(), post), 'TARGET changed during irreversible Escrow cleanup')
        require(external_absent(), 'Dateifreigabe changed during irreversible Escrow cleanup')
        require(previous_main_stage is not None and previous_main_owned is not None and
                owned_entry(previous_main_stage, previous_main_owned) and
                logical({MAIN: previous_main_owned})[MAIN] ==
                logical({MAIN: original[MAIN]})[MAIN], 'FOREIGN PREVIOUS main temp at commit')
        os.unlink(previous_main_stage)
        previous_main_stage = None
        require(same_identity(stable_snapshot(), post), 'TARGET changed after PREVIOUS main cleanup')
        require(external_absent(), 'Dateifreigabe changed after PREVIOUS main cleanup')
        write_result(workdir, 'COMMITTED', 'TARGET_FILES_EXACT; reload requested; daemon completion not proven')
        # Recheck after final reporting I/O; a detected post-commit drift is CRITICAL.
        require(same_identity(stable_snapshot(), post), 'TARGET changed during COMMITTED result write')
        require(external_absent(), 'Dateifreigabe changed during COMMITTED result write')
        service_active_gate()
        # A health probe is only a momentary observation and cannot prove HUP completion.
        emit('SERVICE_ACTIVE_AT_FINAL_GATE=YES')
        emit('TARGET_FILES_EXACT=YES')
        emit('NATIVE_VALIDATION_PASS=YES')
        emit('C29_SSH_R6_COMMIT=PASS')
        return 0
    except BaseException as exc:
        reason = str(exc)
        # After the first irreversible COMMIT cleanup action, NEVER attempt a
        # pretend PREVIOUS rollback. A post-commit reporting error is CRITICAL.
        if commit_irreversible:
            try:
                write_result(workdir, 'CRITICAL', 'IRREVERSIBLE_COMMIT_CLEANUP: '+reason)
            except BaseException:
                pass
            emit('CRITICAL C29_SSH_R6=irreversible commit cleanup: '+reason, file=sys.stderr)
            return 78
        try:
            # If no previous snapshot was captured, no live SSH mutation can have
            # been started by this transaction.
            state = ('NO_APPLY' if original is None else
                     classify_live(original, target_main_desc, target_drop_desc,
                                   escrow, quarantine, root_identity, restored_main_desc))
            if state in ('NO_APPLY', 'PREVIOUS') and not mutated:
                # Pre-apply cleanup MUST prove ownership (no Path.exists on a
                # dangling symlink and no recursive deleting of foreign trees).
                if stage is not None and path_state(stage) is not None:
                    if stage_inventory is None:
                        raise Critical('incomplete stage identity; cannot prove pre-apply cleanup')
                    guarded_remove_owned_tree(stage, stage_inventory)
                    stage = None
                if previous_main_stage is not None and path_state(previous_main_stage) is not None:
                    require(previous_main_owned is not None and
                            owned_entry(previous_main_stage, previous_main_owned) and
                            logical({MAIN:previous_main_owned})[MAIN] == logical({MAIN:original[MAIN]})[MAIN],
                            'FOREIGN PREVIOUS main temp at pre-apply cleanup')
                    os.unlink(previous_main_stage)
                    previous_main_stage = None
                # REFUSED means this invocation made no live SSH APPLY.
                # If PREVIOUS was captured, also prove it still holds after
                # cleanup and after result I/O; otherwise do not claim it.
                if original is not None:
                    require(same_identity(stable_snapshot(), original),
                            'REFUSED live PREVIOUS changed during cleanup')
                    require(external_absent(), 'Dateifreigabe appeared during REFUSED cleanup')
                write_result(workdir, 'REFUSED', reason)
                if original is not None:
                    require(same_identity(stable_snapshot(), original),
                            'REFUSED live PREVIOUS changed during result reporting')
                    require(external_absent(), 'Dateifreigabe appeared during REFUSED result reporting')
                emit('C29_SSH_R6_REFUSED='+reason, file=sys.stderr)
                return 20
            # An unsuccessful mutating operation may already have modified LIVE.
            # Reconstruct every phase from actual file identities, then roll back.
            require(original is not None and target_main_desc is not None,
                    'cannot classify changed SSH state')
            require(external_absent(), 'foreign external SSH Include during rollback')
            for attempt in range(8):
                state = classify_live(original, target_main_desc, target_drop_desc,
                                      escrow, quarantine, root_identity, restored_main_desc)
                # Prove the rename consumed a staged object from the observed
                # live/escrow/quarantine identity before allowing absence there.
                if state in ('MAIN_APPLIED', 'DROP_ESCROWED', 'TARGET_APPLIED',
                             'ROLLBACK_DROP_QUARANTINED', 'ROLLBACK_DROP_RESTORED'):
                    stage_main_consumed = True
                if state in ('TARGET_APPLIED', 'ROLLBACK_DROP_QUARANTINED',
                             'ROLLBACK_DROP_RESTORED'):
                    stage_drop_consumed = True
                if state == 'PREVIOUS':
                    break
                try:
                    if state == 'TARGET_APPLIED':
                        rename_noreplace(DROP, quarantine.name, src_dir_fd=rootfd, dst_dir_fd=rootfd)
                    elif state == 'ROLLBACK_DROP_QUARANTINED':
                        require(path_state(SSH_ROOT / DROP) is None,
                                'foreign Drop after quarantine')
                        rename_noreplace(escrow.name, DROP, src_dir_fd=rootfd, dst_dir_fd=rootfd)
                    elif state == 'DROP_ESCROWED':
                        require(path_state(SSH_ROOT / DROP) is None,
                                'foreign Drop in escrow gap')
                        rename_noreplace(escrow.name, DROP, src_dir_fd=rootfd, dst_dir_fd=rootfd)
                    elif state in ('MAIN_APPLIED', 'ROLLBACK_DROP_RESTORED'):
                        require(previous_main_stage is not None and
                                previous_main_owned is not None and
                                owned_entry(previous_main_stage, previous_main_owned) and
                                logical({MAIN:previous_main_owned})[MAIN] ==
                                logical({MAIN:original[MAIN]})[MAIN],
                                'PREVIOUS main backup drift')
                        restored_main_desc = previous_main_owned
                        os.replace(previous_main_stage.name, MAIN, src_dir_fd=rootfd, dst_dir_fd=rootfd)
                    else:
                        raise Critical('unexpected recovery state ' + state)
                except (InterruptedError, OSError) as recovery_error:
                    # A syscall may have succeeded before a caught signal was
                    # raised. Reclassify live objects instead of trusting flags.
                    emit('SSH_R6_RECOVERY_RENAME_RECLASSIFY=' + type(recovery_error).__name__)
                    continue
            else:
                raise Critical('rollback transition bound exceeded')
            require(classify_live(original, target_main_desc, target_drop_desc,
                                  escrow, quarantine, root_identity, restored_main_desc) == 'PREVIOUS',
                    'PREVIOUS state not restored')
            require(logical(stable_snapshot()) == logical(original), 'PREVIOUS not exact')
            validate_live()
            if reload_called:
                service_reload()
            require(logical(stable_snapshot()) == logical(original), 'PREVIOUS changed after reload')
            if quarantine is not None and path_state(quarantine) is not None:
                qinventory = {'.': (target_drop_desc[DROP][0],None)}
                for rel, desc in target_drop_desc.items():
                    if rel.startswith(DROP + '/'):
                        qinventory[rel[len(DROP)+1:]] = desc
                guarded_remove_owned_tree(quarantine, qinventory)
            if stage is not None and path_state(stage) is not None:
                if stage_inventory is None:
                    raise Critical('stage cleanup ownership unknown')
                guarded_remove_owned_tree(stage, expected_stage_remainder(
                    stage_inventory, main_consumed=stage_main_consumed,
                    drop_consumed=stage_drop_consumed),
                    stage_root_mtime_mutated=(stage_main_consumed or stage_drop_consumed))
            if previous_main_stage is not None and path_state(previous_main_stage) is not None:
                # If rename already consumed it, it is absent; otherwise verify it.
                require(previous_main_owned is not None and
                        owned_entry(previous_main_stage, previous_main_owned) and
                        logical({MAIN:previous_main_owned})[MAIN] ==
                        logical({MAIN:original[MAIN]})[MAIN], 'FOREIGN PREVIOUS backup at rollback cleanup')
                os.unlink(previous_main_stage)
            # A proved restoration before deleting private recovery artifacts
            # is not a proved restoration at the end of that cleanup.
            require(classify_live(original, target_main_desc, target_drop_desc,
                                  escrow, quarantine, root_identity, restored_main_desc) == 'PREVIOUS',
                    'PREVIOUS ownership lost during rollback cleanup')
            require(logical(stable_snapshot()) == logical(original),
                    'PREVIOUS changed during rollback cleanup')
            require(external_absent(), 'Dateifreigabe appeared during rollback cleanup')
            write_result(workdir, 'ROLLED_BACK', reason + '; reload completion not proven')
            require(classify_live(original, target_main_desc, target_drop_desc,
                                  escrow, quarantine, root_identity, restored_main_desc) == 'PREVIOUS',
                    'PREVIOUS ownership lost during rollback result write')
            require(logical(stable_snapshot()) == logical(original),
                    'PREVIOUS changed during rollback result write')
            require(external_absent(), 'Dateifreigabe appeared during rollback result write')
            if reload_called:
                service_active_gate()
            emit('C29_SSH_R6_ROLLBACK=PASS; PREVIOUS_EXACT=YES; RELOAD_COMPLETION_NOT_PROVEN=YES')
            return 74
        except BaseException as rollback_exc:
            try:
                write_result(workdir, 'CRITICAL', reason + '; rollback: ' + str(rollback_exc))
            except BaseException:
                pass
            emit('CRITICAL C29_SSH_R6=' + reason + '; recovery=' + str(rollback_exc), file=sys.stderr)
            return 78
    finally:
        # CRITICAL outcomes preserve remaining staged objects as forensic evidence.
        if stagefd is not None:
            os.close(stagefd)
        if rootfd is not None:
            os.close(rootfd)
        if lockfd is not None:
            os.close(lockfd)


def main():
    if len(sys.argv) != 3:
        raise SystemExit('usage: ssh_tx_r6_helper.py PROTECTED_ETC_HOST_TAR_GZ WORKDIR')
    archive = Path(sys.argv[1])
    workdir = Path(sys.argv[2])
    if os.geteuid() != 0:
        raise SystemExit('C29 SSH R6 requires root')
    if not archive.is_file() or archive.is_symlink() or not workdir.is_dir():
        raise SystemExit('C29 SSH R6 invalid protected backup/workdir')
    signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(InterruptedError('SIGTERM during SSH transaction')))
    signal.signal(signal.SIGHUP, lambda *_: (_ for _ in ()).throw(InterruptedError('SIGHUP during SSH transaction')))
    signal.signal(signal.SIGINT, lambda *_: (_ for _ in ()).throw(InterruptedError('SIGINT during SSH transaction')))
    raise SystemExit(transaction(archive, workdir))


if __name__ == '__main__':
    main()

C29_SSH_R6_EMBEDDED_PYTHON
    then
        end_restore_session_critical "Could not stage embedded SSH helper."
        pause
        return 0
    fi
    chmod 600 "${helper}"
    if python3 -B "${helper}" "${RESTORE_BACKUP}/etc-host.tar.gz" "${WORKDIR}"; then
        echo "C29 SSH R6 transaction finished (TARGET or SAME_STATE)."
        echo "NOTE: HUP reload request acceptance does not establish completed daemon reconfiguration."
        end_restore_session
    else
        rc=$?
        case "${rc}" in
            20)
                echo "C29 SSH R6: admission refused; no SSH APPLY by this invocation; current LIVE is not guaranteed after return." >&2
                end_restore_session
                ;;
            74)
                echo "C29 SSH R6: PREVIOUS restored and verified in helper; no TARGET commit." >&2
                end_restore_session
                ;;
            *)
                end_restore_session_critical \
                    "C29 SSH R6 critical/uncertain state (helper rc=${rc}). Preserve session evidence; keep SSH access and IPMI ready."
                ;;
        esac
    fi
    pause
}


restore_network() {
    local archive=""
    local old_interfaces=""
    local old_interfaces_new=""
    local old_interfaces_d=""
    local old_pinning=""
    local had_interfaces=0
    local had_interfaces_new=0
    local had_interfaces_d=0
    local had_pinning=0
    local backup_has_interfaces_d=0
    local backup_has_pinning=0
    local pinning_changed=0
    local apply=""
    local concurrent_validation=0
    local validated_network_tree=""
    local precheck_reason=""
    local target_pinning_root=""
    local state_file=""
    local state_before=""
    local runtime_state_changed=0
    local foreign_file_drift=0
    local late_runtime_drift=0
    local own_live_apply=0
    local user_selected_no_apply=0
    local connectivity_previous_profile=""
    local connectivity_target_profile=""
    local connectivity_previous_ready=0
    local connectivity_target_ready=0
    local connectivity_previous_reason=""
    local connectivity_target_reason=""
    local connectivity_target_state_after=""
    local connectivity_health_rc=0
    local connectivity_foreign_drift=0
    local connectivity_target_failure_reason=""

    verify_backup

    if ! require_commands_for_operation ifquery ifreload diff ip mount python3 unshare readlink stat; then
        echo "Network restore is refused because the required validation tools are not available." >&2
        pause
        return 0
    fi

    if [[ ! -d /etc/network || -L /etc/network ]]; then
        echo "Network restore is refused because /etc/network must be a real directory (not a symlink)." >&2
        echo "This is an isolation prerequisite for C-26 validation." >&2
        pause
        return 0
    fi

    if ! network_live_restore_objects_safe; then
        echo "Network restore is refused because the current restore-object layout cannot be snapshotted and rolled back exactly." >&2
        pause
        return 0
    fi

    if ! backup_members_present "${BACKUP}/etc-host.tar.gz" "etc/network/interfaces"; then
        echo "Network restore is not possible from this backup. Nothing was changed." >&2
        pause
        return 0
    fi

    echo
    echo "This restores the Proxmox host network configuration."
    echo "It handles /etc/network/interfaces, interfaces.d"
    echo "and local systemd interface-pinning files when present."
    echo "A pending /etc/network/interfaces.new is deliberately NOT restored."
    echo "Applying network changes can disconnect SSH. IPMI/console access should be available."

    confirm_word "Restore network configuration from ${BACKUP}?" "RESTORE" || { cancelled; return 0; }

    echo
    echo "Pre-restore diagnostic of the CURRENT network files (advisory only)..."
    if network_pre_restore_advisory; then
        echo "Current network files passed the C-26/C-27 validation."
    else
        precheck_reason="${NETWORK_VALIDATION_REASON}"
        case "${precheck_reason}" in
            busy|lock-unavailable)
                echo "Network restore is refused because ifupdown2 locking could not be resolved safely." >&2
                echo "No restore session or pre-restore snapshot was started." >&2
                pause
                return 0
                ;;
            isolation)
                echo "Network restore is refused because the private validation environment could not be established safely." >&2
                echo "No restore session or pre-restore snapshot was started." >&2
                pause
                return 0
                ;;
            *)
                echo >&2
                echo "WARNING: The CURRENT live network files do not pass the validator." >&2
                echo "This does not prove that the selected backup is bad, so emergency recovery is still allowed." >&2
                echo "If a later live apply fails, rollback returns to these pre-restore files and may itself require IPMI/console recovery." >&2
                confirm_word "Continue with the restore despite the current-file diagnostic?" "CONTINUE" \
                    || { cancelled; return 0; }
                ;;
        esac
    fi

    if ! acquire_pve_network_config_lock; then
        pause
        return 0
    fi

    if ! begin_restore_session network_backup_pre_snapshot_preflight; then
        release_pve_network_config_lock
        pause
        return 0
    fi

    archive="${RESTORE_BACKUP}/etc-host.tar.gz"
    new_workdir

    old_interfaces="${WORKDIR}/current-interfaces"
    old_interfaces_new="${WORKDIR}/current-interfaces.new"
    old_interfaces_d="${WORKDIR}/current-interfaces.d"
    old_pinning="${WORKDIR}/current-systemd-network"
    validated_network_tree="${WORKDIR}/validated-etc-network"
    connectivity_previous_profile="${WORKDIR}/network-connectivity-previous.profile"
    connectivity_target_profile="${WORKDIR}/network-connectivity-target.profile"

    if [[ -e /etc/network/interfaces || -L /etc/network/interfaces ]]; then
        cp -a -- /etc/network/interfaces "${old_interfaces}"
        had_interfaces=1
    fi

    if [[ -e /etc/network/interfaces.new || -L /etc/network/interfaces.new ]]; then
        cp -a -- /etc/network/interfaces.new "${old_interfaces_new}"
        had_interfaces_new=1
    fi

    if [[ -e /etc/network/interfaces.d || -L /etc/network/interfaces.d ]]; then
        cp -a -- /etc/network/interfaces.d "${old_interfaces_d}"
        had_interfaces_d=1
    fi

    if [[ -e /usr/local/lib/systemd/network || -L /usr/local/lib/systemd/network ]]; then
        cp -a -- /usr/local/lib/systemd/network "${old_pinning}"
        had_pinning=1
    fi

    extract_member "${archive}" "etc/network/interfaces"

    if archive_has_prefix "${archive}" "etc/network/interfaces.d"; then
        extract_tree "${archive}" "etc/network/interfaces.d"
        backup_has_interfaces_d=1
    fi

    if archive_has_prefix "${archive}" "usr/local/lib/systemd/network"; then
        extract_tree "${archive}" "usr/local/lib/systemd/network"
        backup_has_pinning=1
    fi

    # Top-level restored objects used by this operation must have the expected
    # types. Refuse symlinked staged objects before the first live write.
    if [[ ! -f "${WORKDIR}/etc/network/interfaces" || -L "${WORKDIR}/etc/network/interfaces" ]]; then
        echo "Backup network restore is refused: staged etc/network/interfaces is not a regular non-symlink file." >&2
        end_restore_session
        pause
        return 0
    fi
    if (( backup_has_interfaces_d == 1 )) \
        && { [[ ! -d "${WORKDIR}/etc/network/interfaces.d" ]] || [[ -L "${WORKDIR}/etc/network/interfaces.d" ]]; }; then
        echo "Backup network restore is refused: staged interfaces.d is not a real directory." >&2
        end_restore_session
        pause
        return 0
    fi
    if (( backup_has_pinning == 1 )) \
        && { [[ ! -d "${WORKDIR}/usr/local/lib/systemd/network" ]] || [[ -L "${WORKDIR}/usr/local/lib/systemd/network" ]]; }; then
        echo "Backup network restore is refused: staged systemd network pinning is not a real directory." >&2
        end_restore_session
        pause
        return 0
    fi

    if (( backup_has_pinning == 1 )); then
        if (( had_pinning == 0 )); then
            pinning_changed=1
        elif ! network_path_matches_snapshot \
            "${old_pinning}" "${WORKDIR}/usr/local/lib/systemd/network" 1; then
            pinning_changed=1
        fi
        target_pinning_root="${WORKDIR}/usr/local/lib/systemd/network"
    elif (( had_pinning == 1 )); then
        pinning_changed=1
    fi

    if network_connectivity_capture_previous_profile "${connectivity_previous_profile}"; then
        connectivity_previous_ready=1
        network_connectivity_record "PREVIOUS management profile captured"
    else
        connectivity_previous_reason="${NETWORK_CONNECTIVITY_PROFILE_REASON:-unsupported current management topology}"
        network_connectivity_record "PREVIOUS management profile unavailable: ${connectivity_previous_reason}"
    fi

    state_file="$(network_state_file_path)" || {
        echo "Could not determine ifupdown2's state file before changing network files." >&2
        end_restore_session
        pause
        return 0
    }
    state_before="$(network_state_fingerprint "${state_file}")" || {
        echo "Could not fingerprint ifupdown2 state before changing network files: ${state_file}" >&2
        end_restore_session
        pause
        return 0
    }

    if ! command -v ping >/dev/null 2>&1 || ! command -v timeout >/dev/null 2>&1; then
        if (( connectivity_previous_ready == 1 )); then
            connectivity_previous_ready=0
            connectivity_previous_reason="C-28 runtime probes require the already-installed ping and timeout commands; no package is installed automatically"
            network_connectivity_record "PREVIOUS management profile cannot be armed: ${connectivity_previous_reason}"
        fi
    fi

    if (( connectivity_previous_ready == 1 )); then
        if network_connectivity_health_once "${connectivity_previous_profile}"; then
            network_connectivity_record "PREVIOUS baseline management health confirmed"
        else
            connectivity_previous_ready=0
            connectivity_previous_reason="PREVIOUS baseline management health failed at ${NETWORK_HEALTH_LAST_REASON:-unknown}"
            network_connectivity_record "PREVIOUS management profile cannot be armed: ${connectivity_previous_reason}"
        fi
    fi

    if (( connectivity_previous_ready == 1 )); then
        if [[ "$(network_state_fingerprint "${state_file}" 2>/dev/null || printf 'UNREADABLE\n')" != "${state_before}" ]]; then
            connectivity_previous_ready=0
            connectivity_previous_reason="ifupdown2 runtime changed while the PREVIOUS management baseline was being qualified"
            network_connectivity_record "PREVIOUS management profile cannot be armed: ${connectivity_previous_reason}"
        fi
    fi

    if ! network_install_staged_tree "${WORKDIR}" "${backup_has_interfaces_d}" "${backup_has_pinning}"; then
        echo "Writing the staged network files failed. Rolling back..." >&2
        if (( NETWORK_RESTORE_PATH_CONCURRENT == 1 )); then
            if network_preserve_concurrent_state; then
                echo "Concurrent network-file state was preserved before rollback." >&2
            else
                echo "WARNING: Concurrent network-file state was detected, but it could not be copied completely before rollback." >&2
            fi
        fi
        if network_rollback_previous_tree \
            "${old_interfaces}" "${had_interfaces}" \
            "${old_interfaces_new}" "${had_interfaces_new}" \
            "${old_interfaces_d}" "${had_interfaces_d}" \
            "${old_pinning}" "${had_pinning}"; then
            if [[ -n "${NETWORK_RESTORE_PATH_CONFLICT_STAGING}" ]]; then
                rm -rf -- "${NETWORK_RESTORE_PATH_CONFLICT_STAGING}" || true
                NETWORK_RESTORE_PATH_CONFLICT_STAGING=""
            fi
            echo "Rollback completed: previous network file objects and contents were restored."
            end_restore_session
        else
            end_restore_session_critical \
                "Writing the staged network files failed and the previous network files could not be restored exactly. Use IPMI/console before making further network changes."
        fi
        pause
        return 0
    fi

    # Capture the exact candidate first, then validate THAT immutable tree.
    # This closes the former capture-after-validation window.
    if ! network_capture_validated_tree "${validated_network_tree}"; then
        echo "Could not capture the network candidate before validation. Rolling back..." >&2
        if network_rollback_previous_tree \
            "${old_interfaces}" "${had_interfaces}" \
            "${old_interfaces_new}" "${had_interfaces_new}" \
            "${old_interfaces_d}" "${had_interfaces_d}" \
            "${old_pinning}" "${had_pinning}"; then
            echo "Rollback completed: previous network file objects and contents were restored."
            end_restore_session
        else
            end_restore_session_critical \
                "Candidate capture failed and the previous network files could not be restored exactly. Use IPMI/console."
        fi
        pause
        return 0
    fi

    # Validate without applying. ifquery and the synthetic -s pass both read
    # the captured candidate; only the throw-away copy receives the reviewed
    # C-26 fd 0 -> 2 and C-27 bridge-MTU neutralizations.
    if ! validate_network_config "${validated_network_tree}" "${target_pinning_root}" "${pinning_changed}"; then
        concurrent_validation="${NETWORK_VALIDATION_CONCURRENT}"
        if [[ "$(network_state_fingerprint "${state_file}" 2>/dev/null || printf 'UNREADABLE\n')" != "${state_before}" ]]; then
            runtime_state_changed=1
        fi
        echo "Restored network configuration failed validation. Rolling back..." >&2

        if ! network_validated_tree_unchanged "${validated_network_tree}" \
            || ! network_restored_state_matches_stage "${WORKDIR}" "${backup_has_interfaces_d}" "${backup_has_pinning}"; then
            foreign_file_drift=1
            if network_preserve_concurrent_state; then
                echo "Concurrent network-file changes were detected; their live state was retained with the rollback data." >&2
            else
                echo "WARNING: Concurrent network-file changes were detected, but their live state could not be copied completely." >&2
            fi
        fi

        if ! network_rollback_previous_tree \
            "${old_interfaces}" "${had_interfaces}" \
            "${old_interfaces_new}" "${had_interfaces_new}" \
            "${old_interfaces_d}" "${had_interfaces_d}" \
            "${old_pinning}" "${had_pinning}"; then
            end_restore_session_critical \
                "Network validation failed and the previous network files could not be restored exactly. Use IPMI/console before making further network changes."
            pause
            return 0
        fi

        if (( foreign_file_drift == 1 && concurrent_validation == 0 && runtime_state_changed == 0 )); then
            end_restore_session_critical \
                "Concurrent network-file changes were preserved in the rollback data. Previous files were restored; manual reconciliation is required."
            pause
            return 0
        fi

        if (( concurrent_validation == 1 || runtime_state_changed == 1 )); then
            if (( runtime_state_changed == 1 )); then
                echo "ifupdown2 runtime state changed while restored files were installed; a foreign live apply may have occurred." >&2
            else
                echo "Concurrent ifupdown2 activity was detected while validating the restored files." >&2
            fi
            echo "The previous files are restored; re-applying them to re-establish the known live state..." >&2
            if network_connectivity_reapply_previous_and_confirm \
                "${connectivity_previous_profile}" "${state_file}" \
                "${old_interfaces}" "${had_interfaces}" \
                "${old_interfaces_new}" "${had_interfaces_new}" \
                "${old_interfaces_d}" "${had_interfaces_d}" \
                "${old_pinning}" "${had_pinning}"; then
                network_connectivity_terminal_notice "Rollback files were restored exactly, re-applied and C-28 health-confirmed."
                if (( foreign_file_drift == 1 )); then
                    end_restore_session_critical \
                        "Concurrent file changes were preserved in the rollback data; the previous network was re-applied and health-confirmed, but manual reconciliation is required."
                else
                    end_restore_session
                fi
            else
                end_restore_session_critical \
                    "Previous network files were restored exactly, but C-28 could not prove the previous management runtime after the concurrency incident (${NETWORK_CONNECTIVITY_WAIT_REASON:-unknown}). Use IPMI/console immediately."
            fi
        else
            echo "Rollback completed: previous network file objects and contents match the pre-restore snapshots."
            echo "No live network apply had been performed by this restore."
            end_restore_session
        fi

        pause
        return 0
    fi

    if [[ "$(network_state_fingerprint "${state_file}" 2>/dev/null || printf 'UNREADABLE\n')" != "${state_before}" ]]; then
        runtime_state_changed=1
    fi

    if (( NETWORK_VALIDATION_CONCURRENT == 1 || runtime_state_changed == 1 )); then
        if (( runtime_state_changed == 1 )); then
            echo "ifupdown2 runtime state changed while the restored files were installed; rolling back conservatively..." >&2
        else
            echo "Concurrent ifupdown2 activity occurred while the restored files were installed." >&2
        fi
        echo "The restore cannot prove that the runtime network remained untouched; rolling back conservatively..." >&2
        if ! network_validated_tree_unchanged "${validated_network_tree}" \
            || ! network_restored_state_matches_stage "${WORKDIR}" "${backup_has_interfaces_d}" "${backup_has_pinning}"; then
            foreign_file_drift=1
            if network_preserve_concurrent_state; then
                echo "Concurrent network-file changes were detected; their live state was retained with the rollback data." >&2
            else
                echo "WARNING: Concurrent network-file changes were detected, but their live state could not be copied completely." >&2
            fi
        fi
        if ! network_rollback_previous_tree \
            "${old_interfaces}" "${had_interfaces}" \
            "${old_interfaces_new}" "${had_interfaces_new}" \
            "${old_interfaces_d}" "${had_interfaces_d}" \
            "${old_pinning}" "${had_pinning}"; then
            end_restore_session_critical \
                "Concurrent ifupdown2 activity occurred and the previous network files could not be restored exactly. Use IPMI/console immediately."
            pause
            return 0
        fi

        if network_connectivity_reapply_previous_and_confirm \
            "${connectivity_previous_profile}" "${state_file}" \
            "${old_interfaces}" "${had_interfaces}" \
            "${old_interfaces_new}" "${had_interfaces_new}" \
            "${old_interfaces_d}" "${had_interfaces_d}" \
            "${old_pinning}" "${had_pinning}"; then
            network_connectivity_terminal_notice "Previous network files were restored, re-applied and C-28 health-confirmed after the concurrency incident."
            if (( foreign_file_drift == 1 )); then
                end_restore_session_critical \
                    "Concurrent file changes were preserved in the rollback data; previous networking was re-applied and health-confirmed, but manual reconciliation is required."
            else
                end_restore_session
            fi
        else
            end_restore_session_critical \
                "Concurrent ifupdown2 activity occurred; previous files are restored exactly, but C-28 could not prove the previous management runtime (${NETWORK_CONNECTIVITY_WAIT_REASON:-unknown}). Use IPMI/console immediately."
        fi
        pause
        return 0
    fi

    if ! network_restored_state_matches_stage "${WORKDIR}" "${backup_has_interfaces_d}" "${backup_has_pinning}" \
        || ! network_validated_tree_unchanged "${validated_network_tree}"; then
        end_restore_session_critical \
            "Network files changed during validation; the candidate is not reported as successfully validated. Inspect preserved rollback data before continuing."
        pause
        return 0
    fi

    network_detect_stp_transition "${WORKDIR}/network-candidate-model.out"

    if network_connectivity_build_target_profile "${WORKDIR}/network-candidate-model.out" "${connectivity_target_profile}"; then
        connectivity_target_ready=1
        network_connectivity_record "TARGET management profile derived from validated candidate"
    else
        connectivity_target_reason="${NETWORK_CONNECTIVITY_PROFILE_REASON:-unsupported target management topology}"
        network_connectivity_record "TARGET management profile unavailable: ${connectivity_target_reason}"
    fi

    if (( connectivity_previous_ready == 0 || connectivity_target_ready == 0 )); then
        NETWORK_LIVE_APPLY_BLOCKED=1
        if [[ -n "${NETWORK_LIVE_APPLY_BLOCK_REASON}" ]]; then
            NETWORK_LIVE_APPLY_BLOCK_REASON+=" "
        fi
        NETWORK_LIVE_APPLY_BLOCK_REASON+="C-28 live apply is unavailable because the management path cannot be proven safely:"
        if (( connectivity_previous_ready == 0 )); then
            NETWORK_LIVE_APPLY_BLOCK_REASON+=" PREVIOUS: ${connectivity_previous_reason}."
        fi
        if (( connectivity_target_ready == 0 )); then
            NETWORK_LIVE_APPLY_BLOCK_REASON+=" TARGET: ${connectivity_target_reason}."
        fi
        NETWORK_LIVE_APPLY_BLOCK_REASON+=" Use the controlled reboot path instead."
    fi

    echo
    echo "Network configuration files restored and validated successfully."

    if (( pinning_changed == 1 || NETWORK_LIVE_APPLY_BLOCKED == 1 )); then
        echo
        if (( pinning_changed == 1 )); then
            echo "Interface-pinning files differ from the currently active state."
            echo "A live ifreload is intentionally NOT offered because .link name changes require a reboot."
            echo "If firewall or SDN rules reference physical interface names, verify/restore those rules from the same backup before rebooting."
        fi
        if (( NETWORK_LIVE_APPLY_BLOCKED == 1 )); then
            echo "${NETWORK_LIVE_APPLY_BLOCK_REASON}"
        fi

        if ! network_restored_state_matches_stage "${WORKDIR}" "${backup_has_interfaces_d}" "${backup_has_pinning}" \
            || ! network_validated_tree_unchanged "${validated_network_tree}"; then
            end_restore_session_critical \
                "Network files changed after successful validation. No live apply was attempted; inspect the current files and preserved rollback data before rebooting."
            pause
            return 0
        fi
        if [[ "$(network_state_fingerprint "${state_file}" 2>/dev/null || printf 'UNREADABLE\n')" != "${state_before}" ]]; then
            late_runtime_drift=1
        else
            echo "Use IPMI/console and perform a controlled reboot when ready."
        fi
    else
        while true; do
            echo
            echo "1) Apply /etc/network/interfaces now with ifreload -a"
            echo "2) Do not apply now; leave files restored for a controlled reboot"
            read -r -p "Select [1/2]: " apply

            case "${apply}" in
                1)
                    # Close the validation-to-use race. The Proxmox config lock
                    # blocks normal GUI edits, while this exact comparison also
                    # catches Apply/manual/other changes that do not use it.
                    if ! network_restored_state_matches_stage "${WORKDIR}" "${backup_has_interfaces_d}" "${backup_has_pinning}" \
                        || ! network_validated_tree_unchanged "${validated_network_tree}"; then
                        end_restore_session_critical \
                            "Network files changed after validation; the unvalidated files were NOT applied live. Do not overwrite them automatically - inspect for concurrent GUI/manual changes and use IPMI/console if needed."
                        pause
                        return 0
                    fi
                    if [[ "$(network_state_fingerprint "${state_file}" 2>/dev/null || printf 'UNREADABLE\n')" != "${state_before}" ]]; then
                        late_runtime_drift=1
                        break
                    fi
                    # Check files once more after the runtime marker so a manual
                    # writer in the preceding check window is not fed to ifreload.
                    if ! network_restored_state_matches_stage "${WORKDIR}" "${backup_has_interfaces_d}" "${backup_has_pinning}" \
                        || ! network_validated_tree_unchanged "${validated_network_tree}"; then
                        end_restore_session_critical \
                            "Network files changed immediately before live apply; they were NOT applied by this restore. Inspect concurrent GUI/manual changes."
                        pause
                        return 0
                    fi

                    network_connectivity_record "TARGET live apply starting"
                    if ! run_network_live_apply || (( NETWORK_IFRELOAD_DIAGNOSTIC == 1 )); then
                        if (( NETWORK_IFRELOAD_DIAGNOSTIC == 1 && NETWORK_IFRELOAD_RC == 0 )); then
                            connectivity_target_failure_reason="ifreload returned rc=0 with error/Traceback diagnostics"
                        else
                            connectivity_target_failure_reason="ifreload failed rc=${NETWORK_IFRELOAD_RC}"
                        fi
                        network_connectivity_record "TARGET ${connectivity_target_failure_reason}; automatic PREVIOUS rollback starting"

                        if ! network_rollback_previous_tree \
                            "${old_interfaces}" "${had_interfaces}" \
                            "${old_interfaces_new}" "${had_interfaces_new}" \
                            "${old_interfaces_d}" "${had_interfaces_d}" \
                            "${old_pinning}" "${had_pinning}"; then
                            end_restore_session_critical \
                                "Network live apply was rejected (${connectivity_target_failure_reason}) and the previous network files could not be restored exactly. The failed live state may still be active; use IPMI/console immediately."
                            pause
                            return 0
                        fi

                        # A failed or diagnostically untrusted live apply may have
                        # changed kernel state before returning. Re-apply and
                        # health-confirm PREVIOUS locally; this path must not
                        # depend on the original SSH session.
                        if network_connectivity_reapply_previous_and_confirm \
                            "${connectivity_previous_profile}" "${state_file}" \
                            "${old_interfaces}" "${had_interfaces}" \
                            "${old_interfaces_new}" "${had_interfaces_new}" \
                            "${old_interfaces_d}" "${had_interfaces_d}" \
                            "${old_pinning}" "${had_pinning}"; then
                            network_connectivity_record "PREVIOUS rollback health-confirmed after TARGET live-apply rejection"
                            end_restore_session
                            network_connectivity_terminal_notice "Network live apply was rejected (${connectivity_target_failure_reason}); previous networking was restored and C-28 health-confirmed."
                        else
                            end_restore_session_critical \
                                "Network live apply was rejected (${connectivity_target_failure_reason}); previous files are restored exactly, but C-28 could not prove the previous management runtime (${NETWORK_CONNECTIVITY_WAIT_REASON:-unknown}). Use IPMI/console immediately."
                        fi
                        pause
                        return 0
                    fi

                    connectivity_target_state_after="$(network_state_fingerprint "${state_file}" 2>/dev/null)" || {
                        connectivity_target_state_after=""
                    }
                    if [[ -z "${connectivity_target_state_after}" ]]; then
                        NETWORK_CONNECTIVITY_WAIT_REASON="target-ifupdown2-state-unreadable"
                        connectivity_health_rc=13
                    else
                        network_connectivity_record "TARGET ifreload rc=0; C-28 health confirmation armed"
                        if network_connectivity_wait_for_health \
                            "${connectivity_target_profile}" "${state_file}" "${connectivity_target_state_after}" \
                            network_connectivity_target_files_unchanged \
                            "${validated_network_tree}" "${WORKDIR}" \
                            "${backup_has_interfaces_d}" "${backup_has_pinning}"; then
                            connectivity_health_rc=0
                        else
                            connectivity_health_rc=$?
                        fi
                    fi

                    if (( connectivity_health_rc == 0 )); then
                        own_live_apply=1
                        network_connectivity_record "TARGET committed after C-28 health confirmation"
                        network_connectivity_terminal_notice "Network configuration applied and C-28 health-confirmed successfully."
                    else
                        connectivity_target_failure_reason="${NETWORK_CONNECTIVITY_WAIT_REASON:-unknown}"
                        network_connectivity_record "TARGET health not committed rc=${connectivity_health_rc} reason=${connectivity_target_failure_reason}; automatic PREVIOUS rollback starting"
                        connectivity_foreign_drift=0
                        if (( connectivity_health_rc == 11 || connectivity_health_rc == 12 )); then
                            connectivity_foreign_drift=1
                            if network_preserve_concurrent_state; then
                                network_connectivity_record "Concurrent network state preserved before C-28 rollback"
                            else
                                network_connectivity_record "WARNING: concurrent network state could not be preserved completely before C-28 rollback"
                            fi
                        fi

                        if ! network_rollback_previous_tree \
                            "${old_interfaces}" "${had_interfaces}" \
                            "${old_interfaces_new}" "${had_interfaces_new}" \
                            "${old_interfaces_d}" "${had_interfaces_d}" \
                            "${old_pinning}" "${had_pinning}"; then
                            end_restore_session_critical \
                                "C-28 rejected the target runtime (${NETWORK_CONNECTIVITY_WAIT_REASON:-unknown}) and the previous network files could not be restored exactly. Use IPMI/console immediately."
                            pause
                            return 0
                        fi

                        if network_connectivity_reapply_previous_and_confirm \
                            "${connectivity_previous_profile}" "${state_file}" \
                            "${old_interfaces}" "${had_interfaces}" \
                            "${old_interfaces_new}" "${had_interfaces_new}" \
                            "${old_interfaces_d}" "${had_interfaces_d}" \
                            "${old_pinning}" "${had_pinning}"; then
                            network_connectivity_record "PREVIOUS rollback health-confirmed after TARGET health rejection"
                            if (( connectivity_foreign_drift == 1 )); then
                                end_restore_session_critical \
                                    "C-28 detected concurrent network drift while confirming the target. Previous networking was restored and health-confirmed, and concurrent state was preserved for manual reconciliation."
                            else
                                end_restore_session
                                network_connectivity_terminal_notice "C-28 rejected the restored live network (${connectivity_target_failure_reason}); previous networking was automatically restored and health-confirmed."
                            fi
                        else
                            end_restore_session_critical \
                                "C-28 rejected the target runtime and restored the previous files, but could not prove the previous management runtime (${NETWORK_CONNECTIVITY_WAIT_REASON:-unknown}). Use IPMI/console immediately."
                        fi
                        pause
                        return 0
                    fi
                    break
                    ;;
                2)
                    if ! network_restored_state_matches_stage "${WORKDIR}" "${backup_has_interfaces_d}" "${backup_has_pinning}" \
                        || ! network_validated_tree_unchanged "${validated_network_tree}"; then
                        end_restore_session_critical \
                            "Network files changed after validation. They are not reported as a successful restore; inspect for concurrent GUI/manual changes before rebooting."
                        pause
                        return 0
                    fi
                    user_selected_no_apply=1
                    break
                    ;;
                *)
                    echo "Invalid selection."
                    ;;
            esac
        done
    fi

    # Option 2 and the reboot-only path intentionally perform no live apply.
    # Recheck the state file as late as possible so a foreign Apply operation
    # during the user's selection pause cannot be reported as "not applied".
    if (( own_live_apply == 0 && late_runtime_drift == 0 )); then
        if ! network_restored_state_matches_stage "${WORKDIR}" "${backup_has_interfaces_d}" "${backup_has_pinning}" \
            || ! network_validated_tree_unchanged "${validated_network_tree}"; then
            end_restore_session_critical \
                "Network files changed at final no-apply/reboot completion. The restore is not reported as successful; inspect concurrent changes before rebooting."
            pause
            return 0
        fi
        if [[ "$(network_state_fingerprint "${state_file}" 2>/dev/null || printf 'UNREADABLE\n')" != "${state_before}" ]]; then
            late_runtime_drift=1
        fi
    fi

    if (( late_runtime_drift == 1 )); then
        echo "ifupdown2 runtime state changed after validation; aborting this restore completion and re-establishing the previous network state..." >&2
        foreign_file_drift=0
        if ! network_validated_tree_unchanged "${validated_network_tree}" \
            || ! network_restored_state_matches_stage "${WORKDIR}" "${backup_has_interfaces_d}" "${backup_has_pinning}"; then
            foreign_file_drift=1
            if network_preserve_concurrent_state; then
                echo "Concurrent network-file changes were retained with the rollback data." >&2
            else
                echo "WARNING: Concurrent network-file changes were detected, but their live state could not be copied completely." >&2
            fi
        fi

        if ! network_rollback_previous_tree \
            "${old_interfaces}" "${had_interfaces}" \
            "${old_interfaces_new}" "${had_interfaces_new}" \
            "${old_interfaces_d}" "${had_interfaces_d}" \
            "${old_pinning}" "${had_pinning}"; then
            end_restore_session_critical \
                "A foreign live network apply was detected after validation and the previous files could not be restored exactly. Use IPMI/console immediately."
            pause
            return 0
        fi

        if network_connectivity_reapply_previous_and_confirm \
            "${connectivity_previous_profile}" "${state_file}" \
            "${old_interfaces}" "${had_interfaces}" \
            "${old_interfaces_new}" "${had_interfaces_new}" \
            "${old_interfaces_d}" "${had_interfaces_d}" \
            "${old_pinning}" "${had_pinning}"; then
            if (( foreign_file_drift == 1 )); then
                end_restore_session_critical \
                    "A foreign live apply/file change occurred after validation. Previous networking was restored, re-applied and health-confirmed, and the foreign file state was preserved for manual reconciliation."
            else
                network_connectivity_terminal_notice "Foreign live network activity was detected after validation. Previous files were restored, re-applied and C-28 health-confirmed; this restore was aborted."
                end_restore_session
            fi
        else
            end_restore_session_critical \
                "A foreign live network apply was detected after validation. Previous files were restored, but C-28 could not prove the previous management runtime (${NETWORK_CONNECTIVITY_WAIT_REASON:-unknown}). Use IPMI/console immediately."
        fi
        pause
        return 0
    fi

    if (( user_selected_no_apply == 1 )); then
        echo "Network files restored but not applied live."
    fi

    end_restore_session
    pause
}


restore_firewall() {
    local archive=""
    local mode=""
    local restore_host=0
    local restore_cluster=0
    local host_member="etc/pve/nodes/${NODE}/host.fw"
    local host_dest="/etc/pve/nodes/${NODE}/host.fw"
    local cluster_member="etc/pve/firewall/cluster.fw"
    local cluster_dest="/etc/pve/firewall/cluster.fw"
    local old_host=""
    local old_cluster=""
    local host_existed=0
    local cluster_existed=0
    local host_written=0
    local cluster_written=0
    local rollback_failed=0
    local failure=""

    verify_backup
    require_pmxcfs || return 0

    if ! require_commands_for_operation pve-firewall; then
        pause
        return 0
    fi

    echo
    echo "Firewall restore options:"
    echo "  1) Node firewall only (${host_dest})"
    echo "  2) Datacenter firewall only (${cluster_dest})"
    echo "  3) Both"
    echo "  0) Cancel"
    echo
    read -r -p "Select: " mode

    case "${mode}" in
        1) restore_host=1 ;;
        2) restore_cluster=1 ;;
        3) restore_host=1; restore_cluster=1 ;;
        0) return 0 ;;
        *) echo "Invalid selection."; pause; return 0 ;;
    esac

    # host.fw and cluster.fw are optional in the backup set. Check before the
    # timer is stopped and a pre-restore snapshot is taken; a missing file is
    # a normal condition, not an unexpected failure.
    if (( restore_host == 1 )) \
        && ! archive_has_member "${BACKUP}/etc-pve.tar.gz" "${host_member}"; then
        echo "The selected backup does not contain ${host_member}." >&2
        echo "Node firewall restore is not possible from this backup. Nothing was changed." >&2
        pause
        return 0
    fi

    if (( restore_cluster == 1 )) \
        && ! archive_has_member "${BACKUP}/etc-pve.tar.gz" "${cluster_member}"; then
        echo "The selected backup does not contain ${cluster_member}." >&2
        echo "Datacenter firewall restore is not possible from this backup. Nothing was changed." >&2
        pause
        return 0
    fi

    echo
    echo "WARNING: Applying firewall rules can affect SSH and the web GUI."
    echo "Keep IPMI/console access available."
    confirm_word "Restore the selected firewall configuration?" "RESTORE" || { cancelled; return 0; }
    begin_restore_session || { pause; return 0; }

    if ! pmxcfs_is_healthy; then
        echo "pmxcfs became unavailable during restore preparation. Restore aborted." >&2
        end_restore_session
        pause
        return 0
    fi

    archive="${RESTORE_BACKUP}/etc-pve.tar.gz"
    new_workdir

    # Validate and stage everything before modifying any live firewall file.
    if (( restore_host == 1 )); then
        if ! archive_has_member "${archive}" "${host_member}"; then
            echo "Protected backup copy does not contain ${host_member}. Restore aborted, nothing was changed." >&2
            end_restore_session
            pause
            return 0
        fi
        extract_member "${archive}" "${host_member}"
    fi

    if (( restore_cluster == 1 )); then
        if ! archive_has_member "${archive}" "${cluster_member}"; then
            echo "Protected backup copy does not contain ${cluster_member}. Restore aborted, nothing was changed." >&2
            end_restore_session
            pause
            return 0
        fi
        extract_member "${archive}" "${cluster_member}"
    fi

    if (( restore_host == 1 )) && [[ -f "${host_dest}" ]]; then
        old_host="${WORKDIR}/current-host.fw"
        cp -a "${host_dest}" "${old_host}"
        host_existed=1
    fi

    if (( restore_cluster == 1 )) && [[ -f "${cluster_dest}" ]]; then
        old_cluster="${WORKDIR}/current-cluster.fw"
        cp -a "${cluster_dest}" "${old_cluster}"
        cluster_existed=1
    fi

    # A write failure leads into the rollback below instead of exiting with a
    # partially applied state. The running pve-firewall daemon picks up
    # changed files by itself (update cycle of 10 seconds).
    if (( restore_host == 1 )); then
        if write_pmxcfs_file_atomic "${WORKDIR}/${host_member}" "${host_dest}"; then
            host_written=1
        else
            failure="${host_dest} could not be written"
        fi
    fi

    if (( restore_cluster == 1 )) && [[ -z "${failure}" ]]; then
        if write_pmxcfs_file_atomic "${WORKDIR}/${cluster_member}" "${cluster_dest}"; then
            cluster_written=1
        else
            failure="${cluster_dest} could not be written"
        fi
    fi

    if [[ -z "${failure}" ]]; then
        if ! pve-firewall compile >/dev/null 2>"${WORKDIR}/validate.err"; then
            sed 's/^/  /' "${WORKDIR}/validate.err" >&2
            failure="pve-firewall compile failed"
        elif ! validation_output_accepted "pve-firewall compile" "${WORKDIR}/validate.err"; then
            failure="the compiler messages were not accepted"
        elif ! systemctl reload-or-restart pve-firewall; then
            # Invoke systemd explicitly. Current PVE's `pve-firewall restart`
            # CLI already delegates to systemd outside PID 1; spelling it out
            # here keeps service ownership and descriptor handling explicit.
            failure="reloading pve-firewall through systemd failed"
        fi
    fi

    if [[ -n "${failure}" ]]; then
        echo "Firewall restore aborted: ${failure}. Rolling back..." >&2

        if (( host_written == 1 )); then
            if (( host_existed == 1 )); then
                write_pmxcfs_file_atomic "${old_host}" "${host_dest}" || rollback_failed=1
            else
                rm -f -- "${host_dest}" || rollback_failed=1
            fi
        fi

        if (( cluster_written == 1 )); then
            if (( cluster_existed == 1 )); then
                write_pmxcfs_file_atomic "${old_cluster}" "${cluster_dest}" || rollback_failed=1
            else
                rm -f -- "${cluster_dest}" || rollback_failed=1
            fi
        fi

        if (( rollback_failed == 0 )) \
            && pve-firewall compile >/dev/null \
            && systemctl reload-or-restart pve-firewall; then
            echo "Rollback completed and firewall rules were revalidated."
            end_restore_session
        else
            end_restore_session_critical \
                "Firewall rollback could not be written, compiled and reloaded successfully. Use IPMI/console and inspect the firewall files."
        fi
        pause
        return 0
    fi

    echo
    pve-firewall status \
        || echo "WARNING: 'pve-firewall status' returned an error; the restore itself completed." >&2
    echo "Firewall configuration restored successfully."

    end_restore_session
    pause
}


restore_storage() {
    local archive=""
    local member="etc/pve/storage.cfg"
    local dest="/etc/pve/storage.cfg"
    local target=""
    local old=""
    local previous_descriptor=""
    local target_descriptor=""
    local target_prevalidation_messages=""
    local previous_prevalidation_messages=""
    local target_validation_messages=""
    local rollback_validation_messages=""
    local tx_rc=0
    local tx_outcome=""
    local tx_reason=""
    local capture_rc=0
    local target_prevalidate_rc=0
    local previous_prevalidate_rc=0
    local target_kind=""
    local target_sha=""

    verify_backup
    require_pmxcfs || return 0

    if ! require_commands_for_operation pvesm perl; then
        pause
        return 0
    fi

    if ! backup_members_present "${BACKUP}/etc-pve.tar.gz" "${member}"; then
        echo "storage.cfg restore is not possible from this backup. Nothing was changed." >&2
        pause
        return 0
    fi

    confirm_word "Restore Proxmox storage.cfg from ${BACKUP}?" "RESTORE" || { cancelled; return 0; }
    begin_restore_session || { pause; return 0; }

    if ! pmxcfs_is_healthy; then
        echo "pmxcfs became unavailable during restore preparation. Restore aborted." >&2
        end_restore_session
        pause
        return 0
    fi

    archive="${RESTORE_BACKUP}/etc-pve.tar.gz"
    new_workdir
    extract_member "${archive}" "${member}"

    target="${WORKDIR}/${member}"
    old="${WORKDIR}/current-storage.cfg"
    previous_descriptor="${WORKDIR}/storage.previous.descriptor"
    target_descriptor="${WORKDIR}/storage.target.descriptor"
    target_prevalidation_messages="${WORKDIR}/storage.target-prevalidation.err"
    previous_prevalidation_messages="${WORKDIR}/storage.previous-prevalidation.err"
    target_validation_messages="${WORKDIR}/storage.target-validation.err"
    rollback_validation_messages="${WORKDIR}/storage.rollback-validation.err"

    # TARGET identity first: only a regular non-symlink file is admissible.
    if tx_write_pmxcfs_file_descriptor "${target}" "${target_descriptor}"; then
        IFS=$'\t' read -r target_kind target_sha < "${target_descriptor}" || true
    fi
    if [[ "${target_kind}" != "FILE" || ! "${target_sha}" =~ ^[0-9a-f]{64}$ ]]; then
        echo "storage.cfg TARGET is not a supported regular file. Nothing was changed." >&2
        end_restore_session
        pause
        return 0
    fi

    # Semantic TARGET prevalidation while still staged. This uses Proxmox's own
    # storage parser and intentionally performs no backend activation/reachability
    # work. After TARGET becomes live, pvesm status is used only as the explicit
    # command-level live acceptance/status gate described by storage_tx_validate_live().
    if storage_tx_prevalidate_candidate \
        "${target}" "${target_prevalidation_messages}"; then
        target_prevalidate_rc=0
    else
        target_prevalidate_rc=$?
    fi

    if (( target_prevalidate_rc != 0 )); then
        tx_print_validation_messages_noncritical \
            "TARGET prevalidation diagnostics" "${target_prevalidation_messages}"
        echo "storage.cfg TARGET failed staged semantic prevalidation (rc=${target_prevalidate_rc}). Nothing was changed." >&2
        end_restore_session
        pause
        return 0
    fi

    # Candidate bytes must still be the exact bytes that were fingerprinted
    # before parser prevalidation.
    if ! tx_pmxcfs_file_matches_descriptor \
        "${target}" "${target_descriptor}"; then
        echo "storage.cfg TARGET changed during staged prevalidation. Nothing was changed." >&2
        end_restore_session
        pause
        return 0
    fi

    # Capture PREVIOUS as late as possible and prove before/copy/after identity.
    if tx_capture_stable_pmxcfs_previous \
        "${dest}" "${old}" "${previous_descriptor}"; then
        capture_rc=0
    else
        capture_rc=$?
    fi

    if (( capture_rc != 0 )); then
        echo "storage.cfg PREVIOUS could not be captured as one stable state (rc=${capture_rc}). Nothing was changed." >&2
        end_restore_session
        pause
        return 0
    fi

    # A byte-stable PREVIOUS is not automatically a known-good rollback basis.
    # Validate the live PREVIOUS state before any live mutation, then prove that
    # it is still byte-identical to the captured PREVIOUS descriptor.
    if storage_tx_validate_live \
        previous "${previous_prevalidation_messages}"; then
        previous_prevalidate_rc=0
    else
        previous_prevalidate_rc=$?
    fi

    if (( previous_prevalidate_rc != 0 )); then
        tx_print_validation_messages_noncritical \
            "PREVIOUS prevalidation diagnostics" "${previous_prevalidation_messages}"
        echo "storage.cfg PREVIOUS failed semantic prevalidation (rc=${previous_prevalidate_rc}). Nothing was changed." >&2
        end_restore_session
        pause
        return 0
    fi

    if ! tx_pmxcfs_file_matches_descriptor \
        "${dest}" "${previous_descriptor}"; then
        echo "storage.cfg LIVE changed during PREVIOUS prevalidation. Nothing was changed." >&2
        end_restore_session
        pause
        return 0
    fi

    # Read-only final admission gate uses the same Proxmox storage.cfg lock and
    # pmxcfs context proof that the mutating transition will use. No live bytes
    # are changed here.
    if ! storage_tx_locked_context_gate; then
        tx_print_validation_messages_noncritical \
            "Storage lock/context diagnostics" "${WORKDIR}/storage.lock-context.err"
        echo "pmxcfs storage context/lock became unavailable after PREVIOUS prevalidation. Nothing was changed." >&2
        end_restore_session
        pause
        return 0
    fi

    tx_begin_single_pmxcfs_file \
        "storage" \
        "${dest}" \
        "${old}" \
        "${previous_descriptor}" \
        "${target_descriptor}" \
        "storage_tx_validate_live" \
        "${target_validation_messages}" \
        "${rollback_validation_messages}"

    if tx_apply_single_pmxcfs_file "${target}"; then
        tx_rc=0
    else
        tx_rc=$?
    fi

    tx_outcome="${TX_OUTCOME}"
    tx_reason="${TX_FAILURE_REASON}"

    case "${tx_rc}" in
        0)
            printf '\n%s\n' "storage.cfg restored and committed successfully." || true
            # Diagnostic display only; transaction commit has already been
            # established by the target validator and final identity gate.
            pvesm status 7>&- 8>&- \
                || printf '%s\n' "WARNING: 'pvesm status' returned an error after commit; inspect storage state." >&2 || true
            end_restore_session
            tx_reset
            pause
            return 0
            ;;
        10)
            tx_print_validation_messages_noncritical \
                "TARGET validation diagnostics" "${target_validation_messages}"
            tx_print_validation_messages_noncritical \
                "Rollback validation diagnostics" "${rollback_validation_messages}"
            printf '%s\n' "Storage restore aborted: ${tx_reason}." >&2 || true
            printf '%s\n' "Rollback completed; PREVIOUS was restored exactly and revalidated." || true
            end_restore_session
            tx_reset
            pause
            return 0
            ;;
        11)
            printf '%s\n' "Storage restore aborted before an effective live mutation: ${tx_reason}." >&2 || true
            end_restore_session
            tx_reset
            pause
            return 0
            ;;
        20|21)
            if (( TX_TEMP_CLEANUP_UNCERTAIN == 1 )); then
                tx_print_validation_messages_noncritical \
                    "Storage apply cleanup diagnostics" "${WORKDIR}/storage.lock-apply.err"
                tx_print_validation_messages_noncritical \
                    "Storage rollback cleanup diagnostics" "${WORKDIR}/storage.lock-rollback.err"
            fi
            tx_print_validation_messages_noncritical \
                "TARGET validation diagnostics" "${target_validation_messages}"
            tx_print_validation_messages_noncritical \
                "Rollback validation diagnostics" "${rollback_validation_messages}"
            end_restore_session_critical \
                "storage.cfg transaction ended in ${TX_STATE}: ${tx_reason}. Transaction safety did not blindly overwrite an unowned/ambiguous live state."
            tx_reset
            pause
            return 0
            ;;
        *)
            end_restore_session_critical \
                "storage.cfg transaction returned unexpected status ${tx_rc} (${tx_outcome}): ${tx_reason}"
            tx_reset
            pause
            return 0
            ;;
    esac
}

passwords_tx_operation() {
    # C-29 PASSWORDS R1 helper. Both actions use the same strict parser/scope
    # implementation. `run` keeps the complete native lock set held across
    # PREVIOUS capture, QUIESCE, TARGET apply, validation and rollback.
    local action="$1"
    local target_user="$2"
    local target_shadow="$3"
    local result_file="$4"
    local messages="$5"
    local helper_workdir="$6"
    local rc=0

    rm -f -- "${result_file}" "${messages}" || return 1
    : > "${messages}" || return 1

    if perl \
        -MDigest::SHA \
        -MErrno=ENOENT,EEXIST \
        -MFcntl=O_RDONLY,O_WRONLY,O_CREAT,O_EXCL,O_TRUNC,S_ISREG \
        -MPVE::AccessControl \
        -MPVE::Auth::PVE \
        -MPVE::Auth::Plugin \
        -MPVE::Cluster \
        -MPVE::TokenConfig \
        - "${action}" "${target_user}" "${target_shadow}" \
        "${result_file}" "${NODE}" "${helper_workdir}" \
        7>&- 8>&- >/dev/null 2>"${messages}" <<'PASSWORDS_PERL_HELPER'
use strict;
use warnings;

use Digest::SHA ();
use Errno qw(ENOENT EEXIST);
use Fcntl qw(O_RDONLY O_WRONLY O_CREAT O_EXCL O_TRUNC S_ISREG);

use PVE::AccessControl ();
use PVE::Auth::PVE ();
use PVE::Auth::Plugin ();
use PVE::Cluster ();
use PVE::TokenConfig ();

my ($action, $target_user, $target_shadow, $result_file, $node, $workdir) = @ARGV;

my $RC_OK = 0;
my $RC_ROLLED_BACK = 10;
my $RC_ABORTED = 11;
my $RC_AMBIGUOUS = 20;
my $RC_ROLLBACK_FAILED = 21;
my $RC_INVALID_TARGET = 64;
my $RC_HELPER_ERROR = 70;

my $mutation_started = 0;
my $temp_cleanup_uncertain = 0;
my $temp_counter = 0;
my $final_rc = $RC_HELPER_ERROR;
my $final_outcome = 'HELPER_ERROR';
my $final_state = 'INITIAL';
my $final_reason = 'helper did not complete';

sub write_result {
    my ($outcome, $state, $reason, $mutation) = @_;
    $outcome //= 'UNKNOWN';
    $state //= 'UNKNOWN';
    $reason //= 'unspecified';
    $mutation //= 0;

    sysopen(my $fh, $result_file, O_WRONLY|O_CREAT|O_TRUNC, 0600)
        or die "cannot create PASSWORDS transaction result\n";
    print {$fh} "OUTCOME=$outcome\n";
    print {$fh} "STATE=$state\n";
    print {$fh} "MUTATION_STARTED=$mutation\n";
    print {$fh} "REASON=$reason\n";
    close($fh) or die "cannot close PASSWORDS transaction result\n";
}

sub safe_reason {
    my ($reason) = @_;
    $reason //= 'unspecified';
    $reason =~ s/[\r\n\t]+/ /g;
    $reason =~ s/[^A-Za-z0-9 ._:\/()=,+\-]/?/g;
    $reason = substr($reason, 0, 300);
    return $reason;
}

sub read_regular_raw {
    my ($path, $allow_absent) = @_;

    my @st = lstat($path);
    if (!@st) {
        return undef if $allow_absent && $! == ENOENT;
        die "required file is absent\n";
    }
    die "unsafe file object\n" if -l _ || !S_ISREG($st[2]);

    open(my $fh, '<', $path) or die "cannot open file\n";
    binmode($fh);
    local $/;
    my $raw = <$fh>;
    close($fh) or die "cannot close file\n";
    return defined($raw) ? $raw : q{};
}

sub raw_descriptor {
    my ($raw) = @_;
    return 'ABSENT' if !defined($raw);
    my $sha = Digest::SHA->new(256);
    $sha->add($raw);
    return "FILE\t" . $sha->hexdigest;
}

sub file_state {
    my ($path) = @_;
    my @st = lstat($path);
    return 'ABSENT' if !@st && $! == ENOENT;
    return undef if !@st || -l _ || !S_ISREG($st[2]);

    open(my $fh, '<', $path) or return undef;
    binmode($fh);
    my $sha = Digest::SHA->new(256);
    eval { $sha->addfile($fh); 1 } or do { close($fh); return undef; };
    close($fh) or return undef;
    return "FILE\t" . $sha->hexdigest;
}

sub split_username_realm {
    my ($userid) = @_;
    my (undef, $ruid, $realm) = PVE::Auth::Plugin::verify_username($userid, 1);
    return if !defined($realm) || !defined($ruid);
    return ($ruid, $realm);
}

sub record_realm {
    my ($realms, $userid) = @_;
    my (undef, $realm) = split_username_realm($userid);
    if (!defined($realm)) {
        $realms->{'__INVALID__'} = 1;
        return;
    }
    $realms->{$realm} = 1;
}

sub strict_pair_validate {
    my ($label, $user_raw, $shadow_raw) = @_;

    $user_raw = q{} if !defined($user_raw);
    $shadow_raw = q{} if !defined($shadow_raw);

    my @user_warn;
    my @shadow_warn;
    my $user_parse_ok = eval {
        local $SIG{__WARN__} = sub { push @user_warn, @_ };
        PVE::AccessControl::parse_user_config("$label-user.cfg", $user_raw);
        1;
    } ? 1 : 0;
    my $shadow_parse_ok = eval {
        local $SIG{__WARN__} = sub { push @shadow_warn, @_ };
        PVE::Auth::PVE::parse_shadow_passwd("$label-shadow.cfg", $shadow_raw);
        1;
    } ? 1 : 0;

    my %expected_fields = (
        user  => 10,
        group => 5,
        pool  => 6,
        role  => 4,
        acl   => 6,
        token => 6,
    );
    my %unique_type = map { $_ => 1 } qw(user group pool role token);
    my %seen_key;
    my %seen_line;
    my %realms;
    my %pve_ruids;
    my $user_schema_errors = 0;
    my $user_duplicate_errors = 0;
    my $token_metadata_total = 0;
    my $token_acl_refs = 0;
    my $legacy_keys_total = 0;
    my $user_record_lines = 0;

    for my $line (split(/\n/, $user_raw, -1)) {
        next if $line =~ /^\s*$/;
        $user_record_lines++;

        if ($seen_line{$line}++) {
            $user_duplicate_errors++;
        }

        my @f = split(/:/, $line, -1);
        my $type = $f[0] // q{};
        if (!exists($expected_fields{$type}) || @f != $expected_fields{$type} || $f[-1] ne q{}) {
            $user_schema_errors++;
            next;
        }

        if ($unique_type{$type}) {
            my $key = $f[1] // q{};
            my $id = "$type\0$key";
            $user_duplicate_errors++ if $seen_key{$id}++;
        }

        if ($type eq 'user') {
            my $userid = $f[1] // q{};
            my ($ruid, $realm) = split_username_realm($userid);
            if (!defined($realm)) {
                $user_schema_errors++;
            } else {
                $realms{$realm} = 1;
                $pve_ruids{$ruid} = 1 if $realm eq 'pve';
            }
            $legacy_keys_total++ if defined($f[8]) && length($f[8]);
        } elsif ($type eq 'group') {
            my $members = $f[2] // q{};
            for my $userid (grep { length($_) } split(/,/, $members)) {
                record_realm(\%realms, $userid);
            }
        } elsif ($type eq 'acl') {
            my $members = $f[3] // q{};
            for my $member (grep { length($_) } split(/,/, $members)) {
                next if $member =~ /^@/;
                if ($member =~ /!/) {
                    $token_acl_refs++;
                    my ($userid) = split(/!/, $member, 2);
                    record_realm(\%realms, $userid);
                } else {
                    record_realm(\%realms, $member);
                }
            }
        } elsif ($type eq 'token') {
            $token_metadata_total++;
            my $tokenid = $f[1] // q{};
            my ($userid) = split(/!/, $tokenid, 2);
            record_realm(\%realms, $userid) if defined($userid) && length($userid);
        }
    }

    my %shadow_seen;
    my %shadow_ruids;
    my $shadow_schema_errors = 0;
    my $shadow_duplicate_errors = 0;
    my $shadow_record_lines = 0;

    for my $line (split(/\n/, $shadow_raw, -1)) {
        next if $line =~ /^\s*$/;
        $shadow_record_lines++;
        my @f = split(/:/, $line, -1);
        if (@f != 3 || !defined($f[0]) || $f[0] eq q{} || !defined($f[1]) || $f[1] eq q{} || $f[2] ne q{}) {
            $shadow_schema_errors++;
            next;
        }
        $shadow_duplicate_errors++ if $shadow_seen{$f[0]}++;
        $shadow_ruids{$f[0]} = 1;
    }

    my $shadow_without_pve = scalar grep { !$pve_ruids{$_} } keys %shadow_ruids;
    my $pve_without_shadow = scalar grep { !$shadow_ruids{$_} } keys %pve_ruids;
    my $custom_or_invalid_realms = scalar grep { $_ ne 'pve' && $_ ne 'pam' } keys %realms;

    my $strict = (
        $user_parse_ok && $shadow_parse_ok &&
        @user_warn == 0 && @shadow_warn == 0 &&
        $user_schema_errors == 0 && $user_duplicate_errors == 0 &&
        $shadow_schema_errors == 0 && $shadow_duplicate_errors == 0 &&
        $shadow_without_pve == 0
    ) ? 1 : 0;

    my $scope = (
        $token_metadata_total == 0 &&
        $token_acl_refs == 0 &&
        $legacy_keys_total == 0 &&
        $custom_or_invalid_realms == 0
    ) ? 1 : 0;

    my $summary = join(' ',
        "label=$label",
        "strict=$strict",
        "scope=$scope",
        "user_warn=" . scalar(@user_warn),
        "shadow_warn=" . scalar(@shadow_warn),
        "user_schema=$user_schema_errors",
        "user_dup=$user_duplicate_errors",
        "shadow_schema=$shadow_schema_errors",
        "shadow_dup=$shadow_duplicate_errors",
        "token_meta=$token_metadata_total",
        "token_acl=$token_acl_refs",
        "legacy_keys=$legacy_keys_total",
        "custom_realms=$custom_or_invalid_realms",
        "shadow_without_pve=$shadow_without_pve",
        "pve_without_shadow=$pve_without_shadow",
        "user_records=$user_record_lines",
        "shadow_records=$shadow_record_lines",
    );

    return ($strict && $scope ? 1 : 0, $summary);
}

sub write_private_copy {
    my ($path, $raw) = @_;
    return 1 if !defined($raw);
    sysopen(my $fh, $path, O_WRONLY|O_CREAT|O_EXCL, 0600)
        or return 0;
    binmode($fh);
    my $off = 0;
    my $len = length($raw);
    while ($off < $len) {
        my $w = syswrite($fh, $raw, $len - $off, $off);
        if (!defined($w) || $w == 0) {
            close($fh);
            return 0;
        }
        $off += $w;
    }
    return close($fh) ? 1 : 0;
}

sub write_descriptor_file {
    my ($path, $desc) = @_;
    sysopen(my $fh, $path, O_WRONLY|O_CREAT|O_EXCL, 0600) or return 0;
    print {$fh} "$desc\n";
    return close($fh) ? 1 : 0;
}

sub current_pmxcfs_mount_id {
    open(my $fh, '<', '/proc/self/mountinfo') or return undef;
    my $mount_id;
    while (my $line = <$fh>) {
        chomp($line);
        my ($pre, $post) = split(/ - /, $line, 2);
        next if !defined($post);
        my @pre = split(/ /, $pre);
        next if @pre < 5 || $pre[4] ne '/etc/pve';
        my ($fstype) = split(/ /, $post, 2);
        next if !defined($fstype) || $fstype !~ /^fuse(?:\.|$)/;
        $mount_id = $pre[0];
        last;
    }
    close($fh);
    return $mount_id;
}

sub fd_mount_id {
    my ($fd) = @_;
    open(my $fh, '<', "/proc/self/fdinfo/$fd") or return undef;
    my $mount_id;
    while (my $line = <$fh>) {
        if ($line =~ /^mnt_id:\s*(\d+)\s*$/) {
            $mount_id = $1;
            last;
        }
    }
    close($fh);
    return $mount_id;
}

sub context_current {
    my ($fdroot, $fd, $node_name) = @_;
    eval { PVE::Cluster::cfs_update(1); 1 } or return 0;
    return 0 if !PVE::Cluster::check_cfs_is_mounted(1);

    my $live_mount_id = current_pmxcfs_mount_id();
    my $pinned_mount_id = fd_mount_id($fd);
    return 0 if !defined($live_mount_id) || !defined($pinned_mount_id);
    return 0 if $live_mount_id ne $pinned_mount_id;

    my @live = stat('/etc/pve');
    my @pinned = stat($fdroot);
    return 0 if !@live || !@pinned;
    return 0 if $live[0] != $pinned[0] || $live[1] != $pinned[1];

    return 0 if -e '/etc/corosync/corosync.conf' || -l '/etc/corosync/corosync.conf';
    return 0 if -e "$fdroot/corosync.conf" || -l "$fdroot/corosync.conf";

    return 0 if !-d "$fdroot/nodes/$node_name";
    my $local_target = readlink("$fdroot/local");
    return 0 if !defined($local_target) || $local_target ne "nodes/$node_name";
    return 1;
}

sub dependency_scope_clean {
    my ($fdroot) = @_;
    for my $rel ('priv/token.cfg', 'priv/tfa.cfg', 'domains.cfg') {
        my $path = "$fdroot/$rel";
        return 0 if -e $path || -l $path;
    }
    return 1;
}

sub cleanup_owned_temp {
    my ($tmp, $owned_dev, $owned_ino) = @_;
    my @cur = lstat($tmp);
    return 1 if !@cur && $! == ENOENT;
    return 0 if !@cur || !S_ISREG($cur[2]);
    return 0 if !defined($owned_dev) || !defined($owned_ino);
    return 0 if $cur[0] != $owned_dev || $cur[1] != $owned_ino;
    unlink($tmp);
    my @after = lstat($tmp);
    return (!@after && $! == ENOENT) ? 1 : 0;
}

sub write_raw_atomic_pinned {
    my ($raw, $dest) = @_;
    my ($out, $tmp, $owned_dev, $owned_ino);
    my $created = 0;
    my $write_ok = 0;

    for my $attempt (1..20) {
        $temp_counter++;
        $tmp = "$dest.tmp.$$.$temp_counter.$attempt";
        if (sysopen($out, $tmp, O_WRONLY|O_CREAT|O_EXCL, 0600)) {
            my @owned = stat($out);
            if (!@owned) {
                $temp_cleanup_uncertain = 1;
                close($out);
                return 0;
            }
            ($owned_dev, $owned_ino) = @owned[0,1];
            $created = 1;
            last;
        }
        my $open_errno = 0 + $!;
        next if $open_errno == EEXIST;
        return 0;
    }
    return 0 if !$created;

    binmode($out);
    my $off = 0;
    my $len = length($raw);
    while ($off < $len) {
        my $w = syswrite($out, $raw, $len - $off, $off);
        if (!defined($w) || $w == 0) {
            last;
        }
        $off += $w;
    }

    if ($off == $len && close($out)) {
        undef $out;
        $write_ok = rename($tmp, $dest) ? 1 : 0;
    } else {
        eval { close($out) if defined($out) && defined(fileno($out)); 1 };
    }

    if (!cleanup_owned_temp($tmp, $owned_dev, $owned_ino)) {
        $temp_cleanup_uncertain = 1;
    }

    return $write_ok && !$temp_cleanup_uncertain ? 1 : 0;
}

sub remove_pinned_file {
    my ($dest) = @_;
    my @st = lstat($dest);
    return 1 if !@st && $! == ENOENT;
    return 0 if !@st || -l _ || !S_ISREG($st[2]);
    return unlink($dest) ? 1 : ($! == ENOENT ? 1 : 0);
}

sub transition_file {
    my ($fdroot, $dirfd, $node_name, $rel, $expected, $desired, $desired_raw) = @_;
    my $path = "$fdroot/$rel";
    my $current = file_state($path);
    return 76 if !defined($current);
    return 72 if $current ne $expected && $current ne $desired;
    return 0 if $current eq $desired;
    return 71 if !context_current($fdroot, $dirfd, $node_name);

    my $write_ok;
    if ($desired eq 'ABSENT') {
        $write_ok = remove_pinned_file($path);
    } else {
        return 73 if !defined($desired_raw) || raw_descriptor($desired_raw) ne $desired;
        $write_ok = write_raw_atomic_pinned($desired_raw, $path);
    }

    return 78 if $temp_cleanup_uncertain;
    my $after = file_state($path);
    return 77 if !context_current($fdroot, $dirfd, $node_name);
    return 76 if !defined($after);
    return 0 if $after eq $desired;
    return 74 if $after eq $expected;
    return 76;
}

sub pair_state {
    my ($fdroot) = @_;
    my $u = file_state("$fdroot/user.cfg");
    my $s = file_state("$fdroot/priv/shadow.cfg");
    return if !defined($u) || !defined($s);
    return ($u, $s);
}

sub pair_matches {
    my ($u, $s, $eu, $es) = @_;
    return defined($u) && defined($s) && $u eq $eu && $s eq $es;
}

sub pair_owned {
    my ($u, $s, $pu, $ps, $qu, $tu, $ts) = @_;
    return 1 if pair_matches($u, $s, $pu, $ps);
    return 1 if pair_matches($u, $s, $qu, $ps);
    return 1 if pair_matches($u, $s, $qu, $ts);
    return 1 if pair_matches($u, $s, $tu, $ts);
    return 0;
}

sub rollback_pair {
    my ($fdroot, $dirfd, $node_name, $pu, $ps, $qu, $tu, $ts, $prev_user_raw, $prev_shadow_raw) = @_;

    return (0, 'temporary cleanup is unproven') if $temp_cleanup_uncertain;
    return (0, 'pmxcfs context is not current before rollback') if !context_current($fdroot, $dirfd, $node_name);
    return (0, 'auth dependency scope changed before rollback') if !dependency_scope_clean($fdroot);

    my ($cu, $cs) = pair_state($fdroot);
    return (0, 'live pair is unsafe/unreadable before rollback') if !defined($cu);

    if (pair_matches($cu, $cs, $pu, $ps)) {
        my ($valid, $summary) = strict_pair_validate('rollback-existing-previous', $prev_user_raw, $prev_shadow_raw);
        return (0, "PREVIOUS validation failed: $summary") if !$valid;
        return (1, 'PREVIOUS already live');
    }

    return (0, 'live pair is FOREIGN/AMBIGUOUS before rollback')
        if !pair_owned($cu, $cs, $pu, $ps, $qu, $tu, $ts);

    # Keep readers fail-closed while password state is returned to PREVIOUS.
    if ($cu ne $qu) {
        my $rc = transition_file($fdroot, $dirfd, $node_name, 'user.cfg', $cu, $qu, q{});
        return (0, "could not establish rollback QUIESCE user state (rc=$rc)") if $rc != 0;
    }

    ($cu, $cs) = pair_state($fdroot);
    return (0, 'pair unreadable after rollback QUIESCE') if !defined($cu);
    return (0, 'pair not owned after rollback QUIESCE') if $cu ne $qu || ($cs ne $ps && $cs ne $ts);

    if ($cs ne $ps) {
        my $rc = transition_file($fdroot, $dirfd, $node_name, 'priv/shadow.cfg', $cs, $ps, $prev_shadow_raw);
        return (0, "could not restore PREVIOUS shadow state (rc=$rc)") if $rc != 0;
    }

    ($cu, $cs) = pair_state($fdroot);
    return (0, 'pair unreadable after PREVIOUS shadow restore') if !defined($cu);
    return (0, 'unexpected pair after PREVIOUS shadow restore') if $cu ne $qu || $cs ne $ps;

    if ($cu ne $pu) {
        my $rc = transition_file($fdroot, $dirfd, $node_name, 'user.cfg', $cu, $pu, $prev_user_raw);
        return (0, "could not restore PREVIOUS user state (rc=$rc)") if $rc != 0;
    }

    ($cu, $cs) = pair_state($fdroot);
    return (0, 'pair unreadable after PREVIOUS restore') if !defined($cu);
    return (0, 'PREVIOUS pair is not exact after rollback') if !pair_matches($cu, $cs, $pu, $ps);
    return (0, 'pmxcfs context changed during rollback') if !context_current($fdroot, $dirfd, $node_name);
    return (0, 'auth dependency scope changed during rollback') if !dependency_scope_clean($fdroot);

    my ($valid, $summary) = strict_pair_validate('rollback-previous', $prev_user_raw, $prev_shadow_raw);
    return (0, "PREVIOUS validation failed after rollback: $summary") if !$valid;
    return (1, 'PREVIOUS restored exactly and revalidated');
}

sub run_transaction_under_all_locks {
    my ($target_user_raw, $target_shadow_raw, $target_user_desc, $target_shadow_desc) = @_;

    my $inner_completed = 0;

    PVE::Auth::Plugin::lock_domain_config(sub {
        PVE::AccessControl::lock_tfa_config(sub {
            PVE::AccessControl::lock_user_config(sub {
                my $token_res = PVE::Cluster::cfs_lock_file('priv/token.cfg', undef, sub {
                    PVE::Auth::PVE::lock_shadow_config(sub {
                        $inner_completed = 1;

                        my $body_ok = eval {
                            sysopen(my $dirfh, '/etc/pve', O_RDONLY)
                                or die "pmxcfs context open failed\n";
                            my $dirfd = fileno($dirfh);
                            my $fdroot = "/proc/self/fd/$dirfd";
                            die "pmxcfs context is not current\n"
                                if !-d $fdroot || !context_current($fdroot, $dirfd, $node);
                            die "auth dependency scope is not clean\n"
                                if !dependency_scope_clean($fdroot);

                            # Immutable staged TARGET proof immediately before PREVIOUS capture.
                            my $tu_now = file_state($target_user);
                            my $ts_now = file_state($target_shadow);
                            die "staged TARGET changed before mutation\n"
                                if !defined($tu_now) || !defined($ts_now)
                                || $tu_now ne $target_user_desc || $ts_now ne $target_shadow_desc;

                            my $prev_user_raw = read_regular_raw("$fdroot/user.cfg", 1);
                            my $prev_shadow_raw = read_regular_raw("$fdroot/priv/shadow.cfg", 1);
                            my $pu = raw_descriptor($prev_user_raw);
                            my $ps = raw_descriptor($prev_shadow_raw);
                            my $qu = raw_descriptor(q{});
                            my $tu = $target_user_desc;
                            my $ts = $target_shadow_desc;

                            my ($previous_valid, $previous_summary) =
                                strict_pair_validate('previous', $prev_user_raw, $prev_shadow_raw);
                            die "PREVIOUS validation/scope failed: $previous_summary\n"
                                if !$previous_valid;

                            write_private_copy("$workdir/passwords.previous-user.cfg", $prev_user_raw)
                                or die "cannot preserve PREVIOUS user.cfg\n";
                            write_private_copy("$workdir/passwords.previous-shadow.cfg", $prev_shadow_raw)
                                or die "cannot preserve PREVIOUS shadow.cfg\n";
                            write_descriptor_file("$workdir/passwords.previous-user.desc", $pu)
                                or die "cannot preserve PREVIOUS user descriptor\n";
                            write_descriptor_file("$workdir/passwords.previous-shadow.desc", $ps)
                                or die "cannot preserve PREVIOUS shadow descriptor\n";
                            write_descriptor_file("$workdir/passwords.target-user.desc", $tu)
                                or die "cannot preserve TARGET user descriptor\n";
                            write_descriptor_file("$workdir/passwords.target-shadow.desc", $ts)
                                or die "cannot preserve TARGET shadow descriptor\n";

                            my ($cu, $cs) = pair_state($fdroot);
                            die "live pair unreadable after PREVIOUS capture\n" if !defined($cu);
                            die "PREVIOUS ownership changed before mutation\n"
                                if !pair_matches($cu, $cs, $pu, $ps);

                            if ($pu eq $tu && $ps eq $ts) {
                                my ($same_valid, $same_summary) =
                                    strict_pair_validate('same-state', $prev_user_raw, $prev_shadow_raw);
                                die "same-state validation failed: $same_summary\n" if !$same_valid;
                                die "pmxcfs context changed during same-state gate\n"
                                    if !context_current($fdroot, $dirfd, $node);
                                $final_rc = $RC_OK;
                                $final_outcome = 'SAME_STATE';
                                $final_state = 'COMMITTED';
                                $final_reason = 'PREVIOUS and TARGET are already identical';
                                return 1;
                            }

                            $mutation_started = 1;
                            $final_state = 'QUIESCING';

                            my $rc = transition_file(
                                $fdroot, $dirfd, $node,
                                'user.cfg', $pu, $qu, q{}
                            );
                            die "QUIESCE user transition failed rc=$rc\n" if $rc != 0;

                            ($cu, $cs) = pair_state($fdroot);
                            die "pair unreadable after QUIESCE\n" if !defined($cu);
                            die "unexpected pair after QUIESCE\n"
                                if !pair_matches($cu, $cs, $qu, $ps);

                            $final_state = 'APPLYING_TARGET_SHADOW';
                            $rc = transition_file(
                                $fdroot, $dirfd, $node,
                                'priv/shadow.cfg', $ps, $ts, $target_shadow_raw
                            );
                            die "TARGET shadow transition failed rc=$rc\n" if $rc != 0;

                            ($cu, $cs) = pair_state($fdroot);
                            die "pair unreadable after TARGET shadow\n" if !defined($cu);
                            die "unexpected pair after TARGET shadow\n"
                                if !pair_matches($cu, $cs, $qu, $ts);

                            $final_state = 'APPLYING_TARGET_USER';
                            $rc = transition_file(
                                $fdroot, $dirfd, $node,
                                'user.cfg', $qu, $tu, $target_user_raw
                            );
                            die "TARGET user transition failed rc=$rc\n" if $rc != 0;

                            ($cu, $cs) = pair_state($fdroot);
                            die "pair unreadable at TARGET gate\n" if !defined($cu);
                            die "TARGET pair is not exact\n"
                                if !pair_matches($cu, $cs, $tu, $ts);
                            die "pmxcfs context changed before commit\n"
                                if !context_current($fdroot, $dirfd, $node);
                            die "auth dependency scope changed before commit\n"
                                if !dependency_scope_clean($fdroot);

                            my $live_target_user = read_regular_raw("$fdroot/user.cfg", 0);
                            my $live_target_shadow = read_regular_raw("$fdroot/priv/shadow.cfg", 0);
                            my ($target_valid, $target_summary) =
                                strict_pair_validate('live-target', $live_target_user, $live_target_shadow);
                            die "live TARGET validation failed: $target_summary\n"
                                if !$target_valid;

                            ($cu, $cs) = pair_state($fdroot);
                            die "TARGET ownership changed during validation\n" if !defined($cu)
                                || !pair_matches($cu, $cs, $tu, $ts);

                            $final_rc = $RC_OK;
                            $final_outcome = 'COMMITTED';
                            $final_state = 'COMMITTED';
                            $final_reason = 'TARGET pair restored exactly and revalidated';
                            return 1;
                        };

                        my $body_error = $@;
                        if (!$body_ok) {
                            my $reason = safe_reason($body_error || 'transaction body failed');

                            if (!$mutation_started) {
                                $final_rc = $RC_ABORTED;
                                $final_outcome = 'ABORTED_BEFORE_MUTATION';
                                $final_state = 'ABORTED_BEFORE_MUTATION';
                                $final_reason = $reason;
                                return 1;
                            }

                            # Reopen/re-pin only within the still-held native lock set.
                            my $rollback_ok = eval {
                                sysopen(my $dirfh, '/etc/pve', O_RDONLY)
                                    or die "rollback pmxcfs context open failed\n";
                                my $dirfd = fileno($dirfh);
                                my $fdroot = "/proc/self/fd/$dirfd";
                                die "rollback pmxcfs context is not current\n"
                                    if !-d $fdroot || !context_current($fdroot, $dirfd, $node);

                                my $prev_user_raw = read_regular_raw("$workdir/passwords.previous-user.cfg", 1);
                                my $prev_shadow_raw = read_regular_raw("$workdir/passwords.previous-shadow.cfg", 1);
                                my $pu = do {
                                    open(my $fh, '<', "$workdir/passwords.previous-user.desc") or die "missing PREVIOUS user descriptor\n";
                                    chomp(my $v = <$fh> // q{}); close($fh); $v;
                                };
                                my $ps = do {
                                    open(my $fh, '<', "$workdir/passwords.previous-shadow.desc") or die "missing PREVIOUS shadow descriptor\n";
                                    chomp(my $v = <$fh> // q{}); close($fh); $v;
                                };
                                my $qu = raw_descriptor(q{});
                                my ($ok, $why) = rollback_pair(
                                    $fdroot, $dirfd, $node,
                                    $pu, $ps, $qu, $target_user_desc, $target_shadow_desc,
                                    $prev_user_raw, $prev_shadow_raw
                                );
                                die "$why\n" if !$ok;
                                1;
                            };

                            if ($rollback_ok) {
                                $final_rc = $RC_ROLLED_BACK;
                                $final_outcome = 'ROLLED_BACK';
                                $final_state = 'ROLLED_BACK';
                                $final_reason = "$reason; PREVIOUS restored exactly";
                            } else {
                                my $rollback_error = safe_reason($@ || 'rollback failed');
                                my $foreign = ($rollback_error =~ /FOREIGN|AMBIGUOUS|context|scope|cleanup/i) ? 1 : 0;
                                $final_rc = $foreign ? $RC_AMBIGUOUS : $RC_ROLLBACK_FAILED;
                                $final_outcome = $foreign ? 'AMBIGUOUS' : 'ROLLBACK_FAILED';
                                $final_state = $final_outcome;
                                $final_reason = "$reason; rollback: $rollback_error";
                            }
                        }

                        return 1;
                    }, 'PASSWORDS shadow lock failed');
                    return 1;
                });
                if (my $err = $@) {
                    die "PASSWORDS token lock failed: $err";
                }
                return 1;
            }, 'PASSWORDS user lock failed');
            return 1;
        }, 'PASSWORDS TFA lock failed');
        return 1;
    }, 'PASSWORDS domain lock failed');

    if (!$inner_completed && $final_rc == $RC_HELPER_ERROR) {
        $final_rc = $RC_ABORTED;
        $final_outcome = 'ABORTED_BEFORE_MUTATION';
        $final_state = 'LOCK_ACQUISITION_FAILED';
        $final_reason = 'native authentication lock set could not be established';
    }
}

my $top_ok = eval {
    die "invalid helper action\n" if $action ne 'prevalidate' && $action ne 'run';
    die "invalid workdir\n" if !defined($workdir) || !-d $workdir || -l $workdir;

    my $target_user_raw = read_regular_raw($target_user, 0);
    my $target_shadow_raw = read_regular_raw($target_shadow, 0);
    my $target_user_desc = raw_descriptor($target_user_raw);
    my $target_shadow_desc = raw_descriptor($target_shadow_raw);
    my ($target_valid, $target_summary) =
        strict_pair_validate('target', $target_user_raw, $target_shadow_raw);

    if (!$target_valid) {
        $final_rc = $RC_INVALID_TARGET;
        $final_outcome = 'INVALID_TARGET';
        $final_state = 'PREVALIDATION_FAILED';
        $final_reason = safe_reason($target_summary);
    } elsif ($action eq 'prevalidate') {
        $final_rc = $RC_OK;
        $final_outcome = 'PREVALIDATED';
        $final_state = 'PREVALIDATED';
        $final_reason = safe_reason($target_summary);
    } else {
        run_transaction_under_all_locks(
            $target_user_raw,
            $target_shadow_raw,
            $target_user_desc,
            $target_shadow_desc,
        );
    }

    1;
};

if (!$top_ok) {
    $final_rc = $mutation_started ? $RC_AMBIGUOUS : $RC_HELPER_ERROR;
    $final_outcome = $mutation_started ? 'AMBIGUOUS' : 'HELPER_ERROR';
    $final_state = $final_outcome;
    $final_reason = safe_reason($@ || 'top-level helper failure');
}

my $result_ok = eval {
    write_result($final_outcome, $final_state, safe_reason($final_reason), $mutation_started);
    1;
};
if (!$result_ok) {
    print STDERR "PASSWORDS helper could not write its result file\n";
    exit($mutation_started ? $RC_AMBIGUOUS : $RC_HELPER_ERROR);
}

print STDERR "PASSWORDS $final_outcome: " . safe_reason($final_reason) . "\n"
    if $final_rc != $RC_OK;
exit($final_rc);
PASSWORDS_PERL_HELPER
    then
        rc=0
    else
        rc=$?
    fi

    return "${rc}"
}


passwords_backup_archive_scope_admission() {
    # Read-only admission of the selected/pinned backup. R1 deliberately does
    # not merge API-token, TFA or custom-realm state into a two-file restore.
    local archive="$1"
    local tmp=""
    local member=""
    local rc=0
    local result=""
    local messages=""

    for member in \
        etc/pve/priv/token.cfg \
        etc/pve/priv/tfa.cfg \
        etc/pve/domains.cfg
    do
        if archive_has_member "${archive}" "${member}"; then
            echo "PASSWORDS R1 refuses this backup because it contains out-of-scope authentication state: ${member}" >&2
            return 1
        fi
    done

    tmp="$(mktemp -d /run/pve-config-restore.passwords-preflight.XXXXXX)" || return 1
    chmod 700 "${tmp}" || { rm -rf -- "${tmp}"; return 1; }

    if ! tar -xzOf "${archive}" -- etc/pve/user.cfg > "${tmp}/target-user.cfg" \
        || ! tar -xzOf "${archive}" -- etc/pve/priv/shadow.cfg > "${tmp}/target-shadow.cfg"; then
        echo "Could not extract the PASSWORDS target pair for strict prevalidation." >&2
        rm -rf -- "${tmp}"
        return 1
    fi
    chmod 600 "${tmp}/target-user.cfg" "${tmp}/target-shadow.cfg" || {
        rm -rf -- "${tmp}"
        return 1
    }

    result="${tmp}/prevalidate.result"
    messages="${tmp}/prevalidate.err"

    if passwords_tx_operation prevalidate \
        "${tmp}/target-user.cfg" "${tmp}/target-shadow.cfg" \
        "${result}" "${messages}" "${tmp}"; then
        rc=0
    else
        rc=$?
    fi

    if (( rc != 0 )); then
        [[ -s "${messages}" ]] && sed 's/^/  /' "${messages}" >&2 || true
        [[ -s "${result}" ]] && sed 's/^/  /' "${result}" >&2 || true
        echo "PASSWORDS R1 strict target/scope admission failed (rc=${rc})." >&2
        rm -rf -- "${tmp}"
        return 1
    fi

    rm -rf -- "${tmp}"
    return 0
}


passwords_backup_pre_snapshot_preflight() {
    [[ -n "${RESTORE_BACKUP:-}" ]] || return 1
    passwords_backup_archive_scope_admission "${RESTORE_BACKUP}/etc-pve.tar.gz"
}


restore_pve_users() {
    local archive=""
    local user_member="etc/pve/user.cfg"
    local shadow_member="etc/pve/priv/shadow.cfg"
    local target_user=""
    local target_shadow=""
    local tx_result=""
    local tx_messages=""
    local tx_rc=0
    local outcome=""
    local state=""
    local mutation_started=""
    local reason=""

    verify_backup
    require_pmxcfs || return 0

    if ! require_commands_for_operation pveum perl; then
        pause
        return 0
    fi

    if ! backup_members_present "${BACKUP}/etc-pve.tar.gz" "${user_member}" "${shadow_member}"; then
        echo "User/ACL/PVE-password restore is not possible from this backup. Nothing was changed." >&2
        pause
        return 0
    fi

    if ! passwords_backup_archive_scope_admission "${BACKUP}/etc-pve.tar.gz"; then
        echo "User/ACL/PVE-password restore refused by the PASSWORDS R1 scope gate. Nothing was changed." >&2
        pause
        return 0
    fi

    echo
    echo "This restores Proxmox user metadata, groups, roles, pools and ACLs from user.cfg"
    echo "together with PVE-realm password hashes from priv/shadow.cfg."
    echo "PASSWORDS R1 restores these two files as one ownership-aware transaction."
    echo "It does NOT restore Linux /etc/passwd or /etc/shadow, API-token secrets,"
    echo "modern TFA state, custom authentication realms or authentication ticket keys."
    echo "Backups/live states containing API-token metadata/secrets, legacy user keys,"
    echo "modern TFA state or custom realm state are refused instead of being merged."
    echo "WARNING: This can change Proxmox users, permissions and PVE passwords."

    confirm_word "Restore Proxmox users/ACLs/PVE passwords?" "RESTORE" \
        || { cancelled; return 0; }

    begin_restore_session passwords_backup_pre_snapshot_preflight \
        || { pause; return 0; }

    if ! pmxcfs_is_healthy; then
        echo "pmxcfs became unavailable during PASSWORDS restore preparation. Restore aborted." >&2
        end_restore_session
        pause
        return 0
    fi

    archive="${RESTORE_BACKUP}/etc-pve.tar.gz"
    new_workdir
    extract_member "${archive}" "${user_member}"
    extract_member "${archive}" "${shadow_member}"

    target_user="${WORKDIR}/${user_member}"
    target_shadow="${WORKDIR}/${shadow_member}"
    tx_result="${WORKDIR}/passwords.tx.result"
    tx_messages="${WORKDIR}/passwords.tx.err"

    # Third immutable TARGET check: selected backup, protected pinned backup and
    # the exact extracted staging files must all satisfy the same strict parser.
    if passwords_tx_operation prevalidate \
        "${target_user}" "${target_shadow}" \
        "${tx_result}" "${tx_messages}" "${WORKDIR}"; then
        :
    else
        tx_rc=$?
        [[ -s "${tx_messages}" ]] && sed 's/^/  /' "${tx_messages}" >&2 || true
        [[ -s "${tx_result}" ]] && sed 's/^/  /' "${tx_result}" >&2 || true
        echo "PASSWORDS staged TARGET failed final prevalidation (rc=${tx_rc}). Nothing was changed." >&2
        end_restore_session
        pause
        return 0
    fi

    if passwords_tx_operation run \
        "${target_user}" "${target_shadow}" \
        "${tx_result}" "${tx_messages}" "${WORKDIR}"; then
        tx_rc=0
    else
        tx_rc=$?
    fi

    if [[ -f "${tx_result}" && ! -L "${tx_result}" ]]; then
        outcome="$(awk -F= '$1 == "OUTCOME" { print $2; exit }' "${tx_result}")"
        state="$(awk -F= '$1 == "STATE" { print $2; exit }' "${tx_result}")"
        mutation_started="$(awk -F= '$1 == "MUTATION_STARTED" { print $2; exit }' "${tx_result}")"
        reason="$(awk -F= '$1 == "REASON" { sub(/^REASON=/, ""); print; exit }' "${tx_result}")"
    fi

    if [[ -s "${tx_messages}" ]]; then
        sed 's/^/  /' "${tx_messages}" >&2 || true
    fi

    case "${tx_rc}:${outcome}" in
        0:COMMITTED|0:SAME_STATE)
            echo
            if [[ "${outcome}" == "SAME_STATE" ]]; then
                echo "PASSWORDS: live user.cfg + shadow.cfg already matched TARGET; no auth-file rewrite was needed."
            else
                echo "PASSWORDS: TARGET user.cfg + shadow.cfg committed exactly and revalidated."
            fi
            ;;

        10:ROLLED_BACK)
            echo "PASSWORDS restore aborted: ${reason:-transaction validation/apply failed}." >&2
            echo "Rollback completed; PREVIOUS user.cfg + shadow.cfg were restored exactly and revalidated."
            end_restore_session
            pause
            return 0
            ;;

        11:ABORTED_BEFORE_MUTATION|64:INVALID_TARGET)
            echo "PASSWORDS restore aborted before an effective live mutation: ${reason:-admission failed}." >&2
            end_restore_session
            pause
            return 0
            ;;

        *)
            if [[ "${mutation_started}" == "0" \
               && ( "${outcome}" == "HELPER_ERROR" || "${outcome}" == "ABORTED_BEFORE_MUTATION" || "${outcome}" == "INVALID_TARGET" ) ]]; then
                echo "PASSWORDS restore helper failed before live mutation (rc=${tx_rc}, state=${state:-unknown}): ${reason:-unspecified}." >&2
                end_restore_session
                pause
                return 0
            fi

            end_restore_session_critical \
                "PASSWORDS transaction ended in ${state:-unknown}/${outcome:-unknown} (rc=${tx_rc}): ${reason:-unspecified}. No FOREIGN/AMBIGUOUS auth state was blindly overwritten."
            pause
            return 0
            ;;
    esac

    echo
    pveum user list \
        || echo "WARNING: 'pveum user list' returned an error after PASSWORDS commit; inspect access-control state." >&2
    echo
    pveum acl list \
        || echo "WARNING: 'pveum acl list' returned an error after PASSWORDS commit; inspect access-control state." >&2
    echo
    echo "Proxmox users/ACLs/PVE passwords restored successfully."

    end_restore_session
    pause
}

current_vmid_conflicts() {
    local vmid="$1"
    local intended="$2"
    local candidate=""

    for candidate in \
        /etc/pve/nodes/*/qemu-server/"${vmid}.conf" \
        /etc/pve/nodes/*/lxc/"${vmid}.conf"
    do
        [[ -e "${candidate}" ]] || continue
        [[ "${candidate}" == "${intended}" ]] && continue
        printf '%s\n' "${candidate}"
    done
}


restore_vm_config() {
    local archive=""
    local choice=""
    local i=0
    local member=""
    local vmid=""
    local dest=""
    local target=""
    local old=""
    local previous_descriptor=""
    local target_descriptor=""
    local target_prevalidation_messages=""
    local previous_prevalidation_messages=""
    local target_validation_messages=""
    local rollback_validation_messages=""
    local target_kind=""
    local target_sha=""
    local target_prevalidate_rc=0
    local capture_rc=0
    local previous_prevalidate_rc=0
    local process_rc=0
    local tx_rc=0
    local tx_outcome=""
    local tx_reason=""
    local status=""
    local conflicts=""
    local live_lock=""
    local backup_lock=""
    local -a configs=()

    verify_backup
    require_pmxcfs || return 0

    if ! require_commands_for_operation qm pgrep perl readlink; then
        pause
        return 0
    fi

    if ! vm_tx_standalone_scope_ok; then
        echo "VM restore is currently supported only on standalone Proxmox hosts." >&2
        echo "Cluster configuration was detected; VM restore is refused before any restore session or mutation." >&2
        pause
        return 0
    fi

    archive="${BACKUP}/etc-pve.tar.gz"

    local config_list=""
    config_list="$(mktemp /run/pve-config-restore.vm-list.XXXXXX)" \
        || die "Could not create temporary VM configuration list."

    if ! tar -tzf "${archive}" \
        | awk -v node="${NODE}" '$0 ~ ("^etc/pve/nodes/" node "/qemu-server/[0-9]+\\.conf$") { print }' \
        | sort -V \
        > "${config_list}"; then
        rm -f -- "${config_list}"
        die "Could not list VM configurations from ${archive}."
    fi

    if ! mapfile -t configs < "${config_list}"; then
        rm -f -- "${config_list}"
        die "Could not read the temporary VM configuration list."
    fi

    rm -f -- "${config_list}" \
        || die "Could not remove the temporary VM configuration list."

    if ((${#configs[@]} == 0)); then
        echo "No VM configurations are present in this backup."
        pause
        return 0
    fi

    echo
    echo "VM configurations in selected backup:"
    for i in "${!configs[@]}"; do
        vmid="$(basename "${configs[$i]}" .conf)"
        printf '  %2d) VM %s\n' "$((i + 1))" "${vmid}"
    done

    echo
    read -r -p "Select VM configuration: " choice
    if [[ ! "${choice}" =~ ^[1-9][0-9]{0,4}$ ]] \
        || (( choice > ${#configs[@]} )); then
        echo "Invalid selection."
        pause
        return 0
    fi

    member="${configs[$((choice - 1))]}"
    vmid="$(basename "${member}" .conf)"
    dest="/etc/pve/nodes/${NODE}/qemu-server/${vmid}.conf"

    conflicts="$(current_vmid_conflicts "${vmid}" "${dest}")"
    if [[ -n "${conflicts}" ]]; then
        echo "VMID ${vmid} is currently used by another guest configuration:" >&2
        printf '%s\n' "${conflicts}" >&2
        echo "Restore refused to preserve Proxmox VMID uniqueness." >&2
        pause
        return 0
    fi

    if vm_qemu_process_guard "${vmid}"; then
        :
    else
        process_rc=$?
        if (( process_rc == 10 )); then
            echo "VM ${vmid} has a running QEMU process. Stop it before restoring its configuration."
        else
            echo "QEMU process detection for VM ${vmid} failed (rc=${process_rc}). Restore refused fail-closed." >&2
        fi
        pause
        return 0
    fi

    if [[ -f "${dest}" ]]; then
        status="$(qm status "${vmid}" 2>/dev/null | awk '{print $2}' || true)"
        if [[ "${status}" == "running" ]]; then
            echo "VM ${vmid} is running. Stop it before restoring its configuration."
            pause
            return 0
        fi

        live_lock="$(guest_config_lock < "${dest}")"
        if [[ -n "${live_lock}" ]]; then
            echo "VM ${vmid} is currently locked (lock: ${live_lock})." >&2
            echo "An operation such as a backup, migration or snapshot may be in progress." >&2
            echo "Restore refused. If no such operation is running, clear the lock with 'qm unlock ${vmid}' and retry." >&2
            pause
            return 0
        fi
    fi

    if ! backup_lock="$(tar -xzOf "${archive}" -- "${member}" | guest_config_lock)"; then
        echo "Could not read ${member} from ${archive}. Nothing was changed." >&2
        pause
        return 0
    fi

    if [[ -n "${backup_lock}" ]]; then
        echo
        echo "WARNING: The configuration in the backup contains 'lock: ${backup_lock}'."
        echo "After the restore, VM ${vmid} stays locked until 'qm unlock ${vmid}' is run."
    fi

    confirm_word "Restore VM ${vmid} configuration from ${BACKUP}?" "RESTORE" || { cancelled; return 0; }
    begin_restore_session || { pause; return 0; }

    if ! pmxcfs_is_healthy; then
        echo "pmxcfs became unavailable during restore preparation. Restore aborted." >&2
        end_restore_session
        pause
        return 0
    fi

    conflicts="$(current_vmid_conflicts "${vmid}" "${dest}")"
    if [[ -n "${conflicts}" ]]; then
        echo "VMID ${vmid} became occupied by another guest configuration during preparation:" >&2
        printf '%s\n' "${conflicts}" >&2
        end_restore_session
        pause
        return 0
    fi

    status="$(qm status "${vmid}" 2>/dev/null | awk '{print $2}' || true)"
    if [[ "${status}" == "running" ]]; then
        echo "VM ${vmid} started during preparation. Restore aborted."
        end_restore_session
        pause
        return 0
    fi
    if vm_qemu_process_guard "${vmid}"; then
        :
    else
        process_rc=$?
        if (( process_rc == 10 )); then
            echo "VM ${vmid} started during preparation. Restore aborted."
        else
            echo "QEMU process detection for VM ${vmid} failed during preparation (rc=${process_rc}). Restore refused fail-closed." >&2
        fi
        end_restore_session
        pause
        return 0
    fi

    # Stage and strict-parse immutable TARGET before entering the VM lock's
    # critical window. The pinned selected backup is already protected by the
    # restore session.
    archive="${RESTORE_BACKUP}/etc-pve.tar.gz"
    new_workdir
    extract_member "${archive}" "${member}"
    target="${WORKDIR}/${member}"
    old="${WORKDIR}/current-vm-${vmid}.conf"
    previous_descriptor="${WORKDIR}/vm.previous.descriptor"
    target_descriptor="${WORKDIR}/vm.target.descriptor"
    target_prevalidation_messages="${WORKDIR}/vm.target-prevalidation.err"
    previous_prevalidation_messages="${WORKDIR}/vm.previous-prevalidation.err"
    target_validation_messages="${WORKDIR}/vm.target-validation.err"
    rollback_validation_messages="${WORKDIR}/vm.rollback-validation.err"

    if tx_write_pmxcfs_file_descriptor "${target}" "${target_descriptor}"; then
        IFS=$'\t' read -r target_kind target_sha < "${target_descriptor}" || true
    fi
    if [[ "${target_kind}" != "FILE" || ! "${target_sha}" =~ ^[0-9a-f]{64}$ ]]; then
        echo "VM ${vmid} TARGET is not a supported regular file. Nothing was changed." >&2
        end_restore_session
        pause
        return 0
    fi

    if vm_tx_prevalidate_candidate \
        "${target}" "${vmid}" "${target_prevalidation_messages}"; then
        target_prevalidate_rc=0
    else
        target_prevalidate_rc=$?
    fi
    if (( target_prevalidate_rc != 0 )); then
        tx_print_validation_messages_noncritical \
            "VM TARGET strict-parser diagnostics" "${target_prevalidation_messages}"
        echo "VM ${vmid} TARGET failed staged strict semantic prevalidation (rc=${target_prevalidate_rc}). Nothing was changed." >&2
        end_restore_session
        pause
        return 0
    fi

    if ! tx_pmxcfs_file_matches_descriptor "${target}" "${target_descriptor}"; then
        echo "VM ${vmid} TARGET changed during staged prevalidation. Nothing was changed." >&2
        end_restore_session
        pause
        return 0
    fi

    # Serialize with Proxmox operations on this VM. The VM path resolves the lock path
    # from the installed PVE::QemuConfig implementation and then proves, while
    # holding that flock, that lock_config_full() cannot enter its callback.
    if ! acquire_vm_config_lock "${vmid}"; then
        echo "Could not establish and verify the native Proxmox configuration lock for VM ${vmid}. Restore aborted." >&2
        end_restore_session
        pause
        return 0
    fi

    # Last responsible admission checks while the native VM lock is held.
    conflicts="$(current_vmid_conflicts "${vmid}" "${dest}")"
    if [[ -n "${conflicts}" ]]; then
        echo "VMID ${vmid} became occupied while waiting for its Proxmox configuration lock:" >&2
        printf '%s\n' "${conflicts}" >&2
        end_restore_session
        pause
        return 0
    fi

    status="$(qm status "${vmid}" 2>/dev/null | awk '{print $2}' || true)"
    if [[ "${status}" == "running" ]]; then
        echo "VM ${vmid} started while the restore was waiting for its Proxmox configuration lock. Restore aborted." >&2
        end_restore_session
        pause
        return 0
    fi
    if vm_qemu_process_guard "${vmid}"; then
        :
    else
        process_rc=$?
        if (( process_rc == 10 )); then
            echo "VM ${vmid} started while the restore was waiting for its Proxmox configuration lock. Restore aborted." >&2
        else
            echo "QEMU process detection for VM ${vmid} failed while the native VM lock was held (rc=${process_rc}). Restore refused fail-closed." >&2
        fi
        end_restore_session
        pause
        return 0
    fi

    if [[ -f "${dest}" ]]; then
        live_lock="$(guest_config_lock < "${dest}")"
        if [[ -n "${live_lock}" ]]; then
            echo "VM ${vmid} was locked during preparation (lock: ${live_lock}). Restore aborted." >&2
            end_restore_session
            pause
            return 0
        fi
    fi

    # PREVIOUS is captured under the native VM lock. The transaction's first
    # domain identity gate immediately re-proves those bytes through a pinned
    # current pmxcfs mount before any mutation is possible.
    if tx_capture_stable_pmxcfs_previous \
        "${dest}" "${old}" "${previous_descriptor}"; then
        capture_rc=0
    else
        capture_rc=$?
    fi
    if (( capture_rc != 0 )); then
        echo "VM ${vmid} PREVIOUS could not be captured as one stable state (rc=${capture_rc}). Nothing was changed." >&2
        end_restore_session
        pause
        return 0
    fi

    tx_begin_single_pmxcfs_file \
        "vm" \
        "${dest}" \
        "${old}" \
        "${previous_descriptor}" \
        "${target_descriptor}" \
        "vm_tx_validate_live" \
        "${target_validation_messages}" \
        "${rollback_validation_messages}" \
        "${vmid}"

    if ! tx_domain_live_matches_descriptor "${previous_descriptor}"; then
        echo "VM ${vmid} pmxcfs context/LIVE no longer matches captured PREVIOUS. Nothing was changed." >&2
        end_restore_session
        tx_reset
        pause
        return 0
    fi

    if vm_tx_validate_live previous "${previous_prevalidation_messages}"; then
        previous_prevalidate_rc=0
    else
        previous_prevalidate_rc=$?
    fi
    if (( previous_prevalidate_rc != 0 )); then
        tx_print_validation_messages_noncritical \
            "VM PREVIOUS validation diagnostics" "${previous_prevalidation_messages}"
        echo "VM ${vmid} PREVIOUS failed domain prevalidation (rc=${previous_prevalidate_rc}). Nothing was changed." >&2
        end_restore_session
        tx_reset
        pause
        return 0
    fi

    # Validator success is not ownership. Re-prove exact PREVIOUS/context while
    # still holding the native VM lock immediately before arming mutation.
    if ! tx_domain_live_matches_descriptor "${previous_descriptor}"; then
        echo "VM ${vmid} LIVE changed during PREVIOUS validation. Nothing was changed." >&2
        end_restore_session
        tx_reset
        pause
        return 0
    fi

    if tx_apply_single_pmxcfs_file "${target}"; then
        tx_rc=0
    else
        tx_rc=$?
    fi

    tx_outcome="${TX_OUTCOME}"
    tx_reason="${TX_FAILURE_REASON}"

    case "${tx_rc}" in
        0)
            printf '\n%s\n' "VM ${vmid} configuration restored and committed successfully." || true
            # Post-commit display only. Transaction commit was already proven by
            # the validator and final pinned TARGET identity gate.
            qm config "${vmid}" 7>&- 8>&- \
                || printf '%s\n' "WARNING: 'qm config ${vmid}' returned an error after commit; inspect VM state." >&2 || true
            end_restore_session
            tx_reset
            pause
            return 0
            ;;
        10)
            tx_print_validation_messages_noncritical \
                "VM TARGET validation diagnostics" "${target_validation_messages}"
            tx_print_validation_messages_noncritical \
                "VM rollback validation diagnostics" "${rollback_validation_messages}"
            printf '%s\n' "VM ${vmid} restore aborted: ${tx_reason}." >&2 || true
            printf '%s\n' "Rollback completed; PREVIOUS was restored exactly and revalidated." || true
            end_restore_session
            tx_reset
            pause
            return 0
            ;;
        11)
            printf '%s\n' "VM ${vmid} restore aborted before an effective live mutation: ${tx_reason}." >&2 || true
            end_restore_session
            tx_reset
            pause
            return 0
            ;;
        20|21)
            if (( TX_TEMP_CLEANUP_UNCERTAIN == 1 )); then
                tx_print_validation_messages_noncritical \
                    "VM apply cleanup diagnostics" "${WORKDIR}/vm.lock-apply.err"
                tx_print_validation_messages_noncritical \
                    "VM rollback cleanup diagnostics" "${WORKDIR}/vm.lock-rollback.err"
            fi
            tx_print_validation_messages_noncritical \
                "VM TARGET validation diagnostics" "${target_validation_messages}"
            tx_print_validation_messages_noncritical \
                "VM rollback validation diagnostics" "${rollback_validation_messages}"
            end_restore_session_critical \
                "VM ${vmid} transaction ended in ${TX_STATE}: ${tx_reason}. Transaction safety did not blindly overwrite an unowned/ambiguous live state."
            tx_reset
            pause
            return 0
            ;;
        *)
            end_restore_session_critical \
                "VM ${vmid} transaction returned unexpected status ${tx_rc} (${tx_outcome}): ${tx_reason}"
            tx_reset
            pause
            return 0
            ;;
    esac
}


restore_config_db() {
    local running_qm=""
    local running_pct=""
    local emergency_dir=""
    local process_file=""
    local staged_db=""
    local rollback_db=""
    local rollback_ready=0
    local pve_cluster_unit_state=""

    verify_backup

    # Full config.db replacement is only supported on a standalone node.
    # Check both the pmxcfs cluster configuration and the local corosync copy;
    # either one is enough to refuse this emergency path.
    # Local file first: the /etc/pve check goes through pmxcfs (FUSE) and is
    # only reached when the local corosync configuration is absent.
    if [[ -e /etc/corosync/corosync.conf || -e /etc/pve/corosync.conf ]]; then
        echo "Cluster configuration was detected (/etc/pve/corosync.conf and/or /etc/corosync/corosync.conf)." >&2
        echo "The emergency config.db restore is designed for a standalone node and is refused." >&2
        pause
        return 0
    fi

    # Do not alter a pre-existing administrator/system mask. The emergency
    # path installs its own temporary runtime mask later and removes only that
    # mask before an intentional pmxcfs start.
    pve_cluster_unit_state="$(systemctl is-enabled pve-cluster 2>/dev/null || true)"
    if [[ "${pve_cluster_unit_state}" == masked* ]]; then
        echo "Emergency config.db restore is refused because pve-cluster is already masked (${pve_cluster_unit_state})." >&2
        echo "Resolve the existing unit mask manually before using this recovery path." >&2
        pause
        return 0
    fi

    if ! require_commands_for_operation qm pct pgrep install sync xargs chown ps; then
        echo "Emergency config.db restore is refused because guest/activity checks or atomic replacement tools are unavailable." >&2
        pause
        return 0
    fi

    process_file="$(mktemp /run/pve-config-restore.guests.XXXXXX)"

    if pgrep -fa '(/usr/bin/kvm|qemu-system-|lxc-start)' > "${process_file}" 2>/dev/null; then
        echo "Full pmxcfs recovery is refused because guest processes are still running:"
        cat "${process_file}"
        rm -f "${process_file}"
        pause
        return 0
    fi

    rm -f "${process_file}"

    running_qm="$(qm list 2>/dev/null | awk 'NR > 1 && $3 == "running" {print $1}' | xargs || true)"
    running_pct="$(pct list 2>/dev/null | awk 'NR > 1 && $2 == "running" {print $1}' | xargs || true)"

    if [[ -n "${running_qm}" || -n "${running_pct}" ]]; then
        echo "Full pmxcfs recovery is refused while guests are running."
        [[ -n "${running_qm}" ]] && echo "Running VMs: ${running_qm}"
        [[ -n "${running_pct}" ]] && echo "Running containers: ${running_pct}"
        pause
        return 0
    fi

    echo
    echo "============================================================"
    echo " EMERGENCY pmxcfs DATABASE RESTORE"
    echo "============================================================"
    echo
    echo "This replaces /var/lib/pve-cluster/config.db with the selected backup."
    echo "It rolls back the COMPLETE Proxmox pmxcfs configuration state."
    echo "The host will reboot automatically after replacement."
    echo "Use IPMI/console access for this operation."
    echo
    echo "Selected backup: ${BACKUP}"

    confirm_word "Proceed with full config.db recovery?" "RESTORE-CONFIG-DB" || { cancelled; return 0; }
    begin_restore_session || { pause; return 0; }

    # Re-check guests after the pre-restore snapshot. Nothing may be running
    # when pmxcfs is replaced.
    process_file="$(mktemp /run/pve-config-restore.guests.XXXXXX)"
    if pgrep -fa '(/usr/bin/kvm|qemu-system-|lxc-start)' > "${process_file}" 2>/dev/null; then
        echo "A guest process started during preparation. Emergency restore aborted:"
        cat "${process_file}"
        rm -f "${process_file}"
        end_restore_session
        pause
        return 0
    fi
    rm -f "${process_file}"

    running_qm="$(qm list 2>/dev/null | awk 'NR > 1 && $3 == "running" {print $1}' | xargs || true)"
    running_pct="$(pct list 2>/dev/null | awk 'NR > 1 && $2 == "running" {print $1}' | xargs || true)"

    if [[ -n "${running_qm}" || -n "${running_pct}" ]]; then
        echo "A guest started during preparation. Emergency restore aborted."
        [[ -n "${running_qm}" ]] && echo "Running VMs: ${running_qm}"
        [[ -n "${running_pct}" ]] && echo "Running containers: ${running_pct}"
        end_restore_session
        pause
        return 0
    fi

    mkdir -p /var/lib/vz/host-config-emergency-rollback
    chmod 700 /var/lib/vz/host-config-emergency-rollback
    emergency_dir="$(mktemp -d "/var/lib/vz/host-config-emergency-rollback/config-db-$(date '+%Y-%m-%d_%H-%M-%S').XXXXXX")"
    chmod 700 "${emergency_dir}"

    if [[ -e /etc/hostname || -L /etc/hostname ]]; then
        cp -a /etc/hostname "${emergency_dir}/hostname.before-restore"
    fi
    if [[ -e /etc/hosts || -L /etc/hosts ]]; then
        cp -a /etc/hosts "${emergency_dir}/hosts.before-restore"
    fi

    echo
    echo "Stopping and temporarily runtime-masking pve-cluster..."
    if ! mask_pve_cluster_runtime_for_db_change; then
        echo "Could not establish a stopped, runtime-masked pve-cluster state. Nothing was replaced." >&2
        echo "pve-cluster state: $(unit_active_state pve-cluster); /etc/pve mounted: $(mountpoint -q /etc/pve && echo yes || echo no); pmxcfs process: $(pmxcfs_process_running && echo yes || echo no)" >&2
        if start_pmxcfs_and_validate; then
            end_restore_session
        else
            echo "Original pmxcfs could not be returned to a healthy state. Backup timer stays stopped." >&2
            end_restore_session_keep_timer_stopped
        fi
        pause
        return 0
    fi

    # pve-cluster is now cleanly stopped and runtime-masked, so the local
    # rollback copy is taken from a quiescent database instead of copying a
    # live SQLite file.
    #
    # From here on pve-cluster is stopped. Every step up to the replacement is
    # checked explicitly, so a failure (e.g. disk full) restarts the original
    # pmxcfs instead of exiting with /etc/pve unavailable.
    if [[ -e /var/lib/pve-cluster/config.db ]]; then
        if ! cp -a /var/lib/pve-cluster/config.db "${emergency_dir}/config.db.before-restore"; then
            abort_config_db_restore_unchanged "Could not create the local rollback copy of config.db."
            return 0
        fi
        rollback_db="${emergency_dir}/config.db.before-restore"
    fi

    # A clean pmxcfs shutdown normally checkpoints and removes SQLite WAL/SHM.
    # If any sidecar is still present now, do not guess whether it is stale or
    # still contains state not represented in config.db. Preserve it for
    # diagnostics, leave the live database untouched and restart the original
    # pmxcfs with its original sidecars still in place.
    local sidecar=""
    local had_sidecars=0
    for sidecar in journal wal shm; do
        if [[ -e "/var/lib/pve-cluster/config.db-${sidecar}" ]]; then
            had_sidecars=1
            if ! cp -a "/var/lib/pve-cluster/config.db-${sidecar}" \
                "${emergency_dir}/config.db-${sidecar}.before-restore"; then
                abort_config_db_restore_unchanged "Could not preserve config.db-${sidecar}."
                return 0
            fi
        fi
    done

    if (( had_sidecars == 1 )); then
        echo "Emergency files are in: ${emergency_dir}" >&2
        abort_config_db_restore_unchanged \
            "SQLite sidecar files still exist after pve-cluster was stopped cleanly; config.db was not replaced."
        return 0
    fi

    echo "Preparing replacement config.db..."
    staged_db="/var/lib/pve-cluster/.config.db.restore.${BASHPID}"
    rm -f -- "${staged_db}"

    if ! install -o root -g root -m 0600 \
        "${RESTORE_BACKUP}/config.db" \
        "${staged_db}"; then
        rm -f -- "${staged_db}"
        abort_config_db_restore_unchanged "Could not stage the replacement config.db."
        return 0
    fi

    if [[ "$(sqlite_integrity_check "${staged_db}")" != "ok" ]]; then
        echo "Staged replacement database failed integrity check. Nothing was replaced." >&2
        rm -f -- "${staged_db}"
        if start_pmxcfs_and_validate; then
            end_restore_session
        else
            echo "Original pmxcfs could not be restarted. Backup timer stays stopped." >&2
            end_restore_session_keep_timer_stopped
        fi
        pause
        return 0
    fi

    # Defense in depth: the runtime mask prevents systemd activation, and this
    # check also catches an already-running or directly started pmxcfs
    # (including one outside systemd) before the live database is touched.
    if ! pve_cluster_fully_stopped; then
        rm -f -- "${staged_db}"
        echo "Emergency files are in: ${emergency_dir}" >&2
        end_restore_session_critical "pve-cluster or a pmxcfs process became active again before the replacement; nothing was replaced."
        pause
        return 0
    fi

    # With pve-cluster stopped, stale SQLite sidecars must not accompany the
    # replacement database.
    if ! rm -f -- \
        /var/lib/pve-cluster/config.db-journal \
        /var/lib/pve-cluster/config.db-wal \
        /var/lib/pve-cluster/config.db-shm; then
        rm -f -- "${staged_db}"
        abort_config_db_restore_unchanged "Could not remove stale SQLite sidecar files."
        return 0
    fi

    if ! mv -f -- "${staged_db}" /var/lib/pve-cluster/config.db; then
        rm -f -- "${staged_db}"
        abort_config_db_restore_unchanged "Could not move the staged database into place."
        return 0
    fi

    # install already set owner and mode; repeat them defensively. A failed
    # sync is different: durability of the replaced database could not be
    # confirmed, so do not start pmxcfs or reboot automatically.
    chmod 0600 /var/lib/pve-cluster/config.db \
        || echo "WARNING: chmod 0600 on config.db failed." >&2
    chown root:root /var/lib/pve-cluster/config.db \
        || echo "WARNING: chown root:root on config.db failed." >&2

    if ! sync -f /var/lib/pve-cluster/config.db; then
        echo "Emergency files are in: ${emergency_dir}" >&2
        echo "/etc/pve remains unavailable until pve-cluster is started after manual recovery." >&2
        warn_no_automatic_restart
        end_restore_session_critical "Could not sync the replaced config.db to storage; automatic activation/reboot was stopped."
        pause
        return 0
    fi

    echo "Starting pve-cluster to validate the restored database..."

    if ! start_pmxcfs_and_validate; then

        echo "Restored config.db could not be activated. Rolling back..." >&2
        rollback_ready=0

        if ! mask_pve_cluster_runtime_for_db_change; then
            echo "Emergency files are in: ${emergency_dir}" >&2
            warn_no_automatic_restart
            end_restore_session_critical "Could not stop and runtime-mask pve-cluster before rollback; rollback was not attempted."
            pause
            return 0
        fi

        if ! rm -f -- \
            /var/lib/pve-cluster/config.db-journal \
            /var/lib/pve-cluster/config.db-wal \
            /var/lib/pve-cluster/config.db-shm; then
            echo "Emergency files are in: ${emergency_dir}" >&2
            warn_no_automatic_restart
            end_restore_session_critical "Could not remove stale SQLite sidecars before rollback."
            pause
            return 0
        fi

        if [[ -n "${rollback_db}" && -f "${rollback_db}" ]]; then
            staged_db="/var/lib/pve-cluster/.config.db.rollback.${BASHPID}"
            rm -f -- "${staged_db}"

            if install -o root -g root -m 0600 "${rollback_db}" "${staged_db}" \
                && mv -f -- "${staged_db}" /var/lib/pve-cluster/config.db; then
                chmod 0600 /var/lib/pve-cluster/config.db \
                    || echo "WARNING: chmod 0600 on config.db failed." >&2
                chown root:root /var/lib/pve-cluster/config.db \
                    || echo "WARNING: chown root:root on config.db failed." >&2

                if sync -f /var/lib/pve-cluster/config.db; then
                    rollback_ready=1
                else
                    echo "CRITICAL: Rollback config.db was put in place, but sync failed." >&2
                    echo "pve-cluster will remain stopped because database durability could not be confirmed." >&2
                fi
            else
                rm -f -- "${staged_db}"
                echo "CRITICAL: Could not put the rollback copy back in place: ${rollback_db}" >&2
            fi
        elif [[ -n "${rollback_db}" ]]; then
            # A previous config.db existed, but its rollback copy is gone. This
            # must not be treated as "no previous config.db".
            echo "Emergency files are in: ${emergency_dir}" >&2
            warn_no_automatic_restart
            end_restore_session_critical "The rollback copy ${rollback_db} is missing although a previous config.db existed; the replaced database was left in place and pve-cluster stays stopped."
            pause
            return 0
        else
            # No config.db existed before this restore. Starting pmxcfs now could
            # create a new, empty database and falsely look like a successful
            # rollback. Restore the previous absence and stay stopped.
            if rm -f -- /var/lib/pve-cluster/config.db \
                && sync -f /var/lib/pve-cluster; then
                echo "Emergency files are in: ${emergency_dir}" >&2
                end_restore_session_critical "No previous config.db existed; the failed replacement was removed and pve-cluster stays stopped. Do not reboot or start pve-cluster until manual recovery is complete."
            else
                echo "Emergency files are in: ${emergency_dir}" >&2
                end_restore_session_critical "No previous config.db existed, and the failed replacement could not be removed durably. pve-cluster stays stopped. Do not reboot or start pve-cluster until manual recovery is complete."
            fi
            pause
            return 0
        fi

        if (( rollback_ready == 0 )); then
            echo "Emergency files are in: ${emergency_dir}" >&2
            warn_no_automatic_restart
            end_restore_session_critical "Rollback could not be completed durably; pve-cluster remains stopped."
            pause
            return 0
        fi

        if start_pmxcfs_and_validate; then
            echo "Rollback completed successfully. Emergency copy: ${emergency_dir}"
            end_restore_session
        else
            echo "CRITICAL: Rollback database was restored, but pmxcfs is not healthy." >&2
            echo "Emergency files are in: ${emergency_dir}" >&2
            end_restore_session_critical "Rollback could not restore a healthy pmxcfs."
        fi

        pause
        return 0
    fi

    echo
    echo "config.db replaced successfully and pve-cluster mounted /etc/pve again."
    echo "Emergency rollback copy: ${emergency_dir}"
    echo "The node will reboot now, as recommended for full pmxcfs recovery."

    # Preserve the originally selected backup if retention removed it, but do
    # not restart the backup timer immediately before the emergency reboot.
    RESTORE_SESSION_ACTIVE=0
    unpin_selected_backup
    release_backup_lock
    cleanup_workdir

    EMERGENCY_REBOOT_PENDING=1
    log_event notice "config.db replaced from ${BACKUP}; emergency rollback copy in ${emergency_dir}; rebooting"
    sleep 3

    if ! systemctl reboot; then
        EMERGENCY_REBOOT_PENDING=0
        critical_section_end
        resume_backup_timer
        echo "Automatic reboot failed. The script attempted to restore the backup timer to its pre-restore state; verify the timer state and reboot manually to complete the recovery." >&2
        pause
        return 0
    fi

    exit 0
}


warn_no_automatic_restart() {
    echo "Do not reboot and do not start pve-cluster until the configuration database has been checked manually." >&2
    echo "A reboot or manual/service-triggered start could activate pve-cluster with the database that is currently in place." >&2
    if (( PVE_CLUSTER_RUNTIME_MASKED_BY_TOOL == 1 )); then
        echo "This recovery session has runtime-masked pve-cluster as an additional safeguard; the runtime mask disappears on reboot." >&2
    fi
}


abort_config_db_restore_unchanged() {
    local reason="$1"

    log_event warning "emergency config.db restore aborted, database unchanged: ${reason}"
    echo >&2
    echo "${reason}" >&2
    echo "The live config.db was NOT replaced. Starting the original pmxcfs again..." >&2

    if start_pmxcfs_and_validate; then
        end_restore_session
    else
        echo "Original pmxcfs could not be restarted. Backup timer stays stopped." >&2
        end_restore_session_keep_timer_stopped
    fi

    pause
}


show_backup_info() {
    echo
    echo "Selected backup: ${BACKUP}"
    echo
    if [[ -f "${BACKUP}/backup-info.txt" ]]; then
        cat "${BACKUP}/backup-info.txt"
    fi
    echo
    cat "${BACKUP}/VERIFIED"
    pause
}


main_menu() {
    local choice=""
    local previous_backup=""

    while true; do
        clear 2>/dev/null || true
        echo "============================================================"
        echo " Proxmox VE Configuration Recovery Tool v${SCRIPT_VERSION}"
        echo "============================================================"
        echo
        echo "Node:            ${NODE}"
        echo "Selected backup: $(basename "${BACKUP}")"
        if [[ "${RESTORE_RECOVERY_REQUIRED:-0}" != 0 ]]; then
            echo "CRITICAL: Restores 2-8 are blocked; manual recovery is required."
        fi
        echo
        echo "  1) Verify selected backup"
        echo "  2) Restore SSH configuration"
        echo "  3) Restore network configuration"
        echo "  4) Restore Proxmox firewall configuration"
        echo "  5) Restore storage.cfg"
        echo "  6) Restore Proxmox users / ACLs / PVE passwords"
        echo "  7) Restore one VM configuration"
        echo "  8) Emergency: restore complete pmxcfs config.db"
        echo "  9) Show selected backup information"
        echo " 10) Select another backup"
        echo "  0) Exit"
        echo
        read -r -p "Select: " choice

        # Keep mutators outside an if/&&/|| condition: those contexts suppress
        # Bash errexit within the called restore function.
        if [[ "${choice}" =~ ^[2-8]$ ]] && ! restore_session_admission_allowed; then
            pause
            continue
        fi

        case "${choice}" in
            1)
                # die ends only the subshell (the EXIT trap does not run there),
                # so a failed verification returns to the menu.
                ( verify_backup ) \
                    || echo "Backup verification FAILED. Select another backup with menu 10." >&2
                pause
                ;;
            2) restore_ssh ;;
            3) restore_network ;;
            4) restore_firewall ;;
            5) restore_storage ;;
            6) restore_pve_users ;;
            7) restore_vm_config ;;
            8) restore_config_db ;;
            9) show_backup_info ;;
            10)
                previous_backup="${BACKUP}"
                select_backup
                if ! ( verify_backup ); then
                    BACKUP="${previous_backup}"
                    echo "Backup verification FAILED. Keeping the previous selection: ${BACKUP}" >&2
                    pause
                fi
                ;;
            0) echo "Exiting."; exit 0 ;;
            *) echo "Invalid selection."; pause ;;
        esac
    done
}


main() {
    local cmd=""
    local stale_copies=""
    local -a required=(
        awk basename cat chmod cp date dirname find flock grep hostname install
        mkdir mktemp mountpoint mv rm sed sha256sum sleep sort sqlite3 stat systemctl tar tr
    )

    [[ "${EUID}" -eq 0 ]] || die "This tool must be executed as root."

    for cmd in "${required[@]}"; do
        command -v "${cmd}" >/dev/null 2>&1 || die "Required command not found: ${cmd}"
    done

    [[ -d "${BASE}" ]] || die "Backup directory does not exist: ${BASE}"
    [[ ! -L "${BASE}" ]] || die "Backup directory must not be a symbolic link: ${BASE}"

    exec 8>"${RESTORE_LOCKFILE}"
    flock -n 8 || die "Another pve-config-restore instance is already running."

    NODE="$(hostname -s)"
    [[ -n "${NODE}" ]] || die "Could not determine node name."

    log_event info "started (version ${SCRIPT_VERSION}, node ${NODE})"

    # The restore lock is held, so a protected copy left in BASE comes from an
    # interrupted earlier session. It is reported, never removed.
    stale_copies="$(find "${BASE}" -mindepth 1 -maxdepth 1 -type d -name '.restore-selected.*' -printf '%f ' 2>/dev/null || true)"
    if [[ -n "${stale_copies}" ]]; then
        echo "NOTE: Protected backup copies from an interrupted session exist in ${BASE}:" >&2
        echo "  ${stale_copies}" >&2
        echo "They are not used by this session. If the original backup directory no longer" >&2
        echo "exists, such a copy is its only remaining copy. Inspect and remove them manually." >&2
    fi

    choose_backup
    main_menu
}


main "$@"
